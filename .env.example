# .env.example – скопируйте в .env и заполните своими данными

# API ключи (как минимум один)
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
# Для локальных моделей можно указать URL
LOCAL_LLM_URL=http://localhost:8000/v1

# Настройки агентов (порты по умолчанию)
EIDO_PORT=8000
NYX_PORT=8001
SAM_PORT=8002
MEYA_PORT=8003
ALESSA_PORT=8004

# Режим отладки
DEBUG=True

# Путь к папке с артефактами (по умолчанию ./artifacts)
ARTIFACTS_DIR=./artifacts
