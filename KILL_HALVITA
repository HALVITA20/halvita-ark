        if os.path.exists(CONFIG["log_file"]):
            os.remove(CONFIG["log_file"])
        # В реальности — очистка оперативной памяти, уничтожение токенов и т.д.
        logger.info("All traces deleted.")

# ====================== ЯДРО СИСТЕМЫ ======================
class Prorok:
    """Главный оркестратор системы"""
    
    def __init__(self, targets: List[str] = None):
        self.targets = targets or []
        self.scanner = Scanner()
        self.analyzer = Analyzer()
        self.infiltrator = Infiltrator()
        self.self_destruct = SelfDestruct()
        self.results = []
    
    def load_targets(self, file_path: str) -> List[str]:
        """Загружает список целей из JSON-файла"""
        try:
            with open(file_path, 'r', encoding='utf-8') as f:
                data = json.load(f)
            logger.info(f"Loaded {len(data)} targets from {file_path}")
            return data
        except Exception as e:
            logger.error(f"Failed to load targets: {e}")
            return []
    
    def process_target(self, name: str) -> Dict:
        """Обрабатывает одного человека: сканирует, анализирует, предлагает действие"""
        logger.info(f"Processing target: {name}")
        
        dossier = self.scanner.get_person_dossier(name)
        threat = self.analyzer.threat_level(dossier)
        
        if threat >= 0.8:
            message = self.infiltrator.generate_personalized_message(dossier)
            action = "INFLITRATE"
        elif threat >= 0.5:
            message = f"Monitoring {name} - moderate risk."
            action = "MONITOR"
        else:
            message = f"{name} - low risk. No action needed."
            action = "IGNORE"
        
        result = {
            "name": name,
            "threat_level": threat,
            "action": action,
            "message": message,
            "timestamp": datetime.now().isoformat()
        }
        self.results.append(result)
        return result
    
    def run(self, target_names: List[str] = None):
        """Основной цикл обработки"""
        targets = target_names or self.targets
        if not targets:
            logger.warning("No targets specified. Exiting.")
            return
        
        logger.info(f"Starting Prorok with {len(targets)} targets.")
        for name in targets:
            try:
                self.process_target(name)
            except Exception as e:
                logger.error(f"Error processing {name}: {e}")
        
        # Сохранить отчёт
        with open("report.json", 'w', encoding='utf-8') as f:
            json.dump(self.results, f, indent=2, ensure_ascii=False)
        
        logger.info("Processing complete. Report saved.")
        
        if CONFIG["self_destruct"]:
            self.self_destruct.clean_traces()

# ====================== ТОЧКА ВХОДА ======================
