# 6. ПРИЧИННАЯ МОДЕЛЬ (Causal Model) — P(success | context, action)
# =============================================================================

class CausalModel:
    """
    Байесовская оценка успеха действия в контексте.
    Использует сглаживание Лапласа и хранит неопределённость.
    """
    def __init__(self):
        # (context_key, action) -> [successes, failures]
        self.stats: Dict[Tuple[str, str], List[int]] = {}

    def _context_key(self, state_dict: Dict) -> str:
        # Упрощённо: используем первые 2 объекта из state или общий хеш
        if isinstance(state_dict, dict) and "objects" in state_dict:
            return f"obj:{json.dumps(state_dict['objects'], sort_keys=True)}"
        return json.dumps(state_dict, sort_keys=True)[:50]

    def predict_success(self, state: Dict, action: str) -> float:
        key = (self._context_key(state), action)
        if key in self.stats:
            s, f = self.stats[key]
            total = s + f
            if total > 0:
                return (s + 1) / (total + 2)  # Laplace smoothing
        # Если нет данных, возвращаем 0.5 + небольшое смещение в зависимости от действия
        if action in ["observe", "reflect"]:
            return 0.6
        elif action == "act":
            return 0.4
        else:
            return 0.5

    def update(self, state: Dict, action: str, success: float):
        key = (self._context_key(state), action)
        if key not in self.stats:
            self.stats[key] = [0, 0]
        if success >= 0.7:  # считаем успехом
            self.stats[key][0] += 1
        else:
            self.stats[key][1] += 1

    def get_confidence(self, state: Dict, action: str) -> float:
        """
        На основе числа примеров: чем больше данных, тем выше уверенность.
        """
        key = (self._context_key(state), action)
        if key in self.stats:
            total = sum(self.stats[key])
            if total > 0:
                # Уверенность растёт с количеством наблюдений (логарифмически)
                return min(1.0, math.log(total + 1) / 5.0)
        return 0.0

