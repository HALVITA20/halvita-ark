# 10. ФУНКЦИЯ ВЫБОРА ДЕЙСТВИЯ (с планированием)
# =============================================================================

def select_action(state: Dict,
                  goals: GoalSystem,
                  identity: IdentityLayer,
                  causal_model: CausalModel,
                  world_model: WorldModel,
                  emotions: EmotionEngine,
                  body: Body,
                  planning_horizon: int = Config.PLANNING_HORIZON,
                  exploration_rate: float = Config.EXPLORATION_BASE) -> str:
    """
    Выбирает действие, максимизируя ожидаемую полезность с учётом планирования.
    """
    available_actions = list(Config.ACTION_COST.keys())
    # Фильтруем по доступной энергии и ценностям
    available_actions = [a for a in available_actions if body.can_afford(a) and identity.filter_action(a)]
    if not available_actions:
        return "wait"

    emotions_state = emotions.get_current_state()
    # Модуляция exploration
    effective_exploration = exploration_rate * emotions.get_exploration_modulation()

    # Если исследование — выбираем случайное действие
    if random.random() < effective_exploration:
        return random.choice(available_actions)

    # Иначе — оценка каждого действия
    best_action = None
    best_value = -float('inf')

    for action in available_actions:
        value = evaluate_action_with_plan(
            state=state,
            action=action,
            goals=goals,
            identity=identity,
            causal_model=causal_model,
            world_model=world_model,
            emotions=emotions,
            body=body,
            depth=planning_horizon - 1,
            discount=0.8
        )
        if value > best_value:
            best_value = value
            best_action = action

    return best_action if best_action else "wait"

def evaluate_action_with_plan(state: Dict,
                              action: str,
                              goals: GoalSystem,
                              identity: IdentityLayer,
                              causal_model: CausalModel,
                              world_model: WorldModel,
                              emotions: EmotionEngine,
                              body: Body,
                              depth: int,
                              discount: float) -> float:
    """
    Рекурсивно оценивает действие, моделируя следующие шаги.
    """
    # Немедленная полезность
    immediate_value = 0.0

    # 1. Предсказание успеха
    predicted_success = causal_model.predict_success(state, action)
    # Уверенность
    confidence = causal_model.get_confidence(state, action)
    # Если неуверены — небольшой бонус за исследование
    immediate_value += predicted_success + (1 - confidence) * 0.1

    # 2. Стоимость действия
    cost = Config.ACTION_COST.get(action, 1.0) / 10.0
    immediate_value -= cost

    # 3. Эмоциональный bias
    emo = emotions.get_current_state()
    if action == "explore" and emo.get("curiosity", 0) > 0.5:
        immediate_value += 0.2
    if action == "act" and emo.get("fear", 0) > 0.4:
        immediate_value -= 0.3

    # 4. Вклад в цели
    current_goal = goals.get_highest_priority_goal()
    if current_goal:
        # Упрощённо: некоторые действия лучше соответствуют некоторым целям
        if "исследовать" in current_goal.description.lower() and action in ["observe", "explore"]:
            immediate_value += 0.3
        if "энерг" in current_goal.description.lower() and action in ["wait", "reflect"]:
            immediate_value += 0.3

    # 5. Планирование на будущее (если глубина > 0)
    if depth > 0:
        # Предсказываем следующее состояние (наиболее вероятное)
        next_state_dist = world_model.predict_distribution(state, action)
        if next_state_dist:
            # Берём наиболее вероятное следующее состояние
            next_state_key = max(next_state_dist, key=next_state_dist.get)
            next_state = json.loads(next_state_key)
        else:
            next_state = state  # если не знаем, оставляем как есть

        # Оцениваем лучший следующий шаг из этого состояния
        available_actions = [a for a in Config.ACTION_COST.keys() if body.can_afford(a)]
        if available_actions:
            next_values = []
            for next_action in available_actions:
                v = evaluate_action_with_plan(
                    state=next_state,
                    action=next_action,
                    goals=goals,
                    identity=identity,
                    causal_model=causal_model,
                    world_model=world_model,
                    emotions=emotions,
                    body=body,
                    depth=depth - 1,
                    discount=discount
                )
                next_values.append(v)
            future_value = max(next_values) if next_values else 0.0
            immediate_value += discount * future_value

    return immediate_value

