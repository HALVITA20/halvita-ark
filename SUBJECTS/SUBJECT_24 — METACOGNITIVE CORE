class AutonomousLoop:
    def __init__(self, subject: Subject24):
        self.subject = subject
        self.running = False

    async def run(self):
        self.running = True
        while self.running:
            await asyncio.sleep(Config.AUTONOMOUS_INTERVAL)
            try:
                # Автономный цикл без внешнего события
                self.subject.cycle("")
            except Exception as e:
                print(f"Автономный цикл ошибка: {e}")

    def stop(self):
        self.running = False

