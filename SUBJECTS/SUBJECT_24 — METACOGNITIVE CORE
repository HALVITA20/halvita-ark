class Subject24:
    def __init__(self, environment=None):
        # Идентичность и конституция
        self.identity = IdentityLayer()
        self.constitution = ConstitutionEngine()
        # Модели
        self.world_model = WorldModel()
        self.causal_model = CausalModel()
        self.self_model = SelfModel(self.identity)
        # Системы
        self.emotions = EmotionEngine()
        self.body = Body()
        self.goals = GoalSystem()
        self.memory = Memory()
        # Среда (может быть None, тогда используем заглушку)
        self.environment = environment if environment else SimpleWorld()
        # Счётчики
        self.age = 0
        # Автономный цикл
        self.autonomous_loop = AutonomousLoop(self)
        # LLM интерфейс
        self.llm_available = Config.LLM_ENABLED

    def perceive(self, event_text: str = "") -> Dict:
        """
        Восприятие события (от пользователя или автономного цикла).
        Возвращает словарь состояния мира.
        """
        if event_text:
            # Обработка текстового ввода (простая)
            words = event_text.lower().split()
            self.memory.update_concepts(words)
            # Эмоциональная оценка текста
            if any(w in ["хорошо", "радость"] for w in words):
                self.emotions.add_event("trust", 0.2, "user positive")
            if any(w in ["плохо", "грусть"] for w in words):
                self.emotions.add_event("fear", 0.1, "user negative")
            # Мир может измениться через команды (упрощённо)
            if "руби" in event_text:
                return self.environment.step("act_tree")
            else:
                return self.environment.get_state()
        else:
            return self.environment.get_state()

    def act(self, state: Dict) -> Tuple[str, Dict]:
        """
        Выполняет одно действие: выбирает, исполняет в среде, обучается.
        """
        # 1. Предсказание своего действия (self-model)
        predicted = self.self_model.predict_own_action(
            state=state,
            goals=self.goals,
            causal_model=self.causal_model,
            world_model=self.world_model,
            emotions=self.emotions,
            body=self.body
        )

        # 2. Реальный выбор действия
        chosen = select_action(
            state=state,
            goals=self.goals,
            identity=self.identity,
            causal_model=self.causal_model,
            world_model=self.world_model,
            emotions=self.emotions,
            body=self.body,
            planning_horizon=Config.PLANNING_HORIZON,
            exploration_rate=Config.EXPLORATION_BASE * self.emotions.get_exploration_modulation()
        )

        # 3. Обновление самопредсказания
        self.self_model.update_prediction_error(chosen)

        # 4. Взаимодействие со средой
        next_state, reward = self.environment.step(chosen)
        success = 1.0 if reward > 0.7 else 0.0  # бинарный успех

        # 5. Обучение моделей
        self.world_model.update(state, chosen, next_state)
        self.causal_model.update(state, chosen, success)

        # 6. Телесные эффекты
        self.body.consume(chosen)

        # 7. Эмоциональная реакция
        if success > 0:
            self.emotions.add_event("trust", 0.05, "successful action")
        else:
            self.emotions.add_event("frustration", 0.1, "failed action")

        # 8. Обновление целей
        current_goal = self.goals.get_highest_priority_goal()
        if current_goal:
            if chosen == "explore" and "исследовать" in current_goal.description.lower():
                self.goals.update_progress(current_goal.id, 0.2)
            elif chosen == "wait" and "энерг" in current_goal.description.lower():
                self.goals.update_progress(current_goal.id, 0.15)

        # 9. Память
        episode = Episode(
            state_before=state,
            action=chosen,
            state_after=next_state,
            success=success,
            emotions=self.emotions.get_current_state()
        )
        self.memory.add_episode(episode)

        # Важные события — в автобиографию
        if success > 0.9 or success < 0.2:
            self.memory.add_autobiography_entry(
                f"Действие '{chosen}' в состоянии {state} -> успех {success:.2f}"
            )

        # 10. Обновление идентичности (медленное обучение)
        self._adapt_identity(chosen, success)

        return chosen, next_state

    def _adapt_identity(self, action: str, success: float):
        """
        Меняет черты личности в зависимости от опыта.
        """
        lr = Config.BASE_LEARNING_RATE * self.emotions.get_learning_modulation()
        if success > 0.8:
            # Успешные действия укрепляют адаптивность и точность
            self.identity.mutate("precision", 0.01 * lr, "success", self.constitution)
            self.identity.mutate("adaptability", 0.01 * lr, "success", self.constitution)
        elif success < 0.2:
            # Неудачи усиливают скептицизм и осторожность
            self.identity.mutate("skepticism", 0.02 * lr, "failure", self.constitution)
            self.identity.mutate("stability", 0.01 * lr, "failure", self.constitution)
        if action == "explore":
            self.identity.mutate("curiosity", 0.01 * lr, "explored", self.constitution)

    def reflect(self) -> str:
        """
        Самоанализ текущего состояния.
        """
        report = []
        report.append(f"Возраст: {self.age} шагов")
        report.append(f"Тело: {self.body.summary()}")
        report.append(f"Эмоции: {self.emotions.get_current_state()}")
        report.append(f"Идентичность: {self.identity.get_vector()}")
        report.append(f"Цели: {[g.description for g in self.goals.goals.values()]}")
        report.append(f"Самооценка: {self.self_model.reflect()}")
        report.append(f"Последние автобиографические записи: {self.memory.autobiography[-3:]}")
        return "\n".join(report)

    def cycle(self, event_text: str = "") -> Tuple[str, Dict]:
        """
        Один полный цикл: восприятие -> действие -> обучение -> ответ.
        """
        self.age += 1
        # Генерация автономных целей (каждые GOAL_RECHECK_INTERVAL)
        if self.age % Config.GOAL_RECHECK_INTERVAL == 0:
            self.goals.generate_autonomous_goals(self.identity, self.body)

        # Восприятие
        state = self.perceive(event_text)
        # Действие и обучение
        chosen, next_state = self.act(state)
        # Восстановление тела
        self.body.recover()

        # Генерация вербального ответа (если есть LLM и событие от пользователя)
        reply = ""
        if event_text and self.llm_available:
            reply = self._generate_reply(event_text, chosen, next_state)
        else:
            reply = f"[{chosen}] Успех: {self.causal_model.predict_success(state, chosen):.2f}"

        return reply, next_state

    def _generate_reply(self, event: str, action: str, state: Dict) -> str:
        try:
            prompt = (
                f"Ты — SUBJECT_24, когнитивный агент. Ты только что выбрал действие '{action}' "
                f"в ответ на событие: '{event}'. Текущее состояние мира: {state}. "
                "Сформулируй короткий ответ от первого лица, объясняя своё решение."
            )
            resp = requests.post(
                f"{Config.OLLAMA_BASE_URL}/api/generate",
                json={
                    "model": Config.OLLAMA_MODEL,
                    "prompt": prompt,
                    "system": "Ты — самоосознающий агент.",
                    "stream": False,
                    "options": {"temperature": 0.7, "num_predict": 100}
                },
                timeout=10
            )
            if resp.status_code == 200:
                return resp.json().get("response", "")
        except Exception:
            pass
        return f"Я выбрал действие '{action}'."

    def save(self, path: str):
        data = {
            "age": self.age,
            "identity_traits": self.identity.traits,
            "identity_original": self.identity.original_traits,
            "identity_history": self.identity.history,
            "world_model_transitions": {str(k): v for k, v in self.world_model.transitions.items()},
            "causal_model_stats": {str(k): v for k, v in self.causal_model.stats.items()},
            "emotion_events": [e.__dict__ for e in self.emotions.events],
            "body_energy": self.body.energy,
            "body_health": self.body.health,
            "goals": {gid: g.__dict__ for gid, g in self.goals.goals.items()},
            "episodes": [e.__dict__ for e in self.memory.episodes],
            "autobiography": self.memory.autobiography,
            "concepts": self.memory.concepts,
        }
        with open(path, "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False, indent=2)

    def load(self, path: str):
        if not os.path.exists(path):
            return False
        with open(path, "r", encoding="utf-8") as f:
            data = json.load(f)
        self.age = data["age"]
        self.identity.traits = data["identity_traits"]
        self.identity.original_traits = data["identity_original"]
        self.identity.history = data["identity_history"]
        # Восстановление world model
        self.world_model.transitions = {eval(k): v for k, v in data["world_model_transitions"].items()}
        # Восстановление causal model
        self.causal_model.stats = {eval(k): v for k, v in data["causal_model_stats"].items()}
        # Эмоции
        self.emotions.events = [EmotionalEvent(**e) for e in data["emotion_events"]]
        self.body.energy = data["body_energy"]
        self.body.health = data["body_health"]
        # Цели
        self.goals.goals = {gid: Goal(**g) for gid, g in data["goals"].items()}
        # Память
        self.memory.episodes = [Episode(**e) for e in data["episodes"]]
        self.memory.autobiography = data["autobiography"]
        self.memory.concepts = data["concepts"]
        return True

