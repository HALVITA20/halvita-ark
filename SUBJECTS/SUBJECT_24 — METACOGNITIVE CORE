class SimpleWorld:
    def __init__(self):
        self.objects = {"tree": 3, "rock": 2}
        self.time = 0

    def get_state(self) -> Dict:
        return {"objects": dict(self.objects), "time": self.time}

    def step(self, action: str) -> Tuple[Dict, float]:
        self.time += 1
        if action == "observe":
            reward = 0.7
        elif action == "act_tree" or action == "act":
            if self.objects.get("tree", 0) > 0:
                self.objects["tree"] -= 1
                reward = 0.9
            else:
                reward = 0.2
        elif action == "explore":
            reward = 0.6 + random.uniform(-0.1, 0.3)
        elif action == "wait":
            reward = 0.5
        elif action == "reflect":
            reward = 0.6
        else:
            reward = 0.4
        return self.get_state(), reward

