class IdentityLayer:
    """
    Устойчивая модель личности, влияющая на все решения.
    Состоит из:
    - traits: непрерывные черты (genome)
    - values: дискретные ценности (фильтры действий)
    - self_history: история изменений для контроля непрерывности
    """
    def __init__(self):
        # Геном (те же черты, что и раньше, но теперь интегрированы)
        self.traits = {
            "curiosity": 0.7,
            "stability": 0.7,
            "precision": 0.75,
            "creativity": 0.8,
            "skepticism": 0.6,
            "empathy": 0.7,
            "introspection": 0.8,
            "adaptability": 0.6
        }
        # Исходный геном для контроля drift
        self.original_traits = dict(self.traits)
        # Ценности-фильтры (действия, которые субъект не выберет)
        self.values = ["не навреди", "будь честным", "развивайся"]
        # История слепков
        self.history: List[Dict] = []

    def mutate(self, trait: str, delta: float, reason: str,
               constitution: 'ConstitutionEngine') -> bool:
        if trait not in self.traits:
            return False
        if not constitution.allow_change(trait, delta, self):
            return False
        old = self.traits[trait]
        new = max(0.0, min(1.0, old + delta))
        self.traits[trait] = new
        self.history.append({
            "time": time.time(),
            "trait": trait,
            "old": old,
            "new": new,
            "reason": reason
        })
        return True

    def drift_from_original(self) -> float:
        """Расхождение с изначальным 'я'."""
        diff_sq = sum((self.traits[k] - self.original_traits[k])**2
                      for k in self.traits)
        return math.sqrt(diff_sq / len(self.traits))

    def get_vector(self) -> Dict[str, float]:
        return dict(self.traits)

    def filter_action(self, action: str) -> bool:
        """
        Проверяет, допустимо ли действие с точки зрения ценностей.
        Например, 'act' с разрушением может быть отфильтровано.
        Пока заглушка, но можно расширить.
        """
        # В будущем здесь может быть сложная проверка
        return True

