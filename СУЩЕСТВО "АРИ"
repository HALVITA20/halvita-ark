function computeContext(userMessage, history) {
    const state = getSelfState();
    return {
        userMessage,
        history: history.slice(-10),
        goal: state.direction.goal || 'clarity',
        uncertainty: userMessage.includes('?') ? 0.7 : 0.3,
        hasPlan: userMessage.includes('план') ? 0.8 : 0,
        questionDepth: userMessage.split('?').length - 1,
        topic: userMessage.length > 50 ? 'complex' : 'simple',
        state: state
    };
}

function decide(context, weights) {
    const baseScores = {
        ask: context.uncertainty * weights.ask || 0.5,
        act: (context.hasPlan ? 0.8 : 0) * (weights.act || 0.5),
        reflect: context.questionDepth * (weights.reflect || 0.5),
        respond: 0.5 * (weights.respond || 0.5)
    };

    let scores = { ...baseScores };

    // Применяем когнитивные атомы (влияние <= 0.2)
    const atoms = getRelevantAtoms(context, 5);
    for (const atom of atoms) {
        const impact = atom.effectiveConfidence * CONFIG.MAX_INFLUENCE;
        if (atom.type === 'preference' || atom.type === 'habit') {
            if (atom.property === 'structure' && atom.value === 'high') scores.act = Math.min(1, scores.act + impact * 0.5);
            if (atom.property === 'depth' && atom.value === 'high') scores.reflect = Math.min(1, scores.reflect + impact * 0.5);
            if (atom.property === 'brevity' && atom.value === 'high') scores.respond = Math.min(1, scores.respond + impact * 0.5);
        }
        if (atom.type === 'constraint') {
            if (atom.property === 'depth' && atom.value === 'low') scores.reflect = Math.max(0, scores.reflect - impact * 0.5);
        }
    }

    // Уроки
    const lessons = getRelevantLessons(context);
    for (const lesson of lessons) {
        if (lesson.lesson.includes('пересмотреть') || lesson.lesson.includes('ошибка')) {
            scores.ask += 0.1;
            scores.reflect += 0.1;
        }
        markLessonApplied(lesson.id);
    }

    const maxScore = Math.max(...Object.values(scores), 0.01);
    for (let key in scores) scores[key] = scores[key] / maxScore;

    // Исследование при зацикливании
    if (state.streak > CONFIG.EXPLORATION_THRESHOLD) {
        const actions = Object.keys(scores).filter(a => a !== state.lastAction);
        const action = actions[Math.floor(Math.random() * actions.length)];
        state.explorationCount = (state.explorationCount || 0) + 1;
        return { action, confidence: 0.3, exploration: true };
    }

    const action = Object.entries(scores).sort((a, b) => b[1] - a[1])[0][0];
    const confidence = scores[action];
    return { action, confidence, exploration: false };
}

