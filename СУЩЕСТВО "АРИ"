// memory/beliefs.js

export class BeliefMemory {

    constructor(state = {}) {

        this.beliefs = state.beliefs || [];

    }


    add(type, domain, content, confidence = 0.5) {

        const existing = this.beliefs.find(
            b =>
            b.domain === domain &&
            b.content === content
        );


        if(existing){

            existing.confidence =
                Math.min(
                    1,
                    existing.confidence + 0.05
                );

            return;
        }


        this.beliefs.push({

            id: crypto.randomUUID(),

            type,

            domain,

            content,

            confidence,

            created: Date.now(),

            confirmations:1
        });


        this.limit();

    }



    getRelevant(context){

        const words =
            context.userMessage
            .toLowerCase()
            .split(" ");


        return this.beliefs
        .filter(b => {

            return words.some(
                w =>
                b.content
                .toLowerCase()
                .includes(w)
            );

        })
        .sort(
            (a,b)=>
            b.confidence-a.confidence
        )
        .slice(0,10);

    }



    reinforce(id,value){

        const belief =
        this.beliefs.find(
            b=>b.id===id
        );


        if(!belief)return;


        belief.confidence =
        Math.max(
            0,
            Math.min(
                1,
                belief.confidence + value
            )
        );

    }



    limit(){

        if(this.beliefs.length>500){

            this.beliefs =
            this.beliefs
            .slice(-500);

        }

    }



    export(){

        return {
            beliefs:this.beliefs
        };

    }

}

