function createEmptyBelief() {
    return {
        id: null,
        type: null,          // preference, rule, avoidance, fact
        domain: null,        // user_style, user_skill, user_goal, world_fact, project_context
        property: null,      // structure, depth, brevity, metaphor, technical, other
        value: null,         // high, low, prefers, avoids
