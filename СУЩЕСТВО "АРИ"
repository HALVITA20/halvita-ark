            body: JSON.stringify({ model: CONFIG.MODEL, prompt, stream: false, options: { temperature: CONFIG.TEMPERATURE, num_predict: CONFIG.MAX_TOKENS } }),
            signal: controller.signal
        });
        clearTimeout(timeout);
        const data = await res.json();
        return data.response || "";
    }
}

