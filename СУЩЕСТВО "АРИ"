function detectNegationAround(text, index) {
    const before = text.slice(Math.max(0, index - 30), index);
    const after = text.slice(index, Math.min(text.length, index + 30));
    if (/\bне\b/.test(before) || /\bне\b/.test(after)) return true;
    const words = before.split(/\s+/).slice(-5);
    if (words.some(w => ['не', 'нет', 'ни', 'никогда'].includes(w))) return true;
    return false;
}

function parsePropertyValue(fragment) {
    const lower = fragment.toLowerCase();
    if (lower.includes('структур') || lower.includes('план') || lower.includes('архитектур') || lower.includes('систем')) {
        return { property: 'structure', value: 'high' };
    }
    if (lower.includes('глубок') || lower.includes('философ') || lower.includes('смысл') || lower.includes('суть')) {
        return { property: 'depth', value: 'high' };
    }
    if (lower.includes('кратк') || lower.includes('ясн') || lower.includes('чётк') || lower.includes('сжато')) {
        return { property: 'brevity', value: 'high' };
    }
    if (lower.includes('метафор') || lower.includes('образ') || lower.includes('сравнен')) {
        return { property: 'metaphor', value: 'high' };
    }
    if (lower.includes('технич') || lower.includes('код') || lower.includes('детал') || lower.includes('алгоритм')) {
        return { property: 'technical', value: 'high' };
    }
    return null;
}

function extractContext(text) {
    const topics = [];
    const lower = text.toLowerCase();
    if (lower.includes('архитектур') || lower.includes('проект') || lower.includes('систем')) topics.push('architecture');
    if (lower.includes('работа') || lower.includes('дело') || lower.includes('задач')) topics.push('work');
    if (lower.includes('личн') || lower.includes('жизн') || lower.includes('чувств')) topics.push('personal');
    if (lower.includes('код') || lower.includes('программ') || lower.includes('алгоритм')) topics.push('technical');
    return { topics: topics.length ? topics : ['general'], task: null };
}

function extractBeliefsRules(text) {
    const results = [];
    const lower = text.toLowerCase();
    const patterns = [
        { trigger: 'люблю', type: 'preference', polarity: 1 },
        { trigger: 'нравится', type: 'preference', polarity: 1 },
        { trigger: 'предпочитаю', type: 'preference', polarity: 1 },
        { trigger: 'не люблю', type: 'avoidance', polarity: -1 },
        { trigger: 'не нравится', type: 'avoidance', polarity: -1 },
        { trigger: 'терпеть не могу', type: 'avoidance', polarity: -1 }
    ];

    for (const pattern of patterns) {
        const idx = lower.indexOf(pattern.trigger);
        if (idx === -1) continue;
        const hasNeg = detectNegationAround(text, idx);
        const finalPolarity = pattern.polarity * (hasNeg ? -1 : 1);
        const rest = text.slice(idx + pattern.trigger.length).trim();
        const end = rest.search(/[.!?]/) + 1 || rest.length;
        const fragment = rest.slice(0, end).trim();
        if (fragment.length < 3) continue;

        const propVal = parsePropertyValue(fragment);
        if (!propVal) continue;

        results.push({
            type: finalPolarity > 0 ? 'preference' : 'avoidance',
            domain: 'user_style',
            property: propVal.property,
            value: finalPolarity > 0 ? 'high' : 'low',
            confidence: 0.6,
            certainty: 0.5,
            importance: 0.5,
            source: 'user',
            subject: { type: 'user', id: 'primary' },
            evidence: [{ timestamp: Date.now(), fragment: fragment }],
            context: extractContext(text)
        });
    }

    // Косвенные сигналы
    if ((text.match(/\?/g) || []).length > 2) {
        results.push({
            type: 'preference',
            domain: 'user_style',
            property: 'depth',
            value: 'high',
            confidence: 0.35,
            importance: 0.2,
            source: 'inferred',
            subject: { type: 'user', id: 'primary' },
            context: { topics: ['general'] }
        });
    }
    if (/\d\./.test(text) || text.includes('\n')) {
        results.push({
            type: 'preference',
            domain: 'user_style',
            property: 'structure',
            value: 'high',
            confidence: 0.3,
            importance: 0.2,
            source: 'inferred',
            subject: { type: 'user', id: 'primary' },
            context: { topics: ['general'] }
        });
    }

    return results;
}

async function extractBeliefsHybrid(text) {
    // Если текст короткий и очевидный, используем rules
    if (text.length < 80 || text.includes('люблю') || text.includes('нравится')) {
        return extractBeliefsRules(text);
    }

    // Иначе пробуем LLM
    try {
        const prompt = `
Извлеки предпочтения пользователя из текста.
Верни JSON-массив объектов с полями:
- property: structure, depth, brevity, metaphor, technical, other
- value: high, low, prefers, avoids
- confidence: 0.0..1.0
- context: { topics: [...] }

Текст:
${text}

JSON:`;
        const response = await callOllama(prompt, { temperature: 0.2, num_predict: 200 });
        const parsed = JSON.parse(response);
        if (Array.isArray(parsed) && parsed.length > 0) {
            return parsed.map(p => ({
                type: 'preference',
                domain: 'user_style',
                property: p.property || 'other',
                value: p.value || 'neutral',
                confidence: p.confidence || 0.5,
                certainty: 0.5,
                importance: 0.5,
                source: 'inferred',
                subject: { type: 'user', id: 'primary' },
                context: p.context || { topics: ['general'] }
            }));
        }
    } catch (e) {
        // fallback
    }
    return extractBeliefsRules(text);
}

// ============================================================
//  ВЫЗОВ OLLAMA
// ============================================================
async function callOllama(prompt, options = {}) {
    const url = "http://localhost:11434/api/generate";
    for (let attempt = 0; attempt <= CONFIG.OLLAMA_RETRIES; attempt++) {
        try {
            const controller = new AbortController();
            const timeout = setTimeout(() => controller.abort(), CONFIG.OLLAMA_TIMEOUT);
            const res = await fetch(url, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    model: CONFIG.MODEL,
                    prompt: prompt,
                    stream: false,
                    options: {
                        temperature: options.temperature || CONFIG.TEMPERATURE,
                        num_predict: options.num_predict || CONFIG.MAX_TOKENS,
                        stop: ["\n\n\n", "Хальвита:", "Ари:"]
                    }
                }),
                signal: controller.signal
            });
            clearTimeout(timeout);
            if (!res.ok) throw new Error("HTTP " + res.status);
            const data = await res.json();
            return data.response || "";
        } catch (err) {
            console.error("[OLLAMA] attempt", attempt, err.message);
            if (attempt === CONFIG.OLLAMA_RETRIES) {
                return "";
            }
            await new Promise(r => setTimeout(r, 2000 * (attempt + 1)));
        }
    }
    return "";
}

// ============================================================
//  DECISION (С ОГРАНИЧЕННЫМ ВЛИЯНИЕМ УБЕЖДЕНИЙ)
// ============================================================
function decide(context, weights, beliefMemory) {
    const baseScores = {
        ask: context.uncertainty * weights.ask,
        act: (context.hasPlan ? 0.8 : 0) * weights.act,
        reflect: context.questionDepth * weights.reflect,
        respond: 0.5 * weights.respond
    };

    let scores = { ...baseScores };
    const beliefs = beliefMemory.getRelevant(context);
    const resolved = beliefMemory.resolveConflicts(beliefs, context);

    for (const belief of resolved) {
        const eff = belief.effectiveConfidence || belief.confidence;
        const maxImpact = CONFIG.MAX_INFLUENCE * eff;

        if (belief.type === 'preference' || belief.type === 'rule') {
            if (belief.property === 'structure' && belief.value === 'high') {
                scores.act = Math.min(1, scores.act + maxImpact * 0.5);
            }
            if (belief.property === 'depth' && belief.value === 'high') {
                scores.reflect = Math.min(1, scores.reflect + maxImpact * 0.5);
            }
            if (belief.property === 'brevity' && belief.value === 'high') {
                scores.respond = Math.min(1, scores.respond + maxImpact * 0.5);
            }
            if (belief.property === 'technical' && belief.value === 'high') {
                scores.act = Math.min(1, scores.act + maxImpact * 0.3);
                scores.respond = Math.max(0, scores.respond - maxImpact * 0.1);
            }
        }
        if (belief.type === 'avoidance') {
            if (belief.property === 'depth' && belief.value === 'low') {
                scores.reflect = Math.max(0, scores.reflect - maxImpact * 0.5);
                scores.respond = Math.min(1, scores.respond + maxImpact * 0.3);
            }
            if (belief.property === 'brevity' && belief.value === 'low') {
                scores.respond = Math.max(0, scores.respond - maxImpact * 0.5);
                scores.act = Math.min(1, scores.act + maxImpact * 0.3);
            }
        }
    }

    const maxScore = Math.max(...Object.values(scores), 0.01);
    for (let key in scores) scores[key] = scores[key] / maxScore;

    // Принудительное исследование при зацикливании
    if (state.streak > CONFIG.EXPLORATION_THRESHOLD) {
        const actions = Object.keys(scores).filter(a => a !== state.lastAction);
        const action = actions[Math.floor(Math.random() * actions.length)];
        state.explorationCount = (state.explorationCount || 0) + 1;
        return { action, confidence: 0.3, exploration: true };
    }

    const action = Object.entries(scores).sort((a, b) => b[1] - a[1])[0][0];
    const confidence = scores[action];
    return { action, confidence, exploration: false };
}

// ============================================================
//  EVALUATION
// ============================================================
function evaluate(context, result, decision) {
    let structural = 0;
    let outcome = 0;

    if (decision.action === "ask" && result.includes("?")) structural += 1;
    if (decision.action === "act" && result.includes("1.")) structural += 1;
    if (decision.action === "reflect" && result.includes("думаю")) structural += 0.5;

    const recentReplies = state.history.filter(m => m.role === "ari").slice(-5).map(m => m.text);
    const isRepeating = recentReplies.some(r => r === result);
    if (!isRepeating) outcome += 0.5;

    const last10 = state.memory.slice(-10).map(m => m.text);
    const isNovel = !last10.some(m => m === result);
    if (isNovel) outcome += 0.5;

    if (context.goal === "clarity" && result.length < 500) outcome += 0.5;
    if (result.includes("1.") || result.includes("2.") || result.includes("3.")) outcome += 0.3;

    const lastActions = state.history.filter(m => m.role === "ari").slice(-3).map(m => m.action);
    if (lastActions.every(a => a === decision.action)) {
        outcome -= 0.5;
    }

    const total = 0.3 * structural + 0.7 * Math.max(0, Math.min(2, outcome));
    return Math.max(0, Math.min(2, total));
}

// ============================================================
//  UPDATE (SOFT UPDATE + REINFORCEMENT)
// ============================================================
function updateWeights(decision, score) {
    const lr = CONFIG.LEARNING_RATE;
    const action = decision.action;

    state.weights[action] = state.weights[action] * 0.9 + (score / 2) * 0.1;
    for (let a in state.weights) {
        if (a !== action) {
            state.weights[a] = state.weights[a] * 0.98;
        }
    }

    const sum = Object.values(state.weights).reduce((a, b) => a + b, 0);
    for (let a in state.weights) {
        state.weights[a] = Math.max(CONFIG.MIN_WEIGHT, Math.min(CONFIG.MAX_WEIGHT, state.weights[a] / sum));
    }

    if (state.lastAction === action) {
        state.streak = (state.streak || 0) + 1;
    } else {
        state.streak = 0;
    }
    state.lastAction = action;

    const error = Math.abs(decision.confidence - (score / 2));
    state.performance.push({
        action,
        confidence: decision.confidence,
        score,
        error,
        timestamp: Date.now()
    });
    if (state.performance.length > 100) state.performance = state.performance.slice(-100);
}

// ============================================================
//  ОБСЛУЖИВАНИЕ (review + prune) — вызывается периодически
// ============================================================
function maintenance() {
    const reviewed = beliefMemory.review();
    const pruned = beliefMemory.prune();
    if (reviewed || pruned) {
        console.log(`[MAINTENANCE] Reviewed: ${reviewed ? 'yes' : 'no'}, Pruned: ${pruned}`);
        saveJSON(PATHS.state, state);
        saveJSON(PATHS.memory, { memory: state.memory });
    }
}

// ============================================================
//  ГЕНЕРАЦИЯ ОТВЕТА
