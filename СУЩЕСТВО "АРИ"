async function processInput(userMessage) {
    // 1. Контекст
    const context = {
        userMessage,
        history: history.slice(-10),
        goal: state.goal,
        ethosPhase: state.ethosPhase,
        protocol: state.protocol,
        uncertainty: userMessage.includes("?") ? 0.7 : 0.3,
        hasPlan: userMessage.includes("план") ? 0.8 : 0,
        questionDepth: userMessage.split("?").length - 1,
        ethosViolation: false
    };

    // 2. Решение
    const decision = decide(context);
    context.decision = decision;

    // 3. Действие (executor)
    let instruction = "";
    switch (decision.action) {
        case "ask":
            instruction = "Задай уточняющий вопрос, не давая ответа.";
            break;
        case "act":
            instruction = "Сделай конкретный шаг или предложи план действий.";
            break;
        case "reflect":
            instruction = "Поразмышляй над этим. Не давай окончательного ответа.";
            break;
        case "refuse":
            instruction = "Откажись от действия. ETHOS нарушен.";
            break;
        case "respond":
        default:
            instruction = "Ответь прямо и ясно.";
            break;
    }

    const result = await generateResponse(context, instruction);
    const cleanResult = result.trim() || "Я здесь.";

    // 4. Оценка (без LLM)
    const score = evaluate(cleanResult, context);

    // 5. Обновление
    updateSystem(decision, score);

    // 6. Сохраняем в историю
    history.push({ role: "user", text: userMessage });
    history.push({ role: "ari", text: cleanResult });
    if (history.length > 50) history = history.slice(-50);
    state.history = history;
    remember("user", userMessage);
    remember("ari", cleanResult);

    // 7. Лог обучения
    console.log(`[LEARN] action: ${decision.action}, score: ${score.toFixed(2)}, weights:`, state.weights);

    return cleanResult;
}

