// ================================================================
//  2. IDENTITY FIREWALL: Personality (медленная), Mood (быстрая)
// ================================================================
class Identity {
    constructor() {
        this.personality = {};
        this.mood = {};
        this.selfModel = {};
    }
    async init() {
        this.personality = await loadJSON(FILES.personality, {
            curiosity: 0.8, precision: 0.6, empathy: 0.75, confidence: 0.5, patience: 0.7
        });
        this.mood = await loadJSON(FILES.mood, {
            frustration: 0.2, surprise: 0.1, engagement: 0.7
        });
        this.selfModel = await loadJSON(FILES.self_model, {
            beliefs: [], stability: 1.0
        });
    }

    // Изменить черту личности медленно, с защитой от резких скачков
    adjustPersonality(trait, delta, cause) {
        if (!this.personality[trait]) return;
        const clampedDelta = Math.max(-CONFIG.MAX_PERSONALITY_DELTA_PER_CYCLE, Math.min(CONFIG.MAX_PERSONALITY_DELTA_PER_CYCLE, delta));
        this.personality[trait] = Math.max(0, Math.min(1, this.personality[trait] + clampedDelta));
        this._savePersonality();
    }

    // Изменить настроение (быстро, но с затуханием)
    adjustMood(mood, delta) {
        if (!this.mood[mood]) return;
        this.mood[mood] = Math.max(0, Math.min(1, this.mood[mood] + delta));
        this._saveMood();
    }

    // Затухание настроения к baseline
    decayMood() {
        for (let k in this.mood) {
            this.mood[k] = this.mood[k] * (1 - CONFIG.MOOD_DECAY) + 0.2 * CONFIG.MOOD_DECAY; // baseline 0.2 для негативных, но у нас все позитивные? Упростим
        }
        this._saveMood();
    }

    // Убеждения о себе (Self Model 2.0)
    addSelfBelief(belief, confidence, evidence) {
        const existing = this.selfModel.beliefs.find(b => b.belief === belief);
        if (existing) {
            existing.confidence = (existing.confidence * existing.evidence.length + confidence) / (existing.evidence.length + 1);
            existing.evidence.push(evidence);
        } else {
            this.selfModel.beliefs.push({ belief, confidence, evidence: [evidence] });
        }
        this.selfModel.stability = Math.min(1, this.selfModel.stability + 0.01);
        this._saveSelfModel();
    }

    async _savePersonality() { await saveJSON(FILES.personality, this.personality); }
    async _saveMood() { await saveJSON(FILES.mood, this.mood); }
    async _saveSelfModel() { await saveJSON(FILES.self_model, this.selfModel); }
}

// ================================================================
//  3. ПАМЯТЬ (упрощённая, но с интеграцией убеждений)
// ================================================================
class Memory {
    constructor() {
        this.atoms = [];
        this.episodes = [];
        this.predictions = [];
        this.userModel = {};
        this.worldFacts = [];
        this.causalLinks = [];
    }
    async init() {
        this.atoms = await loadJSON(FILES.atoms, []);
        this.episodes = await loadJSON(FILES.episodes, []);
        this.predictions = await loadJSON(FILES.predictions, []);
        this.userModel = await loadJSON(FILES.user_model, { style: {} });
        this.worldFacts = await loadJSON(FILES.world_facts, []);
        this.causalLinks = await loadJSON(FILES.causal_links, []);
    }
    addAtom(type, domain, prop, val, conf=0.5, src='inferred') {
        const atom = { id: crypto.randomUUID(), type, domain, prop, val, conf, src, created: Date.now() };
        this.atoms.push(atom);
        this._saveAtoms();
        return atom;
    }
    addEpisode(topic) {
        const ep = { id: crypto.randomUUID(), topic, steps: [], closed: false, timestamp: Date.now() };
        this.episodes.push(ep);
        if (this.episodes.length > CONFIG.MAX_EPISODES) this.episodes = this.episodes.slice(-CONFIG.MAX_EPISODES);
        return ep;
    }
    getRelevantEpisodes(context, n=5) {
        const words = context.toLowerCase().split(/\s+/);
        return this.episodes.filter(e => e.topic && words.some(w => e.topic.includes(w))).slice(-n);
    }
    addPrediction(context, expected, confidence, linkedBeliefId) {
        const pred = { id: crypto.randomUUID(), context, expected, confidence, actual: null, error: null, resolved: false, linkedBeliefId, timestamp: Date.now() };
        this.predictions.push(pred);
        this._savePredictions();
        return pred;
    }
    resolvePrediction(id, actual) {
        const pred = this.predictions.find(p => p.id === id);
        if (pred) {
            pred.actual = actual; pred.error = Math.abs(pred.expected - actual); pred.resolved = true;
            this._savePredictions();
        }
    }
    async _saveAtoms() { await saveJSON(FILES.atoms, this.atoms); }
    async _saveEpisodes() { await saveJSON(FILES.episodes, this.episodes); }
    async _savePredictions() { await saveJSON(FILES.predictions, this.predictions); }
}

// ================================================================
//  4. BELIEF ENGINE (убеждения с доказательствами, интеграция с Error Engine)
// ================================================================
class BeliefEngine {
    constructor() { this.beliefs = []; }
    async init() { this.beliefs = await loadJSON(FILES.beliefs, []); }
    getBelief(id) { return this.beliefs.find(b => b.id === id); }
    addBelief(statement, domain, confidence, evidence=[]) {
        const b = { id: crypto.randomUUID(), statement, domain, confidence, evidence, contradictions: [], created: Date.now() };
        this.beliefs.push(b);
        this._save();
        return b;
    }
    updateBelief(id, newConfidence, evidenceItem) {
        const b = this.getBelief(id);
        if (b) {
            b.confidence = Math.max(0, Math.min(1, newConfidence));
            b.evidence.push(evidenceItem);
            b.updated = Date.now();
            this._save();
        }
    }
    addContradiction(id, evidence) {
        const b = this.getBelief(id);
        if (b) {
            b.contradictions.push(evidence);
            b.confidence = Math.max(0.1, b.confidence - 0.05);
            this._save();
        }
    }
    async _save() { await saveJSON(FILES.beliefs, this.beliefs); }
}

// ================================================================
//  5. ERROR ENGINE (атрибуция ошибок и точечное обновление)
// ================================================================
class ErrorEngine {
    constructor(memory, beliefs, identity) {
        this.memory = memory;
        this.beliefs = beliefs;
        this.identity = identity;
        this.log = [];
    }
    async init() { this.log = await loadJSON(FILES.error_log, []); }

    // Основной метод: получает предсказание, результат, контекст и связанные убеждения
    processPredictionError(prediction, actualScore, context, linkedBeliefId) {
        const error = prediction.error; // уже вычислено
        // 1. Атрибуция: если есть связанное убеждение, обновляем его
        if (linkedBeliefId) {
            const belief = this.beliefs.getBelief(linkedBeliefId);
            if (belief) {
                const update = belief.confidence + (0.5 - error) * CONFIG.BELIEF_UPDATE_RATE;
                this.beliefs.updateBelief(linkedBeliefId, update, { context, error, timestamp: Date.now() });
            }
        }
        // 2. Влияние на личность: большие ошибки снижают confidence, маленькие повышают
        if (error > 0.5) {
            this.identity.adjustPersonality('confidence', -0.01, `prediction error ${error.toFixed(2)}`);
            this.identity.adjustMood('frustration', 0.1);
        } else {
            this.identity.adjustPersonality('confidence', 0.005, 'successful prediction');
            this.identity.adjustMood('engagement', 0.05);
        }
        // 3. Если ошибка очень большая и повторяется, добавляем слепую зону
        if (error > 0.6) {
            this.identity.addSelfBelief(`Я плохо предсказываю в контексте: ${context}`, 0.4, { error, timestamp: Date.now() });
        }
        // Логирование
        this.log.push({ predictionId: prediction.id, error, context, timestamp: Date.now() });
        this._saveLog();
    }

    async _saveLog() { await saveJSON(FILES.error_log, this.log); }
}

// ================================================================
//  6. КОГНИТИВНОЕ ЯДРО (внутреннее состояние, не текст)
// ================================================================
class Cognition {
    constructor(identity, memory, beliefs, errorEngine) {
        this.identity = identity;
        this.memory = memory;
        this.beliefs = beliefs;
        this.errorEngine = errorEngine;
        this.internalState = {};
    }

    // Формирует внутреннее состояние на основе контекста (без LLM)
    assessSituation(userMessage, history) {
        const words = userMessage.toLowerCase();
        const activeTraits = Object.entries(this.identity.personality).filter(([_,v]) => v > 0.6).map(([k]) => k);
        const mood = this.identity.mood;
        const uncertainty = words.includes('?') ? 0.7 : 0.3;
        const recentEpisodes = this.memory.getRelevantEpisodes(userMessage, 3);

        // Конфликты ценностей (упрощённо)
        const conflicts = [];
        if (activeTraits.includes('precision') && activeTraits.includes('empathy') && uncertainty > 0.5) {
            conflicts.push('precision_vs_empathy');
        }

        this.internalState = {
            uncertainty,
            activeTraits,
            mood,
            conflicts,
            relevantEpisodes: recentEpisodes.length
        };
        return this.internalState;
    }

    // Выбор действия на основе внутреннего состояния (без LLM)
    decideAction() {
        const { uncertainty, mood, conflicts } = this.internalState;
        // Влияние настроения
        let weights = { ask: 0.5, reflect: 0.5, respond: 0.5, act: 0.5 };
        if (mood.frustration > 0.4) { weights.ask += 0.2; weights.act -= 0.2; }
        if (mood.engagement > 0.7) { weights.reflect += 0.2; }
        // Влияние uncertainty
        weights.ask += uncertainty * 0.2;
        // Влияние конфликтов
        if (conflicts.includes('precision_vs_empathy')) { weights.reflect += 0.15; }
        // Нормализация
        const max = Math.max(...Object.values(weights));
        for (let k in weights) weights[k] /= max;
        const action = Object.entries(weights).sort((a,b) => b[1] - a[1])[0][0];
        return { action, confidence: weights[action] };
    }

    // Создание предсказания и связывание с убеждением (если релевантно)
    makePrediction(action, context) {
        // Найдём релевантное убеждение, которое может предсказать исход
        const beliefs = this.beliefs.beliefs.filter(b => b.domain === 'user_preference' && context.includes(b.statement.split(' ')[0]));
        const linkedBelief = beliefs.length > 0 ? beliefs[0] : null;
        const expectedScore = 0.6; // базовая оценка успеха действия (можно улучшить)
        const pred = this.memory.addPrediction(context, expectedScore, 0.6, linkedBelief?.id);
        return pred;
    }
}

