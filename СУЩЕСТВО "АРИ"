function updateWeights(weights, action, score) {
    const lr = 0.1;
    const penalty = 0.05;

    // Усиливаем выбранное действие
    weights[action] += lr * (score - 0.5);

    // Ослабляем остальные (конкуренция)
    for (let a in weights) {
        if (a !== action) {
            weights[a] -= lr * (score - 0.5) * penalty;
        }
    }

    // Нормализация (сумма = 1)
    const sum = Object.values(weights).reduce((a,b) => a + b, 0);
    for (let a in weights) {
        weights[a] = weights[a] / sum;
        // Ограничиваем, чтобы не уйти в ноль
        weights[a] = Math.max(0.1, Math.min(0.9, weights[a]));
    }

    return weights;
}
