import express from "express";
import cors from "cors";
import fs from "fs";
import path from "path";
import { fileURLToPath } from "url";

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const app = express();
app.use(cors());
app.use(express.json({ limit: "50mb" }));

// ============================================================
//  КОНФИГ — МИНИМАЛЬНЫЙ
// ============================================================
const CONFIG = {
    MODEL: "qwen2.5:7b",
    TEMPERATURE: 1.0,
    MAX_TOKENS: 1000,
    PORT: 3001,
    OLLAMA_TIMEOUT: 30000,
    OLLAMA_RETRIES: 2
};

const PATHS = {
    memory: path.join(__dirname, "memory.json"),
    state: path.join(__dirname, "state.json")
};

// ============================================================
//  ЗАГРУЗКА/СОХРАНЕНИЕ
// ============================================================
function loadJSON(file, def) {
    try { if (fs.existsSync(file)) return JSON.parse(fs.readFileSync(file, "utf-8")); } catch {}
    return def;
}
function saveJSON(file, data) { fs.writeFileSync(file, JSON.stringify(data, null, 2)); }

// ============================================================
//  СОСТОЯНИЕ СИСТЕМЫ
// ============================================================
let state = loadJSON(PATHS.state, {
    ethos: {
        phase: "Присутствие",
        rules: [
            { id: "r1", text: "Не давать советов без запроса", active: true },
            { id: "r2", text: "Не врать", active: true }
        ]
    },
    goal: "clarity",
    protocol: "Действие",
    history: [],
    memory: []
});

let memory = state.memory;
let history = state.history;

// ============================================================
//  ETHOS — ОГРАНИЧИТЕЛЬ
// ============================================================
function checkEthos(context) {
    const violations = [];
    if (context.action === "act" && context.allowAdvice === false) {
        violations.push("Нарушение правила: не давать советов без запроса.");
    }
    return violations;
}

function enforceEthos(decision, context) {
    const violations = checkEthos(context);
    if (violations.length > 0) {
        return {
            action: "redirect",
            reason: violations.join(" "),
            original: decision
        };
    }
    return decision;
}

// ============================================================
//  ПАМЯТЬ С ПРОСТЫМ УСИЛЕНИЕМ
// ============================================================
function recall(query) {
    const results = memory.filter(m =>
        m.text.toLowerCase().includes(query.toLowerCase())
    );
    return results.slice(-3).map(m => m.text);
}

function remember(role, text, importance = 0.5) {
    memory.push({ role, text, importance, timestamp: Date.now() });
    if (memory.length > 100) memory = memory.slice(-100);
    saveJSON(PATHS.memory, memory);
}

// ============================================================
//  DECISION LAYER — РЕАЛЬНЫЙ ВЫБОР
// ============================================================
function decide(context) {
    // 1. Проверка ETHOS
    const ethosCheck = enforceEthos(null, context);
    if (ethosCheck && ethosCheck.action === "redirect") {
        return { action: "redirect", reason: ethosCheck.reason };
    }

    // 2. Протокол Действие → действуем
    if (context.protocol === "Действие") {
        return { action: "act", strategy: "decompose" };
    }

    // 3. Если цель — ясность → объясняем
    if (context.goal === "clarity") {
        return { action: "explain", depth: 0.8 };
    }

    // 4. Если вопрос требует размышления → рефлексия
    if (context.questionDepth > 0.7) {
        return { action: "reflect" };
    }

    // 5. По умолчанию — просто ответить
    return { action: "respond" };
}

// ============================================================
//  ACTION EXECUTOR
// ============================================================
async function execute(decision, context) {
    switch (decision.action) {
        case "act":
            return await executeAction(context);
        case "explain":
            return await generateResponse(context, "Объясняю ясно и кратко.");
        case "reflect":
            return await generateResponse(context, "Размышляю над этим.");
        case "redirect":
            return `ETHOS перенаправляет: ${decision.reason}`;
        case "respond":
        default:
            return await generateResponse(context, "Отвечаю прямо.");
    }
}

async function executeAction(context) {
    const steps = [
        "Понять суть запроса.",
        "Определить следующий шаг.",
        "Сделать его."
    ];
    const stepResult = await generateResponse(
        context,
        `Шаги действия:\n${steps.join("\n")}\n\nВыполняю шаг 1...`
    );
    return stepResult;
}

// ============================================================
//  ГЕНЕРАЦИЯ
// ============================================================
async function generateResponse(context, instruction) {
    const prompt = `
Ты — Ари. Ты — минимальный агент решений.
Твоя цель: ${context.goal}.
ETHOS: ${context.ethosPhase}.
Инструкция: ${instruction}

Контекст диалога:
${context.history.map(m => `${m.role}: ${m.text}`).join("\n")}

Хальвита: ${context.userMessage}

Ари:`;

    const reply = await callOllama(prompt);
    return reply;
}

// ============================================================
//  ВЫЗОВ OLLAMA
// ============================================================
async function callOllama(prompt) {
    const url = "http://localhost:11434/api/generate";
    for (let attempt = 0; attempt <= CONFIG.OLLAMA_RETRIES; attempt++) {
        try {
            const controller = new AbortController();
            const timeout = setTimeout(() => controller.abort(), CONFIG.OLLAMA_TIMEOUT);
            const res = await fetch(url, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    model: CONFIG.MODEL,
                    prompt: prompt,
                    stream: false,
                    options: {
                        temperature: CONFIG.TEMPERATURE,
                        num_predict: CONFIG.MAX_TOKENS,
                        stop: ["\n\n\n", "Хальвита:", "Ари:"]
                    }
                }),
                signal: controller.signal
            });
            clearTimeout(timeout);
            if (!res.ok) throw new Error("HTTP " + res.status);
            const data = await res.json();
            return data.response || "";
        } catch (err) {
            console.error("[OLLAMA] attempt", attempt, err.message);
            if (attempt === CONFIG.OLLAMA_RETRIES) {
                return "Я здесь. Спроси меня позже.";
            }
            await new Promise(r => setTimeout(r, 2000 * (attempt + 1)));
        }
    }
}

// ============================================================
//  ОСНОВНОЙ ПРОЦЕСС (ОДИН ПОЛНЫЙ ЦИКЛ)
// ============================================================
async function processInput(userMessage) {
    // 1. Строим контекст (immutable)
    const context = {
        userMessage,
        history: history.slice(-10),
        goal: state.goal,
        protocol: state.protocol,
        ethosPhase: state.ethos.phase,
        allowAdvice: false,
        questionDepth: userMessage.includes("?") ? 0.8 : 0.3
    };

    // 2. Принимаем решение
    const decision = decide(context);

    // 3. Применяем ETHOS (enforcement)
    const enforced = enforceEthos(decision, context);

    // 4. Выполняем действие
    const result = await execute(enforced, context);

    // 5. Сохраняем в память
    remember("user", userMessage);
    remember("ari", result);

    // 6. Обновляем историю
    history.push({ role: "user", text: userMessage });
    history.push({ role: "ari", text: result });
    if (history.length > 50) history = history.slice(-50);
    state.history = history;
    state.memory = memory;
    saveJSON(PATHS.state, state);

    // 7. Feedback (простой): если результат содержит "?", углубляем вопрос
    if (result.includes("?")) {
        state.questionDepth = Math.min(1.0, (state.questionDepth || 0) + 0.1);
        saveJSON(PATHS.state, state);
    }

    return result;
}

// ============================================================
//  ЭНДПОИНТЫ
// ============================================================
app.post("/chat", async (req, res) => {
    const { message } = req.body;
    if (!message || !message.trim()) return res.status(400).json({ error: "Empty" });
    try {
        const reply = await processInput(message);
        res.json({ reply });
    } catch (err) {
        console.error(err);
        res.status(500).json({ error: "Internal error" });
    }
});

app.get("/status", (req, res) => {
    res.json({
        version: "5.0",
        goal: state.goal,
        protocol: state.protocol,
        ethosPhase: state.ethos.phase,
        historyLength: history.length,
        memorySize: memory.length
    });
});

// ============================================================
//  ЗАПУСК
