class InternalDialog {
    constructor(identity, memory, beliefs) {
        this.identity = identity;
        this.memory = memory;
        this.beliefs = beliefs;
        this.timer = null;
        this.interval = 60000; // каждую минуту
    }
    start() {
        this.timer = setInterval(async () => {
            // Генерируем случайный внутренний вопрос на основе незавершённого
            const unfinished = this.memory.unfinished.filter(u => !u.resolved);
            let question = "Что я сейчас чувствую?";
            if (unfinished.length > 0) {
                const q = unfinished[Math.floor(Math.random() * unfinished.length)];
                question = `Почему я не завершил "${q.text}"?`;
            }
            // Формируем промпт для внутреннего диалога
            const prompt = `Ты — Ари. Проведи внутренний диалог с собой. Ответь на вопрос: "${question}". Будь честен и рефлексивен. Ответ:`;
            try {
                const response = await this._callOllama(prompt);
                if (response) {
                    const thought = response.trim().slice(0, 200);
                    this.identity.addSelfBelief(`Внутренняя мысль: ${thought}`, 0.4, { thought }, "internal_dialog");
                    this.memory.addUnfinished(thought, "internal");
                    console.log(`[INTERNAL] ${thought}`);
                }
            } catch (e) {}
        }, this.interval);
    }
    stop() { if (this.timer) clearInterval(this.timer); }
    async _callOllama(prompt) {
        // аналогично expression, но с другим temperature
        const url = "http://localhost:11434/api/generate";
        try {
            const controller = new AbortController();
            const timeout = setTimeout(() => controller.abort(), 20000);
            const res = await fetch(url, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    model: CONFIG.MODEL,
                    prompt: prompt,
                    stream: false,
                    options: { temperature: 0.9, num_predict: 300 }
                }),
                signal: controller.signal
            });
            clearTimeout(timeout);
            if (!res.ok) throw new Error(`HTTP ${res.status}`);
            const data = await res.json();
            return data.response || "";
        } catch { return ""; }
    }
}

