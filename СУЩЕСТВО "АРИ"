function checkDilemmas(context) {
    const state = getSelfState();
    const dilemmas = [];
    // Пример: глубина vs краткость
    const depthPref = cognitiveAtoms.find(a => a.property === 'depth' && a.value === 'high');
    const brevityPref = cognitiveAtoms.find(a => a.property === 'brevity' && a.value === 'high');
    if (depthPref && brevityPref) {
        dilemmas.push({
            type: 'depth_vs_brevity',
            tension: (depthPref.confidence + brevityPref.confidence) / 2,
            message: 'Хочу глубины и краткости одновременно. Решение: краткий, но глубокий ответ.'
        });
    }
    return dilemmas;
}

function computeCuriosity(context) {
    const state = getSelfState();
    const curiosity = state.emotional_spectrum.curiosity || 0.5;
    const unfinishedCount = getActiveUnfinished().length;
    // Если есть незавершённые вопросы и любопытство высоко, сгенерировать вопрос
    if (curiosity > 0.6 && unfinishedCount > 0 && Math.random() < 0.2) {
        return getActiveUnfinished()[0].text;
    }
    return null;
}

