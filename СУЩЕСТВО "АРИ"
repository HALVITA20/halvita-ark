// 3.1. Когнитивные атомы (вместо убеждений)
let cognitiveAtoms = loadJSON(PATHS_FILES.cognitive_atoms, []);

function createAtom(type, domain, property, value, confidence = 0.5, source = 'inferred', evidence = []) {
    return {
        id: crypto.randomUUID(),
        type: type, // preference, habit, goal, fact, constraint, hypothesis
        domain: domain,
        property: property,
        value: value,
        confidence: Math.max(0, Math.min(1, confidence)),
        doubt: 0.2,
        source: source,
        evidence: evidence.slice(0, CONFIG.MAX_EVIDENCE),
        created: Date.now(),
        lastConfirmed: Date.now(),
        status: 'active', // active, doubtful, frozen, deleted
        confirmations: 0
    };
}

function addAtom(raw) {
    const atom = createAtom(raw.type, raw.domain, raw.property, raw.value, raw.confidence, raw.source, raw.evidence);
    // Проверка дубликата
    const existing = cognitiveAtoms.find(a =>
        a.type === atom.type &&
        a.domain === atom.domain &&
        a.property === atom.property &&
        a.value === atom.value
    );
    if (existing && existing.status !== 'deleted') {
        existing.confidence = Math.min(1, existing.confidence + 0.05);
        existing.confirmations += 1;
        existing.lastConfirmed = Date.now();
        existing.doubt = Math.max(0, existing.doubt - 0.02);
        saveJSON(PATHS_FILES.cognitive_atoms, cognitiveAtoms);
        return existing;
    }
    cognitiveAtoms.push(atom);
    if (cognitiveAtoms.length > CONFIG.BELIEF_LIMIT) {
        cognitiveAtoms = cognitiveAtoms
            .filter(a => a.status !== 'deleted')
            .sort((a, b) => b.confidence - a.confidence)
            .slice(0, CONFIG.BELIEF_LIMIT);
    }
    saveJSON(PATHS_FILES.cognitive_atoms, cognitiveAtoms);
    return atom;
}

function getRelevantAtoms(context, limit = 10) {
    const words = (context.userMessage || '').toLowerCase().split(/\s+/);
    const candidates = cognitiveAtoms
        .filter(a => a.status !== 'deleted' && a.status !== 'frozen')
        .map(a => {
            const topicMatch = a.domain === 'user_style' || a.domain === 'project_context';
            const keywordMatch = words.some(w => w.includes(a.property) || a.property.includes(w));
            const ageDays = (Date.now() - a.lastConfirmed) / (1000 * 60 * 60 * 24);
            const decay = Math.exp(-ageDays / CONFIG.DECAY_DAYS);
            const effConf = a.confidence * decay * (1 - a.doubt * 0.3);
            return { ...a, effectiveConfidence: effConf, keywordMatch };
        })
        .sort((a, b) => b.effectiveConfidence - a.effectiveConfidence)
        .slice(0, limit);
    return candidates;
}

function forgetAtom(id) {
    const atom = cognitiveAtoms.find(a => a.id === id);
    if (atom) {
        atom.status = 'deleted';
        saveJSON(PATHS_FILES.cognitive_atoms, cognitiveAtoms);
    }
}

// 3.2. Эпизодическая память
let episodes = loadJSON(PATHS_FILES.episodic, []);
let currentEpisode = null;

function startEpisode(topic, goal) {
    currentEpisode = {
        id: crypto.randomUUID(),
        topic,
        goal,
        steps: [],
        decisions: [],
        outcomes: [],
        lessons: [],
        timestamp: Date.now(),
        closed: false
    };
}

function addEpisodeStep(action, input, output, score, context) {
    if (currentEpisode && !currentEpisode.closed) {
        currentEpisode.steps.push({
            action,
            input,
            output,
            score,
            context: context.userMessage || '',
            timestamp: Date.now()
        });
        currentEpisode.decisions.push(action);
        currentEpisode.outcomes.push(score);
    }
}

function closeEpisode() {
    if (currentEpisode && !currentEpisode.closed) {
        currentEpisode.closed = true;
        const avgScore = currentEpisode.outcomes.reduce((a,b) => a+b, 0) / currentEpisode.outcomes.length;
        if (avgScore < 0.4) {
            currentEpisode.lessons.push('Стратегия была неэффективной, нужно изменить подход.');
        } else if (avgScore > 0.7) {
            currentEpisode.lessons.push('Текущая стратегия работает, стоит её закрепить.');
        }
        episodes.push(currentEpisode);
        if (episodes.length > 50) episodes = episodes.slice(-50);
        saveJSON(PATHS_FILES.episodic, episodes);
        currentEpisode = null;
    }
}

function getRelevantEpisodes(topic) {
    return episodes.filter(e => e.topic.includes(topic) || topic.includes(e.topic)).slice(-3);
}

// 3.3. Предсказательная память
let predictions = loadJSON(PATHS_FILES.predictions, []);
let lessons = loadJSON(PATHS_FILES.lessons, []);

function addPrediction(context, expectedOutcome, confidence, action) {
    predictions.push({
        id: crypto.randomUUID(),
        context: { userMessage: context.userMessage, topic: context.topic || 'general' },
        expectedOutcome,
        confidence,
        action,
        actualOutcome: null,
        error: null,
        timestamp: Date.now(),
        resolved: false
    });
    if (predictions.length > 200) predictions = predictions.slice(-200);
    saveJSON(PATHS_FILES.predictions, predictions);
}

function resolvePrediction(actualOutcome, context) {
    const last = predictions.filter(p => !p.resolved).pop();
    if (last) {
        last.actualOutcome = actualOutcome;
        last.error = Math.abs(last.confidence - actualOutcome);
        last.resolved = true;
        if (last.error > 0.3) {
            // Создаём урок
            lessons.push({
                id: crypto.randomUUID(),
                type: 'prediction_error',
                context: last.context,
                expected: last.expectedOutcome,
                actual: last.actualOutcome,
                error: last.error,
                lesson: `В контексте ${last.context.topic} моя уверенность была ${last.confidence.toFixed(2)}, а результат — ${last.actualOutcome.toFixed(2)}. Нужно пересмотреть гипотезы.`,
                confidence: 0.6,
                created: Date.now(),
                applied: false
            });
            if (lessons.length > 100) lessons = lessons.slice(-100);
            saveJSON(PATHS_FILES.lessons, lessons);
        }
        saveJSON(PATHS_FILES.predictions, predictions);
    }
}

function getRelevantLessons(context) {
    const words = (context.userMessage || '').toLowerCase().split(/\s+/);
    return lessons
        .filter(l => !l.applied)
        .map(l => {
            const match = words.some(w => l.context.topic.includes(w) || w.includes(l.context.topic));
            return { ...l, relevance: match ? 0.8 : 0.1 };
        })
        .sort((a, b) => b.relevance - a.relevance)
        .slice(0, 3);
}

function markLessonApplied(id) {
    const l = lessons.find(l => l.id === id);
    if (l) l.applied = true;
    saveJSON(PATHS_FILES.lessons, lessons);
}

// 3.4. Незавершённое (unfinished)
let unfinished = loadJSON(PATHS_FILES.unfinished, []);

function addUnfinished(question, context = '') {
