        const ageDays = (now - belief.lastConfirmed) / (1000 * 60 * 60 * 24);
        if (ageDays > 60) {
            belief.confidence *= 0.95;
        }

        // Если уверенность падает ниже 0.3, помечаем как doubtful
        if (belief.confidence < 0.3 && belief.status === 'active') {
            belief.status = 'doubtful';
            changed = true;
        }

        // Если не подтверждалось > 180 дней и статус doubtful → удаляем
        if (ageDays > 180 && belief.status === 'doubtful') {
            belief.status = 'deleted';
            changed = true;
        }

        // Если уверенность выше 0.8 и статус doubtful → возвращаем в active
        if (belief.confidence > 0.8 && belief.status === 'doubtful') {
            belief.status = 'active';
            changed = true;
        }
    }

    if (changed) {
        // Сохраняем состояние
        saveJSON(PATHS.state, { ...state, beliefs: beliefMemory.beliefs, conflicts: beliefMemory.conflicts });
    }

    return changed;
}
