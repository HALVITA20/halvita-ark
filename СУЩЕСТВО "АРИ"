// В функции decide

const beliefs = beliefMemory.getRelevant(context);

for (const belief of beliefs) {
    const age = (Date.now() - belief.lastConfirmed) / (1000 * 60 * 60 * 24);
    const freshness = Math.exp(-age / 90);
    const impact = belief.confidence * freshness * 0.2;

    if (belief.type === 'preference') {
        if (belief.content.includes('план') || belief.content.includes('структура')) {
            scores.act += impact;
        }
        if (belief.content.includes('вопрос') || belief.content.includes('уточнение')) {
            scores.ask += impact;
        }
        if (belief.content.includes('глубок') || belief.content.includes('философия')) {
            scores.reflect += impact;
        }
        if (belief.content.includes('кратко') || belief.content.includes('ясно')) {
            scores.respond += impact;
        }
    }

    if (belief.type === 'avoidance') {
        if (belief.content.includes('поверхностно')) {
            scores.respond -= impact;
            scores.reflect += impact * 0.5;
        }
        if (belief.content.includes('теория')) {
            scores.reflect -= impact;
            scores.act += impact * 0.5;
        }
    }
}
