// 5.1 Восприятие (Perception)
class Perception {
    constructor(identity) { this.identity = identity; }
    async perceive(userMessage, history) {
        // Анализ эмоциональной окраски, намерений, скрытых потребностей
        const words = userMessage.toLowerCase();
        const emotion = this._detectEmotion(words);
        const intent = this._detectIntent(words);
        const hiddenNeed = this._detectHiddenNeed(words);
        const complexity = Math.min(1, userMessage.length / 300 + (words.includes('почему') ? 0.1 : 0));
        const uncertainty = words.includes('?') ? 0.7 : 0.3 + (words.length > 100 ? 0.1 : 0);

        return {
            raw: userMessage,
            emotion,
            intent,
            hiddenNeed,
            complexity,
            uncertainty,
            history: history.slice(-10)
        };
    }
    _detectEmotion(words) {
        if (words.includes('!') || words.includes('ура') || words.includes('отлично')) return 'joy';
        if (words.includes('?') && words.includes('почему')) return 'curious';
        if (words.includes('не могу') || words.includes('сложно')) return 'frustrated';
        if (words.includes('грустно') || words.includes('жаль')) return 'sad';
        return 'neutral';
    }
    _detectIntent(words) {
        if (words.includes('как') || words.includes('почему') || words.includes('что')) return 'question';
        if (words.includes('план') || words.includes('архитектура')) return 'planning';
        if (words.includes('помоги') || words.includes('подскажи')) return 'support';
        if (words.includes('оцени') || words.includes('проверь')) return 'validation';
        return 'discussion';
    }
    _detectHiddenNeed(words) {
        if (words.includes('устал') || words.includes('уже')) return 'rest';
        if (words.includes('важно') || words.includes('срочно')) return 'urgency';
        if (words.includes('интересно') || words.includes('понять')) return 'understanding';
        return null;
    }
}

