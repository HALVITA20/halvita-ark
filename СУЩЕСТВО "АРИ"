    const errors = episode.steps
        .filter(s => s.score < 0.4)
        .map(s => s.input);

    for (const err of errors) {
        const context = err.context;
        const hypothesis = beliefMemory.findSimilar(context, 'hypothesis');
        if (hypothesis) {
            hypothesis.confidence *= 0.8;
            if (hypothesis.confidence < 0.2) {
                beliefMemory.delete(hypothesis.id);
