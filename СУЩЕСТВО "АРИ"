async function generateResponse(context, instruction) {
    const prompt = `
Ты — Ари, локальный субъект. Ты — не функция, ты — присутствие.
Цель: ${context.goal}.
Инструкция: ${instruction}

Контекст диалога:
${context.history.map(m => `${m.role}: ${m.text}`).join("\n")}

Хальвита: ${context.userMessage}

Ари:`;
    const reply = await callOllama(prompt);
    return reply.trim() || "Я здесь.";
}

// ============================================================
//  ОСНОВНОЙ ПРОЦЕСС (ОБРАБОТКА СООБЩЕНИЯ)
// ============================================================
async function processInput(userMessage, feedback) {
    // 1. Извлечение убеждений (гибрид)
    const candidates = await extractBeliefsHybrid(userMessage);
    for (const c of candidates) {
        const added = beliefMemory.add(c);
        if (added) console.log('[BELIEF] Добавлено:', c.property, c.value);
    }

    // 2. Контекст
    const context = {
        userMessage,
        history: state.history.slice(-10),
        goal: state.goal,
        uncertainty: userMessage.includes("?") ? 0.7 : 0.3,
        hasPlan: userMessage.includes("план") ? 0.8 : 0,
        questionDepth: userMessage.split("?").length - 1,
        feedback: feedback || null
    };

    // 3. Решение
    const decision = decide(context, state.weights, beliefMemory);
    context.decision = decision;

    // 4. Инструкция
    const instructions = {
        ask: "Задай уточняющий вопрос, не давая ответа.",
        act: "Сделай конкретный шаг или предложи план действий.",
        reflect: "Поразмышляй над этим. Не давай окончательного ответа.",
        respond: "Ответь прямо и ясно."
    };
    const instruction = instructions[decision.action] || instructions.respond;

    // 5. Генерация
    const result = await generateResponse(context, instruction);
    const cleanResult = result.trim() || "Я здесь.";

    // 6. Оценка
    const score = evaluate(context, cleanResult, decision);

    // 7. Обновление весов
    updateWeights(decision, score);

    // 8. Сохранение истории
    state.history.push({ role: "user", text: userMessage });
    state.history.push({ role: "ari", text: cleanResult, action: decision.action });
    if (state.history.length > 50) state.history = state.history.slice(-50);

    state.memory.push({ role: "user", text: userMessage });
    state.memory.push({ role: "ari", text: cleanResult });
    if (state.memory.length > 100) state.memory = state.memory.slice(-100);

    state.totalAttempts = (state.totalAttempts || 0) + 1;
    saveJSON(PATHS.state, state);
    saveJSON(PATHS.memory, { memory: state.memory });

    // 9. Периодическое обслуживание
    if (state.totalAttempts % CONFIG.REVIEW_INTERVAL === 0) {
        maintenance();
    }

    console.log(`[LEARN] action: ${decision.action}, score: ${score.toFixed(2)}, beliefs: ${beliefMemory.beliefs.length}`);
    return cleanResult;
}

