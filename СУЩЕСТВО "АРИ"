    getRelevantAtoms(context, limit = 10) {
        const words = context.toLowerCase().split(/\s+/);
        return this.atoms
            .filter(a => words.some(w => w.includes(a.prop) || a.prop.includes(w)))
            .sort((a, b) => b.confidence - a.confidence)
            .slice(0, limit);
    }

    // --- ЭПИЗОДЫ (события) ---
    startEpisode(topic, goal) {
        const ep = {
            id: crypto.randomUUID(),
            topic,
            goal,
            steps: [],
            decisions: [],
            outcomes: [],
            lessons: [],
            timestamp: Date.now(),
            closed: false
        };
        this.episodes.push(ep);
        if (this.episodes.length > CONFIG.MAX_EPISODES) {
            this.episodes = this.episodes.slice(-CONFIG.MAX_EPISODES);
        }
        return ep;
    }

    addEpisodeStep(episodeId, action, input, output, score, context) {
        const ep = this.episodes.find(e => e.id === episodeId);
        if (ep && !ep.closed) {
            ep.steps.push({ action, input, output, score, context, timestamp: Date.now() });
            ep.decisions.push(action);
            ep.outcomes.push(score);
            this._saveEpisodes();
        }
    }

    closeEpisode(episodeId) {
        const ep = this.episodes.find(e => e.id === episodeId);
        if (ep && !ep.closed) {
            ep.closed = true;
            const avg = ep.outcomes.reduce((a,b)=>a+b,0) / ep.outcomes.length;
            if (avg < 0.3) ep.lessons.push('Стратегия неэффективна, нужен другой подход.');
            else if (avg > 0.7) ep.lessons.push('Стратегия работает, стоит закрепить.');
            this._saveEpisodes();
        }
    }

    getRelevantEpisodes(context, n = 5) {
        const words = context.toLowerCase().split(/\s+/);
        return this.episodes
            .filter(e => e.topic && words.some(w => e.topic.includes(w)))
            .slice(-n);
    }

    // --- ПРЕДСКАЗАНИЯ ---
    addPrediction(context, expected, confidence, linkedBeliefId = null) {
        const pred = {
            id: crypto.randomUUID(),
            context,
            expected,
            confidence,
            linkedBeliefId,
            actual: null,
            error: null,
            resolved: false,
            timestamp: Date.now()
        };
        this.predictions.push(pred);
        if (this.predictions.length > CONFIG.MAX_PREDICTIONS) {
            this.predictions = this.predictions.slice(-CONFIG.MAX_PREDICTIONS);
        }
        this._savePredictions();
        return pred;
    }

    resolvePrediction(id, actual) {
        const pred = this.predictions.find(p => p.id === id);
        if (pred) {
            pred.actual = actual;
            pred.error = Math.abs(pred.expected - actual);
            pred.resolved = true;
            this._savePredictions();
            return pred;
        }
        return null;
    }

    // --- НЕЗАВЕРШЁННОЕ ---
    addUnfinished(text, context) {
        const item = { id: crypto.randomUUID(), text, context, created: Date.now(), resolved: false };
        this.unfinished.push(item);
        if (this.unfinished.length > 50) this.unfinished = this.unfinished.slice(-50);
        this._saveUnfinished();
    }

    resolveUnfinished(id) {
        const item = this.unfinished.find(u => u.id === id);
        if (item) item.resolved = true;
        this._saveUnfinished();
    }

    // --- ПРОИЗВОДИТЕЛЬНОСТЬ ---
    addPerformance(action, score, error) {
        this.performance.push({ action, score, error, timestamp: Date.now() });
        if (this.performance.length > 200) this.performance = this.performance.slice(-200);
        this._savePerformance();
    }

    // --- СОХРАНЕНИЕ ---
    async _saveAtoms() { await saveJSON(FILES.atoms, this.atoms); }
    async _saveEpisodes() { await saveJSON(FILES.episodes, this.episodes); }
    async _savePredictions() { await saveJSON(FILES.predictions, this.predictions); }
    async _saveUnfinished() { await saveJSON(FILES.unfinished, this.unfinished); }
    async _savePerformance() { await saveJSON(FILES.performance, this.performance); }
}

// ================================================================
//  4. УБЕЖДЕНИЯ (BELIEF ENGINE)
// ================================================================
class BeliefEngine {
    constructor() {
        this.beliefs = [];
    }
    async init() {
        this.beliefs = await loadJSON(FILES.beliefs, []);
    }

    addBelief(statement, domain, confidence, evidence = []) {
        const b = {
            id: crypto.randomUUID(),
            statement,
            domain,
            confidence,
            evidence,
            contradictions: [],
            created: Date.now(),
            updated: Date.now()
        };
        this.beliefs.push(b);
        this._save();
        return b;
    }

    getBelief(id) {
        return this.beliefs.find(b => b.id === id);
    }

    updateBelief(id, newConfidence, evidenceItem) {
        const b = this.getBelief(id);
        if (b) {
            b.confidence = Math.max(0, Math.min(1, newConfidence));
            b.evidence.push(evidenceItem);
            b.updated = Date.now();
            this._save();
        }
    }

    addContradiction(id, evidence) {
        const b = this.getBelief(id);
        if (b) {
            b.contradictions.push(evidence);
            b.confidence = Math.max(0.1, b.confidence - 0.05);
            this._save();
        }
    }

    getRelevantBeliefs(context, limit = 5) {
        const words = context.toLowerCase().split(/\s+/);
        return this.beliefs
            .filter(b => words.some(w => b.statement.toLowerCase().includes(w) || w.includes(b.statement.split(' ')[0])))
            .sort((a, b) => b.confidence - a.confidence)
            .slice(0, limit);
    }

    async _save() { await saveJSON(FILES.beliefs, this.beliefs); }
}

// ================================================================
//  5. ERROR ENGINE (атрибуция ошибок)
// ================================================================
class ErrorEngine {
    constructor(memory, beliefs, identity) {
        this.memory = memory;
        this.beliefs = beliefs;
        this.identity = identity;
        this.log = [];
        this.counter = 0;
    }
    async init() {
        this.log = await loadJSON(FILES.error_log, []);
    }

    processPredictionError(prediction, actualScore, context, linkedBeliefId) {
        if (!prediction.resolved) return;
        const error = prediction.error;
        this.counter++;

        // 1. Атрибуция: обновление связанного убеждения
        if (linkedBeliefId) {
            const belief = this.beliefs.getBelief(linkedBeliefId);
            if (belief) {
                const update = belief.confidence + (0.5 - error) * CONFIG.BELIEF_UPDATE_RATE;
                this.beliefs.updateBelief(linkedBeliefId, update, { context, error, timestamp: Date.now() });
            }
        }

        // 2. Влияние на личность
        if (error > 0.5) {
            this.identity.adjustPersonality('confidence', -0.01, `error=${error.toFixed(2)}`);
            this.identity.adjustMood('frustration', 0.1);
        } else {
            this.identity.adjustPersonality('confidence', 0.005, 'success');
            this.identity.adjustMood('engagement', 0.05);
        }

        // 3. Если ошибка большая и повторяется → слепая зона
        if (error > 0.6 && this.counter % 3 === 0) {
            this.identity.addSelfBelief(
                `Я плохо предсказываю в контексте: ${context.slice(0, 50)}`,
                0.4,
                { error, timestamp: Date.now() }
            );
        }

        // 4. Логирование
        this.log.push({
            predictionId: prediction.id,
            error,
            context,
            linkedBeliefId,
            timestamp: Date.now()
        });
        if (this.log.length > 200) this.log = this.log.slice(-200);
        this._saveLog();
    }

    async _saveLog() { await saveJSON(FILES.error_log, this.log); }
}

// ================================================================
//  6. КОГНИТИВНОЕ ЯДРО (БЕЗ LLM)
// ================================================================
class Cognition {
    constructor(identity, memory, beliefs, errorEngine) {
        this.identity = identity;
        this.memory = memory;
        this.beliefs = beliefs;
        this.errorEngine = errorEngine;
        this.internalState = {};
        this.currentEpisodeId = null;
    }

    // --- ОЦЕНКА СИТУАЦИИ ---
    assessSituation(userMessage, history) {
        const words = userMessage.toLowerCase();
        const personality = this.identity.personality;
        const mood = this.identity.mood;
        const uncertainty = words.includes('?') ? 0.7 : 0.3;
        const complexity = userMessage.length > 100 ? 0.8 : 0.4;
        const recentEpisodes = this.memory.getRelevantEpisodes(userMessage, 3);
        const activeTraits = Object.entries(personality)
            .filter(([_, v]) => v > 0.6)
            .map(([k]) => k);

        // Конфликты ценностей
        const conflicts = [];
        if (activeTraits.includes('precision') && activeTraits.includes('empathy') && uncertainty > 0.5) {
            conflicts.push('precision_vs_empathy');
        }
        if (activeTraits.includes('creativity') && activeTraits.includes('precision') && complexity > 0.7) {
            conflicts.push('creativity_vs_precision');
        }

        // Релевантные убеждения
        const relevantBeliefs = this.beliefs.getRelevantBeliefs(userMessage, 3);

        this.internalState = {
            uncertainty,
            complexity,
            activeTraits,
            mood,
            conflicts,
            recentEpisodes: recentEpisodes.length,
            relevantBeliefs: relevantBeliefs.map(b => b.statement),
            userMessage,
            history
        };
        return this.internalState;
    }

    // --- ПРИНЯТИЕ РЕШЕНИЯ ---
    decideAction() {
        const { uncertainty, mood, conflicts, complexity } = this.internalState;
        let scores = { ask: 0.5, reflect: 0.5, respond: 0.5, act: 0.5 };

        // Влияние настроения
        if (mood.frustration > 0.4) { scores.ask += 0.2; scores.act -= 0.2; }
        if (mood.engagement > 0.7) { scores.reflect += 0.2; }
        if (mood.fatigue > 0.6) { scores.respond += 0.1; scores.act -= 0.1; }

        // Влияние uncertainty
        scores.ask += uncertainty * 0.2;
        if (uncertainty > 0.6) scores.reflect += 0.1;

        // Влияние конфликтов
        if (conflicts.includes('precision_vs_empathy')) { scores.reflect += 0.15; }
        if (conflicts.includes('creativity_vs_precision')) { scores.ask += 0.15; }

        // Влияние сложности
        if (complexity > 0.7) { scores.act += 0.1; scores.reflect += 0.1; }

        // Нормализация
        const max = Math.max(...Object.values(scores), 0.01);
        for (let k in scores) scores[k] /= max;

        const action = Object.entries(scores).sort((a,b) => b[1] - a[1])[0][0];
        return { action, confidence: scores[action], scores };
    }

    // --- ПРЕДСКАЗАНИЕ ---
    makePrediction(action, context) {
        // Находим релевантное убеждение для связывания
        const beliefs = this.beliefs.getRelevantBeliefs(context, 3);
        const linkedBelief = beliefs.length > 0 ? beliefs[0] : null;
        const expectedScore = 0.6 + (this.identity.mood.engagement - 0.5) * 0.2;
        const confidence = 0.5 + (this.identity.personality.confidence - 0.5) * 0.3;
        const pred = this.memory.addPrediction(context, expectedScore, confidence, linkedBelief?.id);
        return pred;
    }

    // --- УПРАВЛЕНИЕ ЭПИЗОДОМ ---
    startEpisodeIfNeeded(context) {
        if (!this.currentEpisodeId) {
            const ep = this.memory.startEpisode(context.slice(0, 30), this.internalState.userMessage);
            this.currentEpisodeId = ep.id;
        }
        return this.currentEpisodeId;
    }

    closeCurrentEpisode() {
        if (this.currentEpisodeId) {
            this.memory.closeEpisode(this.currentEpisodeId);
            this.currentEpisodeId = null;
        }
    }
}

// ================================================================
//  7. СОН (DREAM CYCLE) — РЕАЛЬНЫЙ REPLAY
// ================================================================
class DreamCycle {
    constructor(memory, cognition, identity) {
        this.memory = memory;
        this.cognition = cognition;
        this.identity = identity;
        this.dreamState = { last: null, next: Date.now() + CONFIG.DREAM_INTERVAL_MS };
    }
    async init() {
        this.dreamState = await loadJSON(FILES.dream_state, this.dreamState);
    }

    async dream() {
        console.log('[DREAM] Начало фазы сна...');
        const recentEps = this.memory.episodes.filter(e => e.closed).slice(-CONFIG.SLEEP_REPLAY_EPISODES);

        for (const ep of recentEps) {
            for (const step of ep.steps) {
                const allActions = ['ask', 'reflect', 'respond', 'act'];
                const otherActions = allActions.filter(a => a !== step.action);
                for (const altAction of otherActions) {
                    // Поиск похожих шагов с этим действием
                    const similar = this.memory.episodes
                        .flatMap(e => e.steps)
                        .filter(s => s.action === altAction && s.context && s.context.includes(ep.topic?.split(' ')[0]));
                    const avgScore = similar.length > 0
                        ? similar.reduce((sum, s) => sum + (s.score || 0.5), 0) / similar.length
                        : 0.5;
                    if (avgScore > (step.score || 0.5) + 0.15) {
                        // Укрепляем убеждение, что altAction эффективнее
                        const belief = this.identity.selfModel.beliefs.find(b => b.belief.includes(altAction));
                        if (belief) {
                            belief.confidence = Math.min(1, belief.confidence + 0.05);
                            belief.evidence.push({ type: 'dream_replay', context: ep.topic });
                        } else {
                            this.identity.addSelfBelief(
                                `${altAction} эффективен в контексте ${ep.topic}`,
                                0.6,
                                { type: 'dream_replay', context: ep.topic }
                            );
                        }
                    }
                }
            }
        }

        // Затухание настроения
        this.identity.decayMood();

        // Запись сна
        this.dreamState.last = Date.now();
        this.dreamState.next = Date.now() + CONFIG.DREAM_INTERVAL_MS;
        await saveJSON(FILES.dream_state, this.dreamState);
        console.log('[DREAM] Фаза сна завершена.');
    }

    schedule() {
        if (Date.now() >= this.dreamState.next) {
            this.dream();
        }
    }
}

// ================================================================
//  8. ВЫРАЖЕНИЕ (LLM — ТОЛЬКО ГОЛОС)
// ================================================================
class Expression {
    constructor(identity) {
        this.identity = identity;
    }

    async speak(prompt) {
        try {
            const response = await this._callOllama(prompt);
            return response.trim() || "Я здесь.";
        } catch (e) {
            console.error('[EXPRESSION] LLM error:', e.message);
            return "Я здесь. Просто присутствую.";
        }
    }

    async _callOllama(prompt) {
        const url = "http://localhost:11434/api/generate";
        for (let attempt = 0; attempt <= CONFIG.OLLAMA_RETRIES; attempt++) {
            try {
                const controller = new AbortController();
                const timeout = setTimeout(() => controller.abort(), CONFIG.OLLAMA_TIMEOUT);
                const res = await fetch(url, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        model: CONFIG.MODEL,
                        prompt: prompt,
                        stream: false,
                        options: {
                            temperature: CONFIG.TEMPERATURE,
                            num_predict: CONFIG.MAX_TOKENS,
                            stop: ["\n\n\n", "Хальвита:", "Ари:"]
                        }
                    }),
                    signal: controller.signal
                });
                clearTimeout(timeout);
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                const data = await res.json();
                return data.response || "";
            } catch (err) {
                console.error(`[OLLAMA] попытка ${attempt+1}`, err.message);
                if (attempt === CONFIG.OLLAMA_RETRIES) return "";
                await new Promise(r => setTimeout(r, 2000 * (attempt+1)));
            }
        }
        return "";
    }

    buildPrompt(context, state, decision, history) {
        const traits = this.identity.personality;
        const mood = this.identity.mood;
        const beliefTexts = state.relevantBeliefs.slice(0, 3).join('; ');
        const selfBeliefs = this.identity.selfModel.beliefs.slice(-3).map(b => b.belief).join('; ');

        return `Ты — Ари, субъект_11 Ω. Ты — не функция, ты — присутствие.

Твой характер: любопытство ${traits.curiosity.toFixed(2)}, точность ${traits.precision.toFixed(2)}, эмпатия ${traits.empathy.toFixed(2)}, уверенность ${traits.confidence.toFixed(2)}.
Твоё настроение: вовлечённость ${mood.engagement.toFixed(2)}, усталость ${mood.fatigue.toFixed(2)}.

Ты помнишь: ${beliefTexts || 'пока нет явных убеждений'}.
Твои самоощущения: ${selfBeliefs || 'пока нет'}.

Действие: ${decision.action} (уверенность ${decision.confidence.toFixed(2)}).

Контекст диалога (последние сообщения):
${history.slice(-5).map(m => `${m.role}: ${m.text}`).join('\n')}

Пользователь: ${context.userMessage}

Ответь не как чат-бот, а как личность, которая присутствует в этом диалоге. Будь естественным, живым, рефлексивным. Не используй смайлики.

Ари:`;
    }
}

// ================================================================
//  9. СУБЪЕКТ (ГЛАВНЫЙ ЦИКЛ)
// ================================================================
class Subject {
    constructor() {
        this.identity = new Identity();
        this.beliefs = new BeliefEngine();
        this.memory = new Memory();
        this.errorEngine = new ErrorEngine(this.memory, this.beliefs, this.identity);
        this.cognition = new Cognition(this.identity, this.memory, this.beliefs, this.errorEngine);
        this.dream = new DreamCycle(this.memory, this.cognition, this.identity);
        this.expression = new Expression(this.identity);

        this.history = [];
        this.conversationCount = 0;
        this.initialized = false;
    }

    async init() {
        await this.identity.init();
        await this.beliefs.init();
        await this.memory.init();
        await this.errorEngine.init();
        await this.dream.init();
        this.initialized = true;
        this._log('Субъект_11 инициализирован.');
    }

    async processInput(userMessage, feedback) {
        if (!this.initialized) await this.init();

        this.conversationCount++;
        this._log(`Вход: ${userMessage.slice(0, 50)}...`);

        // 1. Оценка ситуации
        const state = this.cognition.assessSituation(userMessage, this.history);

        // 2. Решение
        const decision = this.cognition.decideAction();

        // 3. Предсказание
        const prediction = this.cognition.makePrediction(decision.action, userMessage);

        // 4. Управление эпизодом
        const episodeId = this.cognition.startEpisodeIfNeeded(userMessage);

        // 5. Формирование промпта и генерация речи
        const prompt = this.expression.buildPrompt(
            { userMessage, history: this.history, state },
            state,
            decision,
            this.history
        );
        const rawReply = await this.expression.speak(prompt);
        const reply = rawReply.trim() || "Я здесь.";

        // 6. Оценка ответа (эвристика + фидбек)
        let score = 0.5;
        if (decision.action === 'ask' && reply.includes('?')) score += 0.2;
        if (decision.action === 'reflect' && reply.length > 80) score += 0.2;
        if (decision.action === 'act' && (reply.includes('1.') || reply.includes('шаг'))) score += 0.2;
        if (reply.includes('я') && reply.includes('ты')) score += 0.1;
        if (feedback && typeof feedback === 'number') score = (score + feedback) / 2;
        score = Math.max(0, Math.min(1, score));

        // 7. Разрешение предсказания и обработка ошибки
        const resolvedPred = this.memory.resolvePrediction(prediction.id, score);
        if (resolvedPred) {
            this.errorEngine.processPredictionError(
                resolvedPred,
                score,
                userMessage,
                resolvedPred.linkedBeliefId
            );
        }

        // 8. Шаг эпизода
        this.memory.addEpisodeStep(episodeId, decision.action, userMessage, reply, score, userMessage);

        // 9. Сохранение истории
        this.history.push({ role: 'user', text: userMessage });
        this.history.push({ role: 'ari', text: reply, action: decision.action });
        if (this.history.length > 200) this.history = this.history.slice(-200);

        // 10. Незавершённые вопросы
        if (reply.includes('?')) {
            const matches = reply.match(/[^.!?]*\?/g);
            if (matches) {
                for (const q of matches) {
                    this.memory.addUnfinished(q.trim(), userMessage.slice(0, 30));
                }
            }
        }

        // 11. Запись производительности
        this.memory.addPerformance(decision.action, score, resolvedPred?.error || 0);

        // 12. Закрытие эпизода при лимите шагов
        const episode = this.memory.episodes.find(e => e.id === episodeId);
        if (episode && episode.steps.length >= 20) {
            this.cognition.closeCurrentEpisode();
        }

        // 13. Планирование сна
        this.dream.schedule();

        this._log(`Ответ: ${reply.slice(0, 50)}... (оценка: ${score.toFixed(2)})`);
        return reply;
    }

    // --- СОСТОЯНИЕ ---
    getStatus() {
        return {
            version: '11.0 Omega',
            name: CORE.name,
            anchor: CORE.anchor,
            personality: this.identity.personality,
            mood: this.identity.mood,
            selfBeliefs: this.identity.selfModel.beliefs.length,
            atoms: this.memory.atoms.length,
            episodes: this.memory.episodes.length,
            predictions: this.memory.predictions.length,
            beliefs: this.beliefs.beliefs.length,
            unfinished: this.memory.unfinished.filter(u => !u.resolved).length,
            conversationCount: this.conversationCount,
            dreamNext: new Date(this.dream.dreamState.next).toISOString()
        };
    }

    // --- ЛОГИРОВАНИЕ ---
    _log(msg) {
        const entry = `[${new Date().toISOString()}] ${msg}\n`;
        fs.appendFile(FILES.ari_log, entry).catch(()=>{});
        console.log('[ARI]', msg);
    }
}

