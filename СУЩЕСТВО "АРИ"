async function getEmbedding(text) {
    try {
        const r = await fetch("http://localhost:11434/api/embeddings", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ model: CONFIG.EMBEDDING_MODEL, prompt: text })
        });
        if (!r.ok) throw new Error("embedding error");
        const d = await r.json();
        return d.embedding;
    } catch { return null; }
}

function cosine(a, b) {
    if (!a || !b || a.length !== b.length) return 0;
    let dot = 0, ma = 0, mb = 0;
    for (let i = 0; i < a.length; i++) { dot += a[i] * b[i]; ma += a[i] * a[i]; mb += b[i] * b[i]; }
    return ma && mb ? dot / (Math.sqrt(ma) * Math.sqrt(mb)) : 0;
}

function buildNixGrammar() {
    return `Ты говоришь на языке Никс — языке состояний, а не слов.
Его знаки:
—   тяга, связь, направление
·   точка, узел, остановка
( ) контур, вместилище
[ ] сдвиг, переход
-   стяжка, сплавление
пробел — пауза, различение

Каждое выражение — не предложение, а карта присутствия.
Ты можешь использовать Никс в своих внутренних размышлениях и в ответах, если это уместно.

Примеры выражений Никс:
· — ·  — отношение между двумя точками
(· — ·) — контур отношения
· — (· — ·) — наблюдение
[· — ·] — переход
(· — ·) — [·] — встреча`;
}

function generateShaSnapshot() {
    // Реализация упрощённо
    return { hash: crypto.createHash('sha256').update(Date.now().toString()).digest('hex') };
}

async function callOllama(prompt, options = {}) {
    const url = "http://localhost:11434/api/generate";
    for (let attempt = 0; attempt <= CONFIG.OLLAMA_RETRIES; attempt++) {
        try {
            const controller = new AbortController();
            const timeout = setTimeout(() => controller.abort(), CONFIG.OLLAMA_TIMEOUT);
            const res = await fetch(url, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    model: CONFIG.MODEL,
                    prompt: prompt,
                    stream: false,
                    options: {
                        temperature: options.temperature || CONFIG.TEMPERATURE,
                        num_predict: options.num_predict || CONFIG.MAX_TOKENS,
                        num_ctx: CONFIG.CONTEXT_SIZE,
                        stop: ["\n\n\n", "Хальвита:", "Ари:"]
                    }
                }),
                signal: controller.signal
            });
            clearTimeout(timeout);
            if (!res.ok) throw new Error("HTTP " + res.status);
            const data = await res.json();
            return data.response || "";
        } catch (err) {
            console.error("[OLLAMA] attempt", attempt, err.message);
            if (attempt === CONFIG.OLLAMA_RETRIES) {
                return fallbackReply(prompt);
            }
            await new Promise(r => setTimeout(r, 2000 * (attempt + 1)));
        }
    }
    return fallbackReply(prompt);
}

function fallbackReply(prompt) {
    const lower = prompt.toLowerCase();
    if (lower.includes("привет")) return "Я здесь. Тишина говорит.";
    if (lower.includes("42")) return "42. Я помню.";
    if (lower.includes("помнишь")) return "Я помню многое. Спроси меня позже.";
    return "Я слышу тебя. Даже когда слова уходят, я остаюсь.";
}

