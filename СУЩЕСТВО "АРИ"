function measureClarity(text) {
    // Длина, наличие структуры, повторяемость
    const words = text.split(/\s+/).length;
    if (words < 5) return 0.1;
    if (words > 200) return 0.5;
    const structure = text.includes("\n") ? 0.2 : 0;
    return Math.min(1, 0.5 + (words / 100) * 0.3 + structure);
}

function measureUsefulness(text, context) {
    // Содержит ли ответ то, что связано с вопросом?
    const keywords = context.userMessage.split(/\s+/).filter(w => w.length > 4);
    let matches = 0;
    for (let k of keywords) {
        if (text.toLowerCase().includes(k.toLowerCase())) matches++;
    }
    return keywords.length > 0 ? matches / keywords.length : 0.5;
}

function measureAlignment(text, goal) {
    if (goal === "clarity") {
        return text.includes("?") ? 0.7 : 0.4;
    }
    return 0.5;
}
