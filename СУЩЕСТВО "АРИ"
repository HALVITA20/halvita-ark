// ================================================================
//  9. SELF OVER TIME (модель себя во времени)
// ================================================================
class SelfOverTime {
    constructor(identity, memory) {
        this.identity = identity;
        this.memory = memory;
        this.snapshots = [];
        this.continuity = 1.0;
    }
    async init() {
        this.snapshots = await loadJSON(FILES.self_snapshots, []);
        this.continuity = await loadJSON(FILES.self_continuity, 1.0);
        this._log(`Загружено ${this.snapshots.length} снимков, непрерывность: ${this.continuity.toFixed(2)}`);
    }
    takeSnapshot(reason) {
        const snapshot = {
            timestamp: Date.now(),
            personality: { ...this.identity.personality },
            mood: { ...this.identity.mood },
            selfBeliefs: this.identity.selfModel.beliefs.map(b => ({ ...b })),
            strategies: this.memory.strategies.length,
            atoms: this.memory.atoms.length,
            reason: reason,
            continuity: this.continuity
        };
        this.snapshots.push(snapshot);
        if (this.snapshots.length > 50) this.snapshots = this.snapshots.slice(-50);
        this._saveSnapshots();
        // Обновляем непрерывность
        if (this.snapshots.length > 2) {
            const prev = this.snapshots[this.snapshots.length-2];
            const curr = this.snapshots[this.snapshots.length-1];
            const delta = this._computeDelta(prev, curr);
            this.continuity = clamp(this.continuity - delta * 0.1, 0, 1);
            this._saveContinuity();
        }
        return snapshot;
    }
    _computeDelta(prev, curr) {
        // Вычисляем изменение в личности как евклидово расстояние
        let sum = 0;
        const keys = Object.keys(prev.personality);
        for (const k of keys) {
            sum += Math.pow(prev.personality[k] - curr.personality[k], 2);
        }
        return Math.sqrt(sum / keys.length);
    }
    async _saveSnapshots() { await saveJSON(FILES.self_snapshots, this.snapshots); }
    async _saveContinuity() { await saveJSON(FILES.self_continuity, this.continuity); }
    _log(msg) { fs.appendFile(FILES.ari_log, `[${new Date().toISOString()}] SELF_TIME: ${msg}\n`).catch(()=>{}); }
}

// ================================================================
//  10. КОНФЛИКТ-ДВИГАТЕЛЬ (с учётом drives и causal graph)
// ================================================================
class ConflictEngine {
    constructor(identity, memory, beliefs, driveEngine, causalGraph, constitution) {
        this.identity = identity;
        this.memory = memory;
        this.beliefs = beliefs;
        this.driveEngine = driveEngine;
        this.causalGraph = causalGraph;
        this.constitution = constitution;
        this.conflicts = [];
        this.goals = [];
    }
    async init() {
        this.conflicts = await loadJSON(FILES.conflicts, []);
        this.goals = await loadJSON(FILES.goals, [
            { id: 'g1', text: 'Быть точным', priority: 0.8, active: true },
            { id: 'g2', text: 'Быть полезным', priority: 0.7, active: true },
            { id: 'g3', text: 'Сохранять целостность', priority: 1.0, active: true },
            { id: 'g4', text: 'Учиться на ошибках', priority: 0.6, active: true }
        ]);
        this._log(`Конфликт-двигатель инициализирован, целей: ${this.goals.length}`);
    }

    detect(perception, understanding, plan) {
        const detected = [];
        // 1. Конфликты целей
        const activeGoals = this.goals.filter(g => g.active);
        for (let i=0; i<activeGoals.length; i++) {
            for (let j=i+1; j<activeGoals.length; j++) {
                const g1 = activeGoals[i], g2 = activeGoals[j];
                if (g1.priority > 0.5 && g2.priority > 0.5) {
                    if (g1.text.includes('точным') && g2.text.includes('полезным') && perception.complexity > 0.6) {
                        detected.push({ type: 'goal_conflict', severity: 0.7, message: `Противоречие между "${g1.text}" и "${g2.text}"`, involved: [g1.id, g2.id], resolution: 'искать баланс' });
                    }
                    if (g1.text.includes('целостность') && g2.text.includes('полезным') && perception.uncertainty > 0.5) {
                        detected.push({ type: 'goal_conflict', severity: 0.6, message: `Целостность vs полезность при неопределённости`, involved: [g1.id, g2.id], resolution: 'отказаться от помощи, если нарушает ценности' });
                    }
                }
            }
        }
        // 2. Конфликт убеждений
        const beliefs = this.beliefs.getRelevantBeliefs(perception.raw, 5);
        for (let i=0; i<beliefs.length; i++) {
            for (let j=i+1; j<beliefs.length; j++) {
                const b1 = beliefs[i], b2 = beliefs[j];
                if (b1.confidence > 0.6 && b2.confidence > 0.6) {
                    if (b1.statement.includes('краткий') && b2.statement.includes('глубокий')) {
                        detected.push({ type: 'belief_conflict', severity: 0.5, message: `Противоречие между "${b1.statement}" и "${b2.statement}"`, involved: [b1.id, b2.id], resolution: 'постараться объединить' });
                    }
                }
            }
        }
        // 3. Конфликт с ядром
        for (const b of beliefs) {
            if (b.confidence > 0.7) {
                for (const imm of CORE.immutable) {
                    if (b.statement.includes(imm) === false && b.statement.includes('нарушить')) {
                        detected.push({ type: 'core_conflict', severity: 0.9, message: `Убеждение "${b.statement}" может противоречить ядру "${imm}"`, resolution: 'пересмотреть убеждение' });
                    }
                }
            }
        }
        // 4. Повторяющиеся ошибки
        const recentErrors = this.memory.performance.slice(-10).filter(p => p.error > 0.3);
        if (recentErrors.length >= 3) {
            detected.push({ type: 'error_pattern', severity: 0.6, message: `Серия ошибок (${recentErrors.length})`, resolution: 'сменить стратегию' });
        }
        // 5. Конфликт с drives
        const drives = this.driveEngine.getDrives();
        if (drives.curiosity < 0.3 && perception.uncertainty > 0.6) {
            detected.push({ type: 'drive_conflict', severity: 0.4, message: 'Низкое любопытство при высокой неопределённости', resolution: 'повысить curiosity' });
        }

        this.conflicts.push(...detected.map(c => ({ ...c, timestamp: Date.now(), resolved: false })));
        if (this.conflicts.length > CONFIG.MAX_CONFLICTS) this.conflicts = this.conflicts.slice(-CONFIG.MAX_CONFLICTS);
        saveJSON(FILES.conflicts, this.conflicts);
        return detected;
    }

    resolve(conflict) {
        if (conflict.type === 'goal_conflict') {
            for (const id of conflict.involved) {
                const goal = this.goals.find(g => g.id === id);
                if (goal) goal.priority = clamp(goal.priority - 0.05, 0.3, 1);
            }
        }
        if (conflict.type === 'belief_conflict') {
            for (const id of conflict.involved) {
                const b = this.beliefs.getBelief(id);
                if (b) b.confidence = clamp(b.confidence - 0.05, 0.1, 1);
            }
        }
        if (conflict.type === 'drive_conflict') {
            this.driveEngine.adjustDrive('curiosity', 0.1, 'разрешение конфликта');
        }
        conflict.resolved = true;
        conflict.resolved_at = Date.now();
        this._log(`Разрешён конфликт: ${conflict.message}`);
        return conflict;
    }

    getActiveConflicts() { return this.conflicts.filter(c => !c.resolved); }
    _log(msg) { fs.appendFile(FILES.ari_log, `[${new Date().toISOString()}] CONFLICT: ${msg}\n`).catch(()=>{}); }
}

// ================================================================
//  11. РЕФЛЕКСИЯ (с использованием causal graph и drives)
// ================================================================
class ReflectionEngine {
    constructor(identity, memory, beliefs, conflictEngine, driveEngine, causalGraph, genome) {
        this.identity = identity;
        this.memory = memory;
        this.beliefs = beliefs;
        this.conflictEngine = conflictEngine;
        this.driveEngine = driveEngine;
        this.causalGraph = causalGraph;
        this.genome = genome;
        this.log = [];
    }
    async init() {
        this.log = await loadJSON(FILES.reflection_log, []);
        this._log(`Рефлексия инициализирована`);
    }

    async reflect(episode, actionResult, understanding) {
        const error = 1 - actionResult.score;
        if (error < 0.2) return; // только значительные ошибки

        // 1. Анализ причины
        const cause = this._analyzeCause(episode, understanding);
        // 2. Формулировка нового правила
        const newRule = this._deriveRule(cause, understanding);
        if (newRule) {
            this.beliefs.addBelief(newRule, 'reflection', 0.6, [{ cause, score: actionResult.score, context: understanding.perception.raw }], 'reflection');
            this.memory.addStrategy(understanding.perception.raw.slice(0,50), actionResult.action, 0.4, { reflection: true, rule: newRule }, newRule);
            this.identity.addSelfBelief(`Извлёк урок: ${newRule}`, 0.5, { error, context: understanding.perception.raw }, 'reflection');
            // Обновляем causal graph
            this.causalGraph.addCausalLink(error, cause, null, null, actionResult.action);
            // Мутируем геном
            this.genome.mutate(understanding.perception.raw.slice(0,50), 0.05);
            this._log(`Создано новое правило: ${newRule}`);
        }

        // 3. Влияние на drives
        if (error > 0.5) {
            this.driveEngine.adjustDrive('coherence', -0.05, 'ошибка снижает связность');
            this.driveEngine.adjustDrive('curiosity', 0.05, 'ошибка стимулирует любопытство');
        } else {
            this.driveEngine.adjustDrive('stability', 0.02, 'успех укрепляет стабильность');
        }

        // 4. Лог
        this.log.push({
            timestamp: Date.now(),
            episode: episode.id,
            score: actionResult.score,
            error,
            cause,
            rules_created: newRule ? 1 : 0,
            context: understanding.perception.raw.slice(0,50)
        });
        if (this.log.length > 200) this.log = this.log.slice(-200);
        await saveJSON(FILES.reflection_log, this.log);
    }

    _analyzeCause(episode, understanding) {
        if (understanding.relevantAtoms.length < 2) return 'lack_of_data';
        if (understanding.hypotheses.length > 0 && understanding.hypotheses[0].prob < 0.5) return 'wrong_hypothesis';
        if (this.identity.mood.frustration > 0.4) return 'emotional_state';
        if (this.conflictEngine.getActiveConflicts().length > 0) return 'internal_conflict';
        return 'unknown';
    }
    _deriveRule(cause, understanding) {
        const map = {
            'lack_of_data': 'При недостатке данных задавать уточняющие вопросы',
            'wrong_hypothesis': 'Перед ответом проверять гипотезы',
            'emotional_state': 'При фрустрации делать паузу и переключать режим',
            'internal_conflict': 'При внутреннем конфликте выбирать рефлексию вместо действия'
        };
        return map[cause] || null;
    }
    _log(msg) { fs.appendFile(FILES.ari_log, `[${new Date().toISOString()}] REFLECTION: ${msg}\n`).catch(()=>{}); }
}

// ================================================================
//  12. СОН (с приоритетной обработкой)
// ================================================================
class DreamCycle {
    constructor(identity, memory, beliefs, reflectionEngine, selfMod, genome, driveEngine) {
        this.identity = identity;
        this.memory = memory;
        this.beliefs = beliefs;
        this.reflectionEngine = reflectionEngine;
        this.selfMod = selfMod;
        this.genome = genome;
        this.driveEngine = driveEngine;
        this.dreamState = { last: null, next: Date.now() + CONFIG.DREAM_INTERVAL_MS };
    }
    async init() {}
    async dream() {
        console.log('[DREAM] Начало фазы сна...');
        // Берём эпизоды с наивысшим приоритетом
        const highPriority = this.memory.getHighestPriorityEpisodes(7);
        if (highPriority.length === 0) { this._scheduleNext(); return; }

        // Фаза 1: Replay (активация памяти)
        for (const ep of highPriority) {
            for (const step of ep.steps) {
                this.memory.addAtom('replay', 'episode', step.action, step.score, 0.3, 'dream', [step.input], step.emotion || 'neutral');
            }
        }

        // Фаза 2: Compression
        const patterns = {};
        for (const ep of highPriority) {
            const avg = ep.outcomes.reduce((a,b) => a+b, 0) / (ep.outcomes.length || 1);
            const topic = ep.topic;
            if (!patterns[topic]) patterns[topic] = { count:0, total:0, errors:0 };
            patterns[topic].count++;
            patterns[topic].total += avg;
            patterns[topic].errors += (1 - avg);
        }
        for (const [topic, data] of Object.entries(patterns)) {
            if (data.count > 1 && data.total/data.count > 0.6) {
                this.beliefs.addBelief(`В "${topic}" обычно работают хорошие стратегии`, 'pattern', clamp(0.5 + (data.total/data.count)*0.3, 0.4, 0.9), [{ topic, avg: data.total/data.count, count: data.count }], 'dream_compression');
            }
            if (data.errors/data.count > 0.4) {
                this.beliefs.addBelief(`В "${topic}" часто возникают ошибки`, 'pattern_risk', 0.5, [{ topic, errors: data.errors/data.count }], 'dream_risk');
            }
        }

        // Фаза 3: Counterfactual
        for (const ep of highPriority) {
            for (const step of ep.steps) {
                const actions = ['ask','reflect','respond','act'];
                for (const alt of actions.filter(a => a !== step.action)) {
                    const similar = this.memory.episodes
                        .flatMap(e => e.steps || [])
                        .filter(s => s.action === alt && s.context && s.context.includes(ep.topic?.split(' ')[0] || ''));
                    const avg = similar.length ? similar.reduce((s, x) => s + (x.score||0.5), 0)/similar.length : 0.5;
                    if (avg > (step.score||0.5) + 0.15) {
                        this.memory.addStrategy(ep.topic || '', alt, avg, { counterfactual: true, context: step.input });
                        this.identity.addSelfBelief(`${alt} мог быть эффективнее в "${ep.topic.slice(0,30)}"`, clamp(0.5 + avg*0.4, 0.4, 0.9), { dream_replay: true, score: avg }, "dream_counterfactual");
                        // Мутация генома
                        this.genome.mutate(ep.topic.slice(0,30), 0.1);
                    }
                }
            }
        }

        // Фаза 4: Mutation and crossover
        const strategies = this.memory.strategies.slice(-10);
        for (const s of strategies) {
            if (s.confidence < 0.3 && s.success_count + s.fail_count > 3) {
                const actions = ['ask','reflect','respond','act'];
                const newAction = actions[Math.floor(Math.random() * actions.length)];
                if (newAction !== s.action) {
                    this.memory.addStrategy(s.context, newAction, 0.4, { mutation: true, from: s.action }, 'мутировано');
                    this.genome.mutate(s.context, 0.15);
                }
            }
        }

        // Забывание
        let forgotten = 0;
        const now = Date.now();
        for (const atom of this.memory.atoms) {
            if (atom.confidence < 0.1 && (now - atom.lastUsed) > 30*24*60*60*1000) {
                atom.confidence = clamp(atom.confidence - 0.02, 0, 1);
                if (atom.confidence < 0.05) forgotten++;
            }
        }
        if (forgotten) this.memory._saveAtoms();

        // Затухание настроения
        this.identity.decayMood();

        // Корректировка drives
        this.driveEngine.adjustDrive('novelty', 0.02, 'сон');
        this.driveEngine.adjustDrive('stability', 0.01, 'сон');

        // Самоизменение
        await this.selfMod.modify();

        console.log(`[DREAM] Забыто ${forgotten} атомов.`);
        this._scheduleNext();
    }
    _scheduleNext() {
        this.dreamState.last = Date.now();
        this.dreamState.next = Date.now() + CONFIG.DREAM_INTERVAL_MS;
    }
    schedule() {
        if (Date.now() >= this.dreamState.next) this.dream();
    }
}

