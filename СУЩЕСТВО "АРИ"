// core/extractor.js
function extractBeliefs(text, userId = 'user') {
    const results = [];
    const lower = text.toLowerCase();

    // 1. Детекция отрицания
    const negation = detectNegation(text);
    const polarity = negation ? -1 : 1;

    // 2. Поиск прямых предпочтений
    const patterns = [
        { trigger: 'люблю', type: 'preference', polarity: 1 },
        { trigger: 'нравится', type: 'preference', polarity: 1 },
        { trigger: 'предпочитаю', type: 'preference', polarity: 1 },
        { trigger: 'не люблю', type: 'avoidance', polarity: -1 },
        { trigger: 'не нравится', type: 'avoidance', polarity: -1 },
        { trigger: 'терпеть не могу', type: 'avoidance', polarity: -1 }
    ];

    for (const pattern of patterns) {
        const idx = lower.indexOf(pattern.trigger);
        if (idx === -1) continue;

        const rest = text.slice(idx + pattern.trigger.length).trim();
        const end = rest.search(/[.!?]/) + 1 || rest.length;
        const fragment = rest.slice(0, end).trim();

        if (fragment.length < 3) continue;

        // Определяем свойство и значение
        const propVal = parsePropertyValue(fragment);
        if (!propVal) continue;

        // Учитываем отрицание в самом шаблоне
        const finalPolarity = pattern.polarity * (negation ? -1 : 1);

        const belief = {
            type: finalPolarity > 0 ? 'preference' : 'avoidance',
            domain: 'user_style',
            property: propVal.property,
            value: finalPolarity > 0 ? 'high' : 'low',
            confidence: 0.6,
            certainty: 0.5,
            importance: 0.5,
            source: 'user',
            subject: userId,
            evidence: [{ timestamp: Date.now(), fragment: fragment, msgId: crypto.randomUUID() }],
            context: extractContext(text)
        };
        results.push(belief);
    }

    // 2. Косвенные сигналы (без trigger)
    const indirect = inferIndirect(text);
    for (const signal of indirect) {
        results.push({
            ...signal,
            source: 'inferred',
            subject: userId,
            confidence: 0.4,
            certainty: 0.3,
            importance: 0.3,
            evidence: [{ timestamp: Date.now(), fragment: text.slice(0, 50), msgId: crypto.randomUUID() }]
        });
    }

    return results;
}

function detectNegation(text) {
    const negWords = ['не', 'нет', 'ни', 'без', 'никогда', 'ничего'];
    // Простая проверка: наличие негативного слова перед ключевым
    return negWords.some(w => text.includes(w));
}

function parsePropertyValue(fragment) {
    const lower = fragment.toLowerCase();
    if (lower.includes('структур') || lower.includes('план') || lower.includes('архитектур')) {
        return { property: 'structure', value: 'high' };
    }
    if (lower.includes('глубок') || lower.includes('философ') || lower.includes('смысл')) {
        return { property: 'depth', value: 'high' };
    }
    if (lower.includes('кратк') || lower.includes('ясн') || lower.includes('чётк')) {
        return { property: 'brevity', value: 'high' };
    }
    if (lower.includes('метафор') || lower.includes('образ')) {
        return { property: 'metaphor', value: 'high' };
    }
    if (lower.includes('технич') || lower.includes('код') || lower.includes('детал')) {
        return { property: 'technical', value: 'high' };
    }
    return null;
}

function extractContext(text) {
    const topics = [];
    const lower = text.toLowerCase();
    if (lower.includes('архитектур') || lower.includes('проект') || lower.includes('систем')) {
        topics.push('architecture');
    }
    if (lower.includes('работа') || lower.includes('дело') || lower.includes('задач')) {
        topics.push('work');
    }
    if (lower.includes('личн') || lower.includes('жизн') || lower.includes('чувств')) {
        topics.push('personal');
    }
    return { topics: topics.length ? topics : ['general'], task: null };
}

function inferIndirect(text) {
    const results = [];
    const lower = text.toLowerCase();
    // Если много вопросительных знаков → пользователь в поиске
