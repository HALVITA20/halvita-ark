async function processInput(userMessage, feedback) {
    // 1. Извлечение убеждений
    const newBeliefs = extractBeliefs(userMessage);
    for (const belief of newBeliefs) {
        beliefMemory.add(belief.type, belief.domain, belief.content, 0.6);
    }

    // 2. Контекст
    const context = {
        userMessage,
        history: history.slice(-10),
        goal: state.goal,
        uncertainty: userMessage.includes("?") ? 0.7 : 0.3,
        hasPlan: userMessage.includes("план") ? 0.8 : 0,
        questionDepth: userMessage.split("?").length - 1,
        feedback: feedback || null
    };

    // 3. Решение
    const decision = decide(context);
    context.decision = decision;

    // 4. Инструкция
    const instructions = {
        ask: "Задай уточняющий вопрос, не давая ответа.",
        act: "Сделай конкретный шаг или предложи план действий.",
        reflect: "Поразмышляй над этим. Не давай окончательного ответа.",
        respond: "Ответь прямо и ясно."
    };
    const instruction = instructions[decision.action] || instructions.respond;

    // 5. Генерация
    const result = await generateResponse(context, instruction);
    const cleanResult = result.trim() || "Я здесь.";

    // 6. Оценка
    const score = evaluate(context, cleanResult, decision);

    // 7. Обновление весов
    updateWeights(decision, score);

    // 8. Сохранение истории
    history.push({ role: "user", text: userMessage });
    history.push({ role: "ari", text: cleanResult, action: decision.action });
    if (history.length > 50) history = history.slice(-50);
    state.history = history;
    remember("user", userMessage);
    remember("ari", cleanResult);

    // 9. Сохранение убеждений
    state.beliefs = beliefMemory.beliefs;
    state.totalAttempts = (state.totalAttempts || 0) + 1;
    saveJSON(PATHS.state, state);

    console.log(`[LEARN] action: ${decision.action}, score: ${score.toFixed(2)}, beliefs: ${beliefMemory.beliefs.length}`);
    return cleanResult;
}

