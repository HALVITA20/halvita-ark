function updateSystem(decision, score) {
    const action = decision.action;
    if (score > 0.6) {
        // Успех → усиливаем действие
        state.weights[action] = Math.min(1.5, state.weights[action] + 0.05);
        state.learning.successfulActions += 1;
    } else {
        // Неудача → ослабляем действие
        state.weights[action] = Math.max(0.3, state.weights[action] - 0.03);
    }

    // Сохраняем общую статистику
    state.learning.totalAttempts += 1;
    state.learning.lastScore = score;

    // Нормализуем веса, чтобы сумма была константной
    const sum = Object.values(state.weights).reduce((a, b) => a + b, 0);
    for (let key in state.weights) {
        state.weights[key] = state.weights[key] / sum * 2;
    }

    saveJSON(PATHS.state, state);
}

