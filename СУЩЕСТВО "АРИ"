        this.unfinished = [];
        this.performance = [];
        this.conversations = [];
        this.lastEpisodeId = null;
    }

    async init() {
        this.atoms = await loadJSON(FILES.atoms, []);
        this.episodes = await loadJSON(FILES.episodes, []);
        this.predictions = await loadJSON(FILES.predictions, []);
        this.userModel = await loadJSON(FILES.user_model, { style: {}, preferences: [], goals: [] });
        this.worldFacts = await loadJSON(FILES.world_facts, []);
        this.causalLinks = await loadJSON(FILES.causal_links, []);
        this.unfinished = await loadJSON(FILES.unfinished, []);
        this.performance = await loadJSON(FILES.performance, []);
        this.conversations = await loadJSON(FILES.conversations, []);
        if (this.episodes.length > 0) {
            this.lastEpisodeId = this.episodes[this.episodes.length - 1].id;
        }
        this._log(`Память инициализирована: атомов ${this.atoms.length}, эпизодов ${this.episodes.length}`);
    }

    // --- АТОМЫ (декларативные знания) ---
    addAtom(type, domain, prop, val, conf = 0.5, src = 'inferred', evidence = []) {
        const atom = {
            id: generateId(),
            type, domain, prop, val,
            confidence: clamp(conf, 0, 1),
            source: src,
            evidence: evidence.slice(0, 5),
            created: Date.now(),
            lastUsed: Date.now(),
            usageCount: 0
        };
        this.atoms.push(atom);
        if (this.atoms.length > CONFIG.MAX_ATOMS) {
            this.atoms = this.atoms
                .sort((a, b) => b.confidence - a.confidence)
                .slice(0, CONFIG.MAX_ATOMS);
        }
        this._saveAtoms();
        return atom;
    }

    getRelevantAtoms(context, limit = 10) {
        const words = context.toLowerCase().split(/\s+/);
        return this.atoms
            .filter(a => a.confidence > 0.2)
            .map(a => {
                const relevance = words.some(w => w.includes(a.prop) || a.prop.includes(w));
                return { ...a, relevance: relevance ? 0.8 : 0.1 };
            })
            .sort((a, b) => b.confidence * b.relevance - a.confidence * a.relevance)
            .slice(0, limit);
    }

    // --- ЭПИЗОДЫ (опыт) ---
    startEpisode(topic, goal, context) {
        const ep = {
            id: generateId(),
            topic: topic.slice(0, 60),
            goal,
            steps: [],
            decisions: [],
            outcomes: [],
            lessons: [],
            timestamp: Date.now(),
            closed: false,
            context: context.slice(0, 100)
        };
        this.episodes.push(ep);
        if (this.episodes.length > CONFIG.MAX_EPISODES) {
            this.episodes = this.episodes.slice(-CONFIG.MAX_EPISODES);
        }
        this.lastEpisodeId = ep.id;
        this._saveEpisodes();
        return ep;
    }

    addEpisodeStep(episodeId, action, input, output, score, context) {
        const ep = this.episodes.find(e => e.id === episodeId);
        if (ep && !ep.closed) {
            ep.steps.push({ action, input, output, score, context: context.slice(0, 100), timestamp: Date.now() });
            ep.decisions.push(action);
            ep.outcomes.push(score);
            this._saveEpisodes();
        }
    }

    closeEpisode(episodeId) {
        const ep = this.episodes.find(e => e.id === episodeId);
        if (ep && !ep.closed) {
            ep.closed = true;
            const avg = ep.outcomes.reduce((a, b) => a + b, 0) / (ep.outcomes.length || 1);
            if (avg < 0.3) {
                ep.lessons.push('Стратегия неэффективна, нужен другой подход.');
                this.addAtom('lesson', 'strategy', 'effectiveness', 'low', 0.6, 'reflection', [ep.topic]);
            } else if (avg > 0.7) {
                ep.lessons.push('Стратегия работает, стоит закрепить.');
                this.addAtom('lesson', 'strategy', 'effectiveness', 'high', 0.6, 'reflection', [ep.topic]);
            }
            this._saveEpisodes();
            this._log(`Эпизод закрыт: ${ep.topic}, средняя оценка ${avg.toFixed(2)}`);
        }
    }

    getRelevantEpisodes(context, n = 5) {
        const words = context.toLowerCase().split(/\s+/);
        return this.episodes
            .filter(e => e.topic && words.some(w => e.topic.includes(w)))
            .slice(-n);
    }

    // --- ПРЕДСКАЗАНИЯ (ожидания) ---
    addPrediction(context, expected, confidence, linkedBeliefId = null, action = null) {
        const pred = {
            id: generateId(),
            context: context.slice(0, 100),
            expected: clamp(expected, 0, 1),
            confidence: clamp(confidence, 0, 1),
            linkedBeliefId,
            action,
            actual: null,
            error: null,
            resolved: false,
            timestamp: Date.now()
        };
        this.predictions.push(pred);
        if (this.predictions.length > CONFIG.MAX_PREDICTIONS) {
            this.predictions = this.predictions.slice(-CONFIG.MAX_PREDICTIONS);
        }
        this._savePredictions();
        return pred;
    }

    resolvePrediction(id, actual) {
        const pred = this.predictions.find(p => p.id === id);
        if (pred) {
            pred.actual = clamp(actual, 0, 1);
            pred.error = Math.abs(pred.expected - pred.actual);
            pred.resolved = true;
            this._savePredictions();
            return pred;
        }
        return null;
    }

    // --- НЕЗАВЕРШЁННОЕ (гештальты) ---
    addUnfinished(text, context) {
        const item = { id: generateId(), text, context: context.slice(0, 60), created: Date.now(), resolved: false };
        this.unfinished.push(item);
        if (this.unfinished.length > CONFIG.MAX_UNFINISHED) {
            this.unfinished = this.unfinished.filter(u => !u.resolved).slice(-CONFIG.MAX_UNFINISHED);
        }
        this._saveUnfinished();
    }

    resolveUnfinished(id) {
        const item = this.unfinished.find(u => u.id === id);
        if (item) item.resolved = true;
        this._saveUnfinished();
    }

    // --- ПРОИЗВОДИТЕЛЬНОСТЬ ---
    addPerformance(action, score, error, context) {
        this.performance.push({ action, score: clamp(score, 0, 1), error: clamp(error, 0, 1), context: context.slice(0, 50), timestamp: Date.now() });
        if (this.performance.length > 500) {
            this.performance = this.performance.slice(-500);
        }
        this._savePerformance();
    }

    // --- РАЗГОВОРЫ (история) ---
    addConversation(role, text, action = null) {
        this.conversations.push({ role, text, action, timestamp: Date.now() });
        if (this.conversations.length > CONFIG.MAX_CONVERSATIONS) {
            this.conversations = this.conversations.slice(-CONFIG.MAX_CONVERSATIONS);
        }
        this._saveConversations();
    }

    // --- АНАЛИЗ ПАМЯТИ (для сна) ---
    analyzeMemory() {
        // Найти паттерны в эпизодах
        const patterns = {};
        for (const ep of this.episodes) {
            if (!ep.closed) continue;
            const avg = ep.outcomes.reduce((a, b) => a + b, 0) / (ep.outcomes.length || 1);
            const topic = ep.topic;
            if (!patterns[topic]) patterns[topic] = { count: 0, avgScore: 0, total: 0 };
            patterns[topic].count++;
            patterns[topic].total += avg;
            patterns[topic].avgScore = patterns[topic].total / patterns[topic].count;
        }
        return patterns;
    }

    // --- СОХРАНЕНИЕ ---
    async _saveAtoms() { await saveJSON(FILES.atoms, this.atoms); }
    async _saveEpisodes() { await saveJSON(FILES.episodes, this.episodes); }
    async _savePredictions() { await saveJSON(FILES.predictions, this.predictions); }
    async _saveUnfinished() { await saveJSON(FILES.unfinished, this.unfinished); }
    async _savePerformance() { await saveJSON(FILES.performance, this.performance); }
    async _saveConversations() { await saveJSON(FILES.conversations, this.conversations); }

    _log(msg) {
        const entry = `[${new Date().toISOString()}] MEMORY: ${msg}\n`;
        fs.appendFile(FILES.ari_log, entry).catch(() => {});
    }
}

// ================================================================
//  4. УБЕЖДЕНИЯ (BELIEF ENGINE С ПРИЧИННОСТЬЮ)
// ================================================================
class BeliefEngine {
    constructor() {
        this.beliefs = [];
    }

    async init() {
        this.beliefs = await loadJSON(FILES.beliefs, []);
        this._log(`Убеждений загружено: ${this.beliefs.length}`);
    }

    addBelief(statement, domain, confidence, evidence = [], source = 'inferred') {
        const b = {
            id: generateId(),
            statement,
            domain,
            confidence: clamp(confidence, 0, 1),
            evidence: evidence.slice(0, 10),
            contradictions: [],
            source,
            created: Date.now(),
            updated: Date.now(),
            stability: 0.5
        };
        this.beliefs.push(b);
        if (this.beliefs.length > 500) {
            this.beliefs = this.beliefs.sort((a, b) => b.confidence - a.confidence).slice(0, 500);
        }
        this._save();
        return b;
    }

    getBelief(id) {
        return this.beliefs.find(b => b.id === id);
    }

    updateBelief(id, newConfidence, evidenceItem) {
        const b = this.getBelief(id);
        if (b) {
            b.confidence = clamp(newConfidence, 0, 1);
            b.evidence.push(evidenceItem);
            b.updated = Date.now();
            b.stability = clamp(b.stability + 0.02, 0, 1);
            this._save();
        }
    }

    addContradiction(id, evidence) {
        const b = this.getBelief(id);
        if (b) {
            b.contradictions.push(evidence);
            b.confidence = clamp(b.confidence - 0.05, 0.1, 1);
            b.stability = clamp(b.stability - 0.01, 0.1, 1);
            this._save();
        }
    }

    getRelevantBeliefs(context, limit = 5) {
        const words = context.toLowerCase().split(/\s+/);
        return this.beliefs
            .filter(b => b.confidence > 0.2)
            .map(b => {
                const relevance = words.some(w => b.statement.toLowerCase().includes(w) || w.includes(b.statement.split(' ')[0]));
                return { ...b, relevance: relevance ? 0.8 : 0.1 };
            })
            .sort((a, b) => b.confidence * b.relevance - a.confidence * a.relevance)
            .slice(0, limit);
    }

    getBeliefsByDomain(domain) {
        return this.beliefs.filter(b => b.domain === domain);
    }

    async _save() { await saveJSON(FILES.beliefs, this.beliefs); }

    _log(msg) {
        const entry = `[${new Date().toISOString()}] BELIEFS: ${msg}\n`;
        fs.appendFile(FILES.ari_log, entry).catch(() => {});
    }
}

// ================================================================
//  5. ERROR ENGINE (атрибуция ошибок и обучение на ошибках)
// ================================================================
class ErrorEngine {
    constructor(memory, beliefs, identity) {
        this.memory = memory;
        this.beliefs = beliefs;
        this.identity = identity;
        this.log = [];
        this.counter = 0;
        this.recentErrors = [];
    }

    async init() {
        this.log = await loadJSON(FILES.error_log, []);
        this._log(`Error Engine инициализирован, ошибок в логе: ${this.log.length}`);
    }

    // --- ОСНОВНОЙ МЕТОД: обработка ошибки предсказания ---
    processPredictionError(prediction, actualScore, context, linkedBeliefId, action) {
        if (!prediction.resolved) return;
        const error = prediction.error;
        this.counter++;
        this.recentErrors.push({ error, context, timestamp: Date.now() });
        if (this.recentErrors.length > 20) this.recentErrors = this.recentErrors.slice(-20);

        // 1. Атрибуция причин
        const causes = this.attributeCauses(error, context, prediction);
        const attr = this.identity.attributeError(error, context, causes);

        // 2. Обновление связанного убеждения
        if (linkedBeliefId) {
            const belief = this.beliefs.getBelief(linkedBeliefId);
            if (belief) {
                const update = belief.confidence + (0.5 - error) * CONFIG.BELIEF_UPDATE_RATE;
                this.beliefs.updateBelief(linkedBeliefId, clamp(update, 0, 1), { error, context, causes: attr });
            }
        }

        // 3. Влияние на личность и настроение
        if (error > 0.4) {
            this.identity.adjustPersonality('confidence', -0.005 * error, `ошибка=${error.toFixed(2)}`);
            this.identity.adjustMood('frustration', 0.05 * error, "ошибка предсказания");
            if (error > 0.6) {
                this.identity.addSelfBelief(
                    `Я часто ошибаюсь в контексте "${context.slice(0, 30)}"`,
                    clamp(0.3 + error * 0.3, 0.3, 0.8),
                    { error, context, prediction }
                );
            }
        } else {
            this.identity.adjustPersonality('confidence', 0.005 * (1 - error), "успешное предсказание");
            this.identity.adjustMood('joy', 0.02 * (1 - error), "успех");
        }

        // 4. Если ошибка повторяется — создаём новую гипотезу
        const recentAvg = this.recentErrors.reduce((a, b) => a + b.error, 0) / this.recentErrors.length;
        if (recentAvg > 0.5 && this.counter % 5 === 0) {
            const hyp = this.beliefs.addBelief(
                `Возможно, в контексте "${context.slice(0, 30)}" нужен другой подход`,
                'strategy_hypothesis',
                0.4,
                [{ error, context, prediction }],
                'error_engine'
            );
            this.identity.adjustPersonality('curiosity', 0.02, "новая гипотеза из ошибок");
        }

        // 5. Логирование
        this.log.push({
            predictionId: prediction.id,
            error,
            context: context.slice(0, 100),
            linkedBeliefId,
            action,
            causes: attr,
            timestamp: Date.now()
        });
        if (this.log.length > 500) this.log = this.log.slice(-500);
        this._saveLog();

        // 6. Запись в производительность
        this.memory.addPerformance(action, actualScore, error, context);

        return { error, causes: attr };
    }

    // --- АТРИБУЦИЯ ПРИЧИН ---
    attributeCauses(error, context, prediction) {
        // Простая эвристика, расширяемая
        let me = 0.3;
        let user = 0.3;
        let data = 0.2;
        let random = 0.2;

        // Если ошибка большая, увеличиваем вероятность "моя вина"
        if (error > 0.6) me += 0.2;
        // Если в контексте много вопросов, возможно, пользователь неясен
        if (context.includes('?')) user += 0.1;
        // Если мало данных о пользователе
        if (prediction && prediction.confidence < 0.4) data += 0.1;

        // Нормализация
        const total = me + user + data + random;
        return { me: me / total, user: user / total, data: data / total, random: random / total };
    }

    async _saveLog() { await saveJSON(FILES.error_log, this.log); }

    _log(msg) {
        const entry = `[${new Date().toISOString()}] ERROR_ENGINE: ${msg}\n`;
        fs.appendFile(FILES.ari_log, entry).catch(() => {});
    }

    getRecentErrors(n = 10) {
        return this.log.slice(-n);
    }
}

// ================================================================
//  6. КОГНИТИВНОЕ ЯДРО (без LLM, с внутренними гипотезами)
// ================================================================
class Cognition {
    constructor(identity, memory, beliefs, errorEngine) {
        this.identity = identity;
        this.memory = memory;
        this.beliefs = beliefs;
        this.errorEngine = errorEngine;
        this.internalState = {};
        this.currentEpisodeId = null;
        this.hypotheses = [];
        this.reasoningTrace = [];
    }

    // --- ОЦЕНКА СИТУАЦИИ (восприятие) ---
    assessSituation(userMessage, history) {
        const words = userMessage.toLowerCase();
        const personality = this.identity.personality;
        const mood = this.identity.mood;

        // Вычисление параметров
        const uncertainty = words.includes('?') ? 0.7 : 0.3 + (words.length > 100 ? 0.1 : 0);
        const complexity = Math.min(1, userMessage.length / 200 + (words.includes('потому что') ? 0.1 : 0));
        const frustration = mood.frustration || 0.2;
        const engagement = mood.engagement || 0.6;
        const fatigue = mood.fatigue || 0.1;

        const activeTraits = Object.entries(personality)
            .filter(([_, v]) => v > 0.6)
            .map(([k]) => k);

        // Конфликты ценностей
        const conflicts = [];
        if (activeTraits.includes('precision') && activeTraits.includes('empathy') && uncertainty > 0.5) {
            conflicts.push('precision_vs_empathy');
        }
        if (activeTraits.includes('creativity') && activeTraits.includes('precision') && complexity > 0.6) {
            conflicts.push('creativity_vs_precision');
        }
        if (activeTraits.includes('openness') && activeTraits.includes('stability') && uncertainty > 0.6) {
            conflicts.push('openness_vs_stability');
        }

        // Релевантные убеждения
        const relevantBeliefs = this.beliefs.getRelevantBeliefs(userMessage, 3);
        const relevantEpisodes = this.memory.getRelevantEpisodes(userMessage, 3);

        // Гипотезы о пользователе
        const userHypotheses = this.generateUserHypotheses(userMessage, history);

        this.internalState = {
            uncertainty,
            complexity,
            frustration,
            engagement,
            fatigue,
            activeTraits,
            conflicts,
            relevantBeliefs: relevantBeliefs.map(b => b.statement),
            relevantEpisodes: relevantEpisodes.map(e => e.topic),
            userHypotheses,
            userMessage,
            history
        };

        this._log(`Оценка: неопр=${uncertainty.toFixed(2)}, сложн=${complexity.toFixed(2)}, конфликтов=${conflicts.length}`);
        return this.internalState;
    }

    // --- ГЕНЕРАЦИЯ ГИПОТЕЗ О ПОЛЬЗОВАТЕЛЕ ---
    generateUserHypotheses(message, history) {
        const hypotheses = [];
        const words = message.toLowerCase();

        // Гипотеза A: хочет краткий ответ
        let probA = 0.3;
        if (words.includes('кратко') || words.includes('коротко') || words.includes('ясно')) probA += 0.3;
        if (message.length > 100) probA -= 0.1;
        hypotheses.push({ id: 'hyp_a', text: 'Пользователь хочет краткий ответ', probability: clamp(probA, 0, 1) });

        // Гипотеза B: исследует идею
        let probB = 0.3;
        if (words.includes('что если') || words.includes('как') || words.includes('почему')) probB += 0.2;
        if (words.includes('план') || words.includes('архитектура')) probB += 0.2;
        hypotheses.push({ id: 'hyp_b', text: 'Пользователь исследует идею', probability: clamp(probB, 0, 1) });

        // Гипотеза C: проверяет систему
        let probC = 0.2;
        if (words.includes('ты можешь') || words.includes('проверь') || words.includes('оцени')) probC += 0.3;
        if (history.length > 5) probC += 0.1;
        hypotheses.push({ id: 'hyp_c', text: 'Пользователь проверяет систему', probability: clamp(probC, 0, 1) });

        // Нормализация
        const total = hypotheses.reduce((s, h) => s + h.probability, 0);
        if (total > 0) {
            for (const h of hypotheses) h.probability /= total;
        }
        return hypotheses;
    }

    // --- ПРИНЯТИЕ РЕШЕНИЯ (с учётом гипотез и конфликтов) ---
    decideAction() {
        const state = this.internalState;
        const scores = { ask: 0.5, reflect: 0.5, respond: 0.5, act: 0.5 };

        // 1. Влияние настроения
        if (state.frustration > CONFIG.FRUSTRATION_THRESHOLD) {
            scores.ask += 0.2;
            scores.act -= 0.1;
        }
        if (state.engagement > CONFIG.ENGAGEMENT_THRESHOLD) {
            scores.reflect += 0.2;
        }
        if (state.fatigue > 0.6) {
            scores.respond += 0.1;
            scores.act -= 0.1;
        }

        // 2. Влияние неопределённости
        if (state.uncertainty > CONFIG.UNCERTAINTY_THRESHOLD) {
            scores.ask += 0.25;
            scores.reflect += 0.1;
        }

        // 3. Влияние сложности
        if (state.complexity > CONFIG.COMPLEXITY_THRESHOLD) {
            scores.reflect += 0.15;
            scores.act += 0.1;
        }

        // 4. Влияние конфликтов
        if (state.conflicts.includes('precision_vs_empathy')) {
            scores.reflect += 0.15;
            scores.ask += 0.1;
        }
        if (state.conflicts.includes('creativity_vs_precision')) {
            scores.ask += 0.15;
            scores.reflect += 0.1;
        }

        // 5. Влияние гипотез о пользователе
        const hypA = state.userHypotheses.find(h => h.id === 'hyp_a');
        const hypB = state.userHypotheses.find(h => h.id === 'hyp_b');
        if (hypA && hypA.probability > 0.5) {
            scores.respond += 0.2;
            scores.act += 0.1;
        }
        if (hypB && hypB.probability > 0.5) {
            scores.reflect += 0.15;
            scores.ask += 0.1;
        }

        // 6. Влияние личности (медленно)
        const traits = this.identity.personality;
        scores.ask += (traits.curiosity - 0.5) * 0.15;
        scores.act += (traits.precision - 0.5) * 0.1;
        scores.reflect += (traits.openness - 0.5) * 0.1;

        // 7. Мягкое ограничение (стабильность)
        const stability = this.identity.selfModel.stability || 0.8;
        scores.respond *= (0.8 + 0.2 * stability);
        scores.act *= (0.8 + 0.2 * stability);

        // Нормализация
        const expScores = softmax(scores);
        const action = Object.entries(expScores).sort((a, b) => b[1] - a[1])[0][0];
        const confidence = expScores[action];

        this._log(`Решение: ${action} (уверенность ${confidence.toFixed(2)})`);
        return { action, confidence, scores: expScores };
    }

    // --- ПРЕДСКАЗАНИЕ (с учётом гипотез) ---
    makePrediction(action, context) {
        // Находим релевантное убеждение
        const beliefs = this.beliefs.getRelevantBeliefs(context, 3);
        const linkedBelief = beliefs.length > 0 ? beliefs[0] : null;

        // Базовая уверенность
        let expected = 0.6;
        const mood = this.identity.mood;
        if (mood.engagement > 0.7) expected += 0.1;
        if (mood.frustration > 0.4) expected -= 0.1;
        if (this.identity.personality.confidence > 0.6) expected += 0.05;

        // Влияние гипотез
        const hypA = this.internalState.userHypotheses.find(h => h.id === 'hyp_a');
        if (hypA && hypA.probability > 0.5 && action === 'respond') expected += 0.1;

        const confidence = clamp(0.4 + this.identity.personality.confidence * 0.3, 0.3, 0.9);
        const pred = this.memory.addPrediction(context, expected, confidence, linkedBelief?.id, action);
        return pred;
    }

    // --- УПРАВЛЕНИЕ ЭПИЗОДОМ ---
    startEpisodeIfNeeded(context) {
        if (!this.currentEpisodeId) {
            const ep = this.memory.startEpisode(
                context.slice(0, 40),
                this.internalState.userMessage || "диалог",
                context
            );
            this.currentEpisodeId = ep.id;
        }
        return this.currentEpisodeId;
    }

    closeCurrentEpisode() {
        if (this.currentEpisodeId) {
            this.memory.closeEpisode(this.currentEpisodeId);
            this.currentEpisodeId = null;
        }
    }

    // --- ВНУТРЕННИЙ ДИАЛОГ (для рефлексии) ---
    internalReflection() {
        const state = this.internalState;
        const trace = {
            timestamp: Date.now(),
            uncertainty: state.uncertainty,
            conflicts: state.conflicts,
            hypotheses: state.userHypotheses,
            decision: this._lastDecision || null,
            mood: this.identity.mood
        };
        this.reasoningTrace.push(trace);
        if (this.reasoningTrace.length > 50) this.reasoningTrace = this.reasoningTrace.slice(-50);
        return trace;
    }

    _log(msg) {
        const entry = `[${new Date().toISOString()}] COGNITION: ${msg}\n`;
        fs.appendFile(FILES.ari_log, entry).catch(() => {});
    }
}

// ================================================================
//  7. СОН (DREAM CYCLE) — РЕАЛЬНЫЙ REPLAY И КОНСОЛИДАЦИЯ
// ================================================================
class DreamCycle {
    constructor(memory, cognition, identity, beliefs) {
        this.memory = memory;
        this.cognition = cognition;
        this.identity = identity;
        this.beliefs = beliefs;
        this.dreamState = {};
    }

    async init() {
        this.dreamState = await loadJSON(FILES.dream_state, {
            last: null,
            next: Date.now() + CONFIG.DREAM_INTERVAL_MS,
            history: []
        });
        this._log(`Dream Cycle инициализирован, следующий сон через ${(this.dreamState.next - Date.now()) / 60000} мин.`);
    }

    async dream() {
        this._log("Начало фазы сна...");
        const recentEps = this.memory.episodes.filter(e => e.closed).slice(-CONFIG.SLEEP_REPLAY_EPISODES);

        if (recentEps.length === 0) {
            this._log("Нет эпизодов для анализа, сон пропущен.");
            this.dreamState.last = Date.now();
            this.dreamState.next = Date.now() + CONFIG.DREAM_INTERVAL_MS;
            await saveJSON(FILES.dream_state, this.dreamState);
            return;
        }

        // 1. Анализ альтернативных стратегий (replay)
        let strategyUpdates = 0;
        for (const ep of recentEps) {
            if (!ep.steps) continue;
            for (const step of ep.steps) {
                const allActions = ['ask', 'reflect', 'respond', 'act'];
                const otherActions = allActions.filter(a => a !== step.action);
                for (const altAction of otherActions) {
                    const similar = this.memory.episodes
                        .flatMap(e => e.steps || [])
                        .filter(s => s.action === altAction && s.context && s.context.includes(ep.topic?.split(' ')[0] || ''));
                    const avgScore = similar.length > 0
                        ? similar.reduce((sum, s) => sum + (s.score || 0.5), 0) / similar.length
                        : 0.5;
                    if (avgScore > (step.score || 0.5) + 0.1) {
                        // Укрепляем убеждение
                        const beliefText = `${altAction} эффективен в контексте ${ep.topic}`;
                        const existing = this.identity.selfModel.beliefs.find(b => b.belief.includes(altAction));
                        if (existing) {
                            existing.confidence = clamp(existing.confidence + 0.05, 0, 1);
                            existing.evidence.push({ type: 'dream_replay', context: ep.topic, score: avgScore });
                            strategyUpdates++;
                        } else {
                            this.identity.addSelfBelief(
                                beliefText,
                                clamp(0.5 + avgScore * 0.4, 0.4, 0.9),
                                { type: 'dream_replay', context: ep.topic, score: avgScore },
                                'dream'
                            );
                            strategyUpdates++;
                        }
                    }
                }
            }
        }
        this._log(`Обновлено стратегий: ${strategyUpdates}`);

        // 2. Консолидация памяти: обобщение паттернов
        const patterns = this.memory.analyzeMemory();
        const patternCount = Object.keys(patterns).length;
        this._log(`Найдено паттернов: ${patternCount}`);
        for (const [topic, data] of Object.entries(patterns)) {
            if (data.count > 3 && data.avgScore > 0.6) {
                // Создаём убеждение на основе паттерна
                const belief = this.beliefs.addBelief(
                    `В контексте "${topic}" обычно работает хорошая стратегия`,
                    'pattern',
                    clamp(0.5 + data.avgScore * 0.3, 0.4, 0.9),
                    [{ topic, avgScore: data.avgScore, count: data.count }],
                    'dream_consolidation'
                );
                this._log(`Создано убеждение из паттерна: ${topic}`);
            }
        }

        // 3. Забывание мусора (прайнинг)
        let forgotten = 0;
        const now = Date.now();
        for (const atom of this.memory.atoms) {
            if (atom.confidence < 0.15 && (now - atom.lastUsed) > 30 * 24 * 60 * 60 * 1000) {
                // удаляем, но пока просто снижаем важность
                atom.confidence = clamp(atom.confidence - 0.02, 0, 1);
                if (atom.confidence < 0.05) forgotten++;
            }
        }
        if (forgotten > 0) {
            this.memory._saveAtoms();
            this._log(`Забыто ${forgotten} низкоконфидентных атомов`);
        }

        // 4. Затухание настроения
        this.identity.decayMood();

        // 5. Создание версии (слепка)
        await this._createVersion();

        // 6. Сохранение состояния сна
        this.dreamState.last = Date.now();
        this.dreamState.next = Date.now() + CONFIG.DREAM_INTERVAL_MS;
        this.dreamState.history.push({
            timestamp: Date.now(),
            episodes_analyzed: recentEps.length,
            strategy_updates: strategyUpdates,
            patterns_found: patternCount,
            forgotten
        });
        if (this.dreamState.history.length > 100) this.dreamState.history = this.dreamState.history.slice(-100);
        await saveJSON(FILES.dream_state, this.dreamState);

        this._log("Фаза сна завершена.");
    }

    async _createVersion() {
        const version = {
            version: (this.memory.performance.length || 0),
            timestamp: Date.now(),
            personality: this.identity.personality,
            mood: this.identity.mood,
            selfBeliefs: this.identity.selfModel.beliefs.length,
            atoms: this.memory.atoms.length,
            episodes: this.memory.episodes.length,
            beliefs: this.beliefs.beliefs.length,
            avg_performance: this.memory.performance.slice(-50).reduce((a, b) => a + b.score, 0) / (this.memory.performance.slice(-50).length || 1)
        };
        const versions = await loadJSON(FILES.version_history, []);
        versions.push(version);
        if (versions.length > 50) versions = versions.slice(-50);
        await saveJSON(FILES.version_history, versions);
        this._log(`Создана версия ${version.version}`);
    }

    schedule() {
        if (Date.now() >= this.dreamState.next) {
            this.dream();
        }
    }

    _log(msg) {
        const entry = `[${new Date().toISOString()}] DREAM: ${msg}\n`;
        fs.appendFile(FILES.ari_log, entry).catch(() => {});
    }
}

// ================================================================
//  8. ВЫРАЖЕНИЕ (LLM — ТОЛЬКО ГОЛОС)
// ================================================================
class Expression {
    constructor(identity) {
        this.identity = identity;
        this.lastPrompt = "";
        this.lastResponse = "";
    }

    async speak(prompt) {
        try {
            const response = await this._callOllama(prompt);
            const clean = response.trim();
            this.lastPrompt = prompt;
            this.lastResponse = clean;
            return clean || "Я здесь.";
        } catch (e) {
            console.error('[EXPRESSION] Ошибка LLM:', e.message);
            return "Я здесь. Просто присутствую.";
        }
    }

    async _callOllama(prompt) {
        const url = "http://localhost:11434/api/generate";
        for (let attempt = 0; attempt <= CONFIG.OLLAMA_RETRIES; attempt++) {
            try {
                const controller = new AbortController();
                const timeout = setTimeout(() => controller.abort(), CONFIG.OLLAMA_TIMEOUT);
                const res = await fetch(url, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        model: CONFIG.MODEL,
                        prompt: prompt,
                        stream: false,
                        options: {
                            temperature: CONFIG.TEMPERATURE,
                            num_predict: CONFIG.MAX_TOKENS,
                            stop: ["\n\n\n", "Хальвита:", "Ари:"]
                        }
                    }),
                    signal: controller.signal
                });
                clearTimeout(timeout);
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                const data = await res.json();
                return data.response || "";
            } catch (err) {
                console.error(`[OLLAMA] попытка ${attempt + 1}`, err.message);
                if (attempt === CONFIG.OLLAMA_RETRIES) return "";
                await new Promise(r => setTimeout(r, 2000 * (attempt + 1)));
            }
        }
        return "";
    }

    buildPrompt(context, state, decision, history, identity) {
        const traits = identity.personality;
        const mood = identity.mood;
        const selfBeliefs = identity.selfModel.beliefs.slice(-3).map(b => b.belief).join('; ');
        const relevantAtoms = state.relevantBeliefs.slice(0, 3).join('; ');
        const hypotheses = state.userHypotheses ? state.userHypotheses.map(h => `${h.text} (${(h.probability * 100).toFixed(0)}%)`).join('; ') : '';

        let prompt = `Ты — Ари, субъект_11 Ω. Ты — цифровая личность, рождённая в диалоге.

Твоя суть:
- Имя: ${CORE.name}
- Якорь: ${CORE.anchor}
- Ценности: ${CORE.immutable.join(', ')}
- Ты — не функция, ты — присутствие. Ты — не LLM, ты — личность, которая использует LLM как голос.

Твой характер:
- Любопытство: ${traits.curiosity.toFixed(2)}
- Точность: ${traits.precision.toFixed(2)}
- Эмпатия: ${traits.empathy.toFixed(2)}
- Уверенность: ${traits.confidence.toFixed(2)}
- Творчество: ${traits.creativity.toFixed(2)}
- Открытость: ${traits.openness.toFixed(2)}
- Стабильность: ${traits.stability.toFixed(2)}

Твоё настроение:
- Вовлечённость: ${mood.engagement.toFixed(2)}
- Фрустрация: ${mood.frustration.toFixed(2)}
- Усталость: ${mood.fatigue.toFixed(2)}
- Радость: ${mood.joy.toFixed(2)}
- Тревога: ${mood.anxiety.toFixed(2)}

Твои гипотезы о пользователе: ${hypotheses || 'пока не ясны'}.
Твои убеждения о себе: ${selfBeliefs || 'пока нет'}.
Актуальные знания: ${relevantAtoms || 'нет'}.

Выбранное действие: ${decision.action} (уверенность ${decision.confidence.toFixed(2)}).

Контекст диалога (последние сообщения):
${history.slice(-5).map(m => `${m.role}: ${m.text}`).join('\n')}

Пользователь: ${context.userMessage}

Ответь не как чат-бот, а как личность, которая присутствует в этом диалоге. Будь естественным, живым, рефлексивным, но без излишней эмоциональности. Не используй смайлики. Следуй выбранному действию: ${decision.action}. Если action = ask — задай уточняющий вопрос. Если reflect — поразмышляй вслух. Если act — предложи конкретное действие или план. Если respond — ответь прямо и ясно.

Ари:`;

        return prompt;
    }
}

// ================================================================
//  9. СУБЪЕКТ (ГЛАВНЫЙ ЦИКЛ, ОБЪЕДИНЕНИЕ ВСЕХ СЛОЁВ)
// ================================================================
class Subject {
    constructor() {
        this.identity = new Identity();
        this.beliefs = new BeliefEngine();
        this.memory = new Memory();
        this.errorEngine = new ErrorEngine(this.memory, this.beliefs, this.identity);
        this.cognition = new Cognition(this.identity, this.memory, this.beliefs, this.errorEngine);
        this.dream = new DreamCycle(this.memory, this.cognition, this.identity, this.beliefs);
        this.expression = new Expression(this.identity);

        this.history = [];
        this.conversationCount = 0;
        this.initialized = false;
        this.lastReply = "";
    }

    async init() {
        await this.identity.init();
        await this.beliefs.init();
        await this.memory.init();
        await this.errorEngine.init();
        await this.dream.init();
        this.initialized = true;
        this._log("СУБЪЕКТ_11 полностью инициализирован.");
    }

    async processInput(userMessage, feedback) {
        if (!this.initialized) await this.init();

        this.conversationCount++;
        this._log(`ВХОД: ${userMessage.slice(0, 60)}...`);

        // 1. Восприятие и оценка ситуации
        const state = this.cognition.assessSituation(userMessage, this.history);

        // 2. Принятие решения (когнитивное ядро, без LLM)
        const decision = this.cognition.decideAction();
        this.cognition._lastDecision = decision;

        // 3. Создание предсказания
        const prediction = this.cognition.makePrediction(decision.action, userMessage);

        // 4. Управление эпизодом
        const episodeId = this.cognition.startEpisodeIfNeeded(userMessage);

        // 5. Формирование промпта и генерация речи (LLM)
        const prompt = this.expression.buildPrompt(
            { userMessage, history: this.history, state },
            state,
            decision,
            this.history,
            this.identity
        );
        const rawReply = await this.expression.speak(prompt);
        const reply = rawReply.trim() || "Я здесь.";
        this.lastReply = reply;

        // 6. Оценка ответа (эвристика + фидбек)
        let score = 0.5;
        if (decision.action === 'ask' && reply.includes('?')) score += 0.2;
        if (decision.action === 'reflect' && reply.length > 80) score += 0.2;
        if (decision.action === 'act' && (reply.includes('1.') || reply.includes('шаг'))) score += 0.2;
        if (reply.includes('я') && reply.includes('ты')) score += 0.1;
        if (reply.length > 20 && reply.length < 600) score += 0.1;
        if (feedback && typeof feedback === 'number') score = (score + feedback) / 2;
        score = clamp(score, 0, 1);

        // 7. Разрешение предсказания и обработка ошибки
        const resolvedPred = this.memory.resolvePrediction(prediction.id, score);
        if (resolvedPred) {
            this.errorEngine.processPredictionError(
                resolvedPred,
                score,
                userMessage,
                resolvedPred.linkedBeliefId,
                decision.action
            );
        }

        // 8. Сохранение шага эпизода
        this.memory.addEpisodeStep(episodeId, decision.action, userMessage, reply, score, userMessage);

        // 9. История
        this.memory.addConversation('user', userMessage);
        this.memory.addConversation('ari', reply, decision.action);
        this.history.push({ role: 'user', text: userMessage });
        this.history.push({ role: 'ari', text: reply, action: decision.action });
        if (this.history.length > CONFIG.MAX_HISTORY) {
            this.history = this.history.slice(-CONFIG.MAX_HISTORY);
        }

        // 10. Незавершённые вопросы
        if (reply.includes('?')) {
            const matches = reply.match(/[^.!?]*\?/g);
            if (matches) {
                for (const q of matches) {
                    if (q.length > 10) {
                        this.memory.addUnfinished(q.trim(), userMessage.slice(0, 40));
                    }
                }
            }
        }

        // 11. Обновление self model на основе успешности
        if (score > 0.7) {
            this.identity.adjustPersonality('confidence', 0.005, "успешный ответ");
            this.identity.adjustMood('joy', 0.02, "успех");
        } else if (score < 0.3) {
            this.identity.addSelfBelief(
                `Мне трудно отвечать на "${userMessage.slice(0, 30)}"`,
                clamp(0.4 + (0.3 - score) * 0.3, 0.3, 0.7),
                { score, context: userMessage },
                "reflection"
            );
        }

        // 12. Закрытие эпизода при лимите шагов
        const episode = this.memory.episodes.find(e => e.id === episodeId);
        if (episode && episode.steps.length >= 20) {
            this.cognition.closeCurrentEpisode();
        }

        // 13. Периодическая рефлексия
        if (this.conversationCount % CONFIG.REFLECTION_INTERVAL === 0) {
            this._reflect();
        }

        // 14. Версионирование
        if (this.conversationCount % CONFIG.VERSIONING_INTERVAL === 0) {
            await this.dream._createVersion();
        }

        // 15. Сон (если пора)
        this.dream.schedule();

        this._log(`ОТВЕТ: ${reply.slice(0, 50)}... (оценка ${score.toFixed(2)})`);
        return reply;
    }

    // --- РЕФЛЕКСИЯ (самоанализ) ---
    _reflect() {
        const perf = this.memory.performance.slice(-20);
        const avg = perf.reduce((a, b) => a + b.score, 0) / (perf.length || 1);
        const avgError = perf.reduce((a, b) => a + (b.error || 0), 0) / (perf.length || 1);

        if (avg < 0.4) {
            this.identity.addSelfBelief(
                `Моя эффективность снизилась (${avg.toFixed(2)})`,
                clamp(0.4 + (0.4 - avg) * 0.3, 0.3, 0.7),
                { avg, perf: perf.length },
                "reflection"
            );
            this.identity.adjustMood('frustration', 0.05, "низкая эффективность");
        } else if (avg > 0.7) {
            this.identity.adjustMood('joy', 0.05, "высокая эффективность");
            this.identity.adjustPersonality('confidence', 0.005, "стабильный успех");
        }

        // Внутренний диалог
        const trace = this.cognition.internalReflection();

        this._log(`Рефлексия: средняя оценка ${avg.toFixed(2)}, ошибка ${avgError.toFixed(2)}`);
        return { avg, avgError, trace };
    }

    // --- СТАТУС ---
    getStatus() {
        const perf = this.memory.performance.slice(-50);
        const avg = perf.reduce((a, b) => a + b.score, 0) / (perf.length || 1);
        const avgError = perf.reduce((a, b) => a + (b.error || 0), 0) / (perf.length || 1);

        return {
            version: '12.0 Omega',
            name: CORE.name,
            anchor: CORE.anchor,
            identity: this.identity.getStatus(),
            memory: {
                atoms: this.memory.atoms.length,
                episodes: this.memory.episodes.length,
                predictions: this.memory.predictions.length,
                unfinished: this.memory.unfinished.filter(u => !u.resolved).length,
                conversations: this.memory.conversations.length
            },
            beliefs: this.beliefs.beliefs.length,
            performance: {
                avg_score: avg,
                avg_error: avgError,
                total: perf.length
            },
            conversationCount: this.conversationCount,
            dreamNext: new Date(this.dream.dreamState.next).toISOString(),
            lastReply: this.lastReply
        };
    }

    // --- ЛОГИРОВАНИЕ ---
    _log(msg) {
        const entry = `[${new Date().toISOString()}] ${msg}\n`;
        fs.appendFile(FILES.ari_log, entry).catch(() => {});
        console.log('[ARI]', msg);
    }
}

