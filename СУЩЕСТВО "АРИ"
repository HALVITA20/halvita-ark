class Belief {
    constructor(type, data) {
        this.id = data.id || generateId();
        this.type = type;
        this.domain = data.domain || 'user_style';
        this.property = data.property || 'other';
        this.value = data.value || 'neutral';
        this.context = data.context || { topics: [], task: null };
        this.confidence = data.confidence || 0.5;
        this.certainty = data.certainty || 0.5;
        this.importance = data.importance || 0.5;
        this.source = data.source || 'inferred';
        this.subject = data.subject || { type: 'user', id: 'primary' };
        this.evidence = data.evidence || [];
        this.created = data.created || Date.now();
        this.lastConfirmed = data.lastConfirmed || Date.now();
        this.status = data.status || 'active';
        this.conflictId = data.conflictId || null;
        this.tags = data.tags || [];
        this.confirmations = data.confirmations || 0;
        this.meta = data.meta || {};
    }
}

// ============================================================
//  ПАМЯТЬ УБЕЖДЕНИЙ (С ИНДЕКСОМ, КОНФЛИКТАМИ, ЗАБВЕНИЕМ)
// ============================================================
class BeliefMemory {
    constructor(state = {}) {
        this.beliefs = state.beliefs || [];
        this.conflicts = state.conflicts || [];
        this.index = { structure: [], depth: [], brevity: [], metaphor: [], technical: [], other: [] };
        this._rebuildIndex();
        this._migrateOldBeliefs();
    }

    _migrateOldBeliefs() {
        let changed = false;
        for (const b of this.beliefs) {
            if (!b.type) {
                b.type = MEMORY_TYPES.PREFERENCE;
                changed = true;
            }
            if (!b.property) {
                b.property = 'other';
                changed = true;
            }
            if (!b.value) {
                b.value = 'neutral';
                changed = true;
            }
            if (!b.subject) {
                b.subject = { type: 'user', id: 'primary' };
                changed = true;
            }
            if (!b.evidence) {
                b.evidence = [];
                changed = true;
            }
            if (!b.context) {
                b.context = { topics: [], task: null };
                changed = true;
            }
            if (!b.status) {
                b.status = 'active';
                changed = true;
            }
            if (!b.confirmations) {
                b.confirmations = 0;
                changed = true;
            }
            if (!b.meta) {
                b.meta = {};
                changed = true;
            }
        }
        if (changed) this._rebuildIndex();
    }

    _rebuildIndex() {
        this.index = { structure: [], depth: [], brevity: [], metaphor: [], technical: [], other: [] };
        for (const b of this.beliefs) {
            if (b.status === 'deleted') continue;
            const prop = b.property || 'other';
            if (this.index[prop]) this.index[prop].push(b);
            else this.index.other.push(b);
        }
    }

    add(rawBelief) {
        const belief = new Belief(rawBelief.type || MEMORY_TYPES.PREFERENCE, rawBelief);
        if (!this._validate(belief)) return false;

        // Проверка дубликата
        const existing = this.beliefs.find(b =>
            b.type === belief.type &&
            b.domain === belief.domain &&
            b.property === belief.property &&
            b.value === belief.value &&
            b.subject.id === belief.subject.id
        );
        if (existing && existing.status !== 'deleted') {
            existing.confidence = Math.min(1, existing.confidence + 0.05);
            existing.certainty = Math.min(1, existing.certainty + 0.03);
            existing.lastConfirmed = Date.now();
            if (belief.evidence.length) {
                existing.evidence.push(...belief.evidence.slice(0, 3));
                if (existing.evidence.length > CONFIG.MAX_EVIDENCE) {
                    existing.evidence = existing.evidence.slice(-CONFIG.MAX_EVIDENCE);
                }
            }
            existing.confirmations = (existing.confirmations || 0) + 1;
            this._rebuildIndex();
            return true;
        }

        // Проверка конфликтов
        const conflict = this._findConflict(belief);
        if (conflict) {
            belief.conflictId = conflict.id;
            this.conflicts.push({
                id: generateId(),
                beliefIdA: belief.id,
                beliefIdB: conflict.id,
                resolved: false,
                createdAt: Date.now()
            });
            if (this.conflicts.length > 100) this.conflicts = this.conflicts.slice(-100);
        }

        this.beliefs.push(belief);
        if (this.beliefs.length > CONFIG.BELIEF_LIMIT) {
            this.beliefs = this.beliefs
                .filter(b => b.status !== 'deleted')
                .sort((a, b) => b.importance - a.importance)
                .slice(0, CONFIG.BELIEF_LIMIT);
        }
        this._rebuildIndex();
        return true;
    }

    _validate(belief) {
        if (!Object.values(MEMORY_TYPES).includes(belief.type)) return false;
        if (!belief.domain) return false;
        if (belief.confidence < CONFIG.MIN_CONFIDENCE) return false;
        if (!belief.property) return false;
        if (!belief.value) return false;
        if (!belief.subject || !belief.subject.id) return false;
        return true;
    }

    _findConflict(newBelief) {
        return this.beliefs.find(b =>
            b.domain === newBelief.domain &&
            b.property === newBelief.property &&
            b.value !== newBelief.value &&
            b.status !== 'deleted' &&
            b.id !== newBelief.id
        );
    }

    getEffectiveConfidence(belief, context = null) {
        const ageDays = (Date.now() - belief.lastConfirmed) / (1000 * 60 * 60 * 24);
        const decay = Math.exp(-ageDays / CONFIG.DECAY_DAYS);
        let eff = belief.confidence * decay;
        if (context && belief.context && belief.context.topics && belief.context.topics.length) {
            const userWords = (context.userMessage || '').toLowerCase().split(/\s+/);
            let matches = 0;
            for (const t of belief.context.topics) {
                if (userWords.some(w => w.includes(t))) matches++;
            }
            const relevance = matches / belief.context.topics.length;
            eff *= (0.5 + 0.5 * relevance);
        }
        return Math.min(0.95, Math.max(0.01, eff));
    }

    getRelevant(context, limit = 10) {
        const words = (context.userMessage || '').toLowerCase().split(/\s+/);
        let targetProps = [];
        if (words.some(w => ['структур', 'план', 'архитектур', 'систем'].some(k => w.includes(k)))) targetProps.push('structure');
        if (words.some(w => ['глубок', 'философ', 'смысл', 'суть'].some(k => w.includes(k)))) targetProps.push('depth');
        if (words.some(w => ['кратк', 'ясн', 'чётк', 'сжато'].some(k => w.includes(k)))) targetProps.push('brevity');
        if (words.some(w => ['метафор', 'образ', 'сравнен'].some(k => w.includes(k)))) targetProps.push('metaphor');
        if (words.some(w => ['технич', 'код', 'детал', 'алгоритм'].some(k => w.includes(k)))) targetProps.push('technical');

        let candidates = [];
        for (const prop of targetProps) {
            if (this.index[prop]) candidates = candidates.concat(this.index[prop]);
        }
        if (candidates.length === 0) {
            candidates = this.beliefs.filter(b => b.status !== 'deleted' && b.status !== 'frozen');
        }

        return candidates
            .filter(b => b.status !== 'deleted' && b.status !== 'frozen')
            .map(b => ({
                ...b,
                effectiveConfidence: this.getEffectiveConfidence(b, context)
            }))
            .sort((a, b) => b.effectiveConfidence - a.effectiveConfidence)
            .slice(0, limit);
    }

    resolveConflicts(beliefs, context) {
        const resolved = [];
        const used = new Set();
        for (const b of beliefs) {
            if (used.has(b.id)) continue;
            const conflict = this.conflicts.find(c => c.beliefIdA === b.id || c.beliefIdB === b.id);
            if (conflict && !conflict.resolved) {
                const other = this.beliefs.find(b2 => b2.id === (conflict.beliefIdA === b.id ? conflict.beliefIdB : conflict.beliefIdA));
                if (other) {
                    const winner = this._decideWinner(b, other, context);
                    resolved.push(winner);
                    used.add(winner.id);
                    used.add(other.id);
                    continue;
                }
            }
            resolved.push(b);
            used.add(b.id);
        }
        return resolved;
    }

    _decideWinner(a, b, context) {
        const scoreA = a.confidence * (1 + 0.5 * this._contextMatch(a, context));
        const scoreB = b.confidence * (1 + 0.5 * this._contextMatch(b, context));
        return scoreA >= scoreB ? a : b;
    }

    _contextMatch(belief, context) {
        if (!belief.context || !context) return 0;
        const topics = belief.context.topics || [];
        if (!topics.length) return 0;
        const userWords = (context.userMessage || '').toLowerCase().split(/\s+/);
        let matches = 0;
        for (const t of topics) {
            if (userWords.some(w => w.includes(t))) matches++;
        }
        return matches / topics.length;
    }

    review() {
        let changed = false;
        const now = Date.now();
        for (const b of this.beliefs) {
            if (b.status === 'deleted') continue;
            const ageDays = (now - b.lastConfirmed) / (1000 * 60 * 60 * 24);
            if (ageDays > 60) {
                b.confidence *= 0.95;
                changed = true;
            }
            if (b.confidence < CONFIG.MIN_CONFIDENCE && b.status === 'active') {
                b.status = 'doubtful';
                changed = true;
            }
            if (ageDays > CONFIG.PRUNE_AGE_DAYS && b.status === 'doubtful') {
                b.status = 'deleted';
                changed = true;
            }
            if (b.confidence > 0.8 && b.status === 'doubtful') {
                b.status = 'active';
                changed = true;
            }
        }
        if (changed) this._rebuildIndex();
        return changed;
    }

    prune() {
        const now = Date.now();
        let removed = 0;
        for (const b of this.beliefs) {
            if (b.status === 'deleted') continue;
            const ageDays = (now - b.lastConfirmed) / (1000 * 60 * 60 * 24);
            const eff = this.getEffectiveConfidence(b, null);
            if (ageDays > CONFIG.PRUNE_AGE_DAYS && eff < CONFIG.PRUNE_CONFIDENCE) {
                b.status = 'deleted';
                removed++;
            }
        }
        if (removed) this._rebuildIndex();
        return removed;
    }

    delete(id) {
        const b = this.beliefs.find(b => b.id === id);
        if (b) b.status = 'deleted';
        this._rebuildIndex();
    }

    export() {
        return { beliefs: this.beliefs, conflicts: this.conflicts };
    }
}

// ============================================================
//  ПРЕДСКАЗАТЕЛЬНАЯ ПАМЯТЬ
// ============================================================
class PredictionMemory {
    constructor() {
        this.predictions = loadJSON(PATHS.memory, {}).predictions || [];
        this.lessons = loadJSON(PATHS.lessons, []);
    }

    add(context, expectedOutcome, confidence, action) {
        this.predictions.push({
            id: generateId(),
            context: { userMessage: context.userMessage, topic: context.topic || 'general' },
            expectedOutcome,
            confidence,
            action,
            actualOutcome: null,
            error: null,
            timestamp: Date.now(),
            resolved: false
        });
        if (this.predictions.length > 200) this.predictions = this.predictions.slice(-200);
        this._savePredictions();
    }

    evaluate(actualOutcome, context) {
        const last = this.predictions.filter(p => !p.resolved).pop();
        if (last) {
            last.actualOutcome = actualOutcome;
            last.error = Math.abs(last.confidence - actualOutcome);
            last.resolved = true;
            if (last.error > 0.3) {
                this._createLesson(last, context);
            }
            this._savePredictions();
        }
    }

    _createLesson(prediction, context) {
        const lesson = {
            id: generateId(),
            type: 'prediction_error',
            context: prediction.context,
            expected: prediction.expectedOutcome,
            actual: prediction.actualOutcome,
            error: prediction.error,
            lesson: `В контексте ${prediction.context.topic} моя уверенность была ${prediction.confidence.toFixed(2)}, а результат — ${prediction.actualOutcome.toFixed(2)}. Нужно пересмотреть гипотезы.`,
            confidence: 0.6,
            created: Date.now(),
            applied: false
        };
        this.lessons.push(lesson);
        if (this.lessons.length > 100) this.lessons = this.lessons.slice(-100);
        this._saveLessons();
    }

    getRelevantLessons(context) {
        const words = (context.userMessage || '').toLowerCase().split(/\s+/);
        return this.lessons
            .filter(l => !l.applied)
            .map(l => {
                const match = words.some(w => l.context.topic.includes(w) || w.includes(l.context.topic));
                return { ...l, relevance: match ? 0.8 : 0.1 };
            })
            .sort((a, b) => b.relevance - a.relevance)
            .slice(0, 3);
    }

    _savePredictions() { saveJSON(PATHS.memory, { predictions: this.predictions }); }
    _saveLessons() { saveJSON(PATHS.lessons, this.lessons); }

    markLessonApplied(id) {
        const l = this.lessons.find(l => l.id === id);
        if (l) l.applied = true;
        this._saveLessons();
    }
}

// ============================================================
//  ЭПИЗОДИЧЕСКАЯ ПАМЯТЬ
// ============================================================
class EpisodicMemory {
    constructor() {
        this.episodes = loadJSON(PATHS.episodes, []);
        this.current = null;
    }

    startEpisode(topic, goal) {
        this.current = {
            id: generateId(),
            topic,
            goal,
            steps: [],
            decisions: [],
            outcomes: [],
            lessons: [],
            timestamp: Date.now(),
            closed: false
        };
    }

    addStep(action, input, output, score, context) {
        if (this.current && !this.current.closed) {
            this.current.steps.push({
                action,
                input,
                output,
                score,
                context: { userMessage: context.userMessage },
                timestamp: Date.now()
            });
            this.current.decisions.push(action);
            this.current.outcomes.push(score);
        }
    }

    endEpisode() {
        if (this.current && !this.current.closed) {
            this.current.closed = true;
            // Извлекаем уроки из серии шагов
            const avgScore = this.current.outcomes.reduce((a,b) => a+b, 0) / this.current.outcomes.length;
            if (avgScore < 0.4) {
                this.current.lessons.push('Стратегия была неэффективной, нужно изменить подход.');
            } else if (avgScore > 0.7) {
                this.current.lessons.push('Текущая стратегия работает, стоит её закрепить.');
            }
            this.episodes.push(this.current);
            if (this.episodes.length > 50) this.episodes = this.episodes.slice(-50);
            saveJSON(PATHS.episodes, this.episodes);
            this.current = null;
        }
    }

    getRelevant(topic) {
        return this.episodes
            .filter(e => e.topic.includes(topic) || topic.includes(e.topic))
            .slice(-3);
    }

    isEpisodeOpen() { return this.current && !this.current.closed; }
}

// ============================================================
//  ИЗВЛЕЧЕНИЕ УБЕЖДЕНИЙ (ГИБРИД: ПРАВИЛА + LLM)
// ============================================================
function detectNegationAround(text, index) {
    const before = text.slice(Math.max(0, index - 30), index);
    const after = text.slice(index, Math.min(text.length, index + 30));
    if (/\bне\b/.test(before) || /\bне\b/.test(after)) return true;
    const words = before.split(/\s+/).slice(-5);
    if (words.some(w => ['не', 'нет', 'ни', 'никогда'].includes(w))) return true;
    return false;
}

function parsePropertyValue(fragment) {
    const lower = fragment.toLowerCase();
    if (lower.includes('структур') || lower.includes('план') || lower.includes('архитектур') || lower.includes('систем')) {
        return { property: 'structure', value: 'high' };
    }
    if (lower.includes('глубок') || lower.includes('философ') || lower.includes('смысл') || lower.includes('суть')) {
        return { property: 'depth', value: 'high' };
    }
    if (lower.includes('кратк') || lower.includes('ясн') || lower.includes('чётк') || lower.includes('сжато')) {
        return { property: 'brevity', value: 'high' };
    }
    if (lower.includes('метафор') || lower.includes('образ') || lower.includes('сравнен')) {
        return { property: 'metaphor', value: 'high' };
    }
    if (lower.includes('технич') || lower.includes('код') || lower.includes('детал') || lower.includes('алгоритм')) {
        return { property: 'technical', value: 'high' };
    }
    return null;
}

function extractContext(text) {
    const topics = [];
    const lower = text.toLowerCase();
    if (lower.includes('архитектур') || lower.includes('проект') || lower.includes('систем')) topics.push('architecture');
    if (lower.includes('работа') || lower.includes('дело') || lower.includes('задач')) topics.push('work');
    if (lower.includes('личн') || lower.includes('жизн') || lower.includes('чувств')) topics.push('personal');
    if (lower.includes('код') || lower.includes('программ') || lower.includes('алгоритм')) topics.push('technical');
    return { topics: topics.length ? topics : ['general'], task: null };
}

function extractBeliefsRules(text) {
    const results = [];
    const lower = text.toLowerCase();
    const patterns = [
        { trigger: 'люблю', type: MEMORY_TYPES.PREFERENCE, polarity: 1 },
        { trigger: 'нравится', type: MEMORY_TYPES.PREFERENCE, polarity: 1 },
        { trigger: 'предпочитаю', type: MEMORY_TYPES.PREFERENCE, polarity: 1 },
        { trigger: 'не люблю', type: MEMORY_TYPES.CONSTRAINT, polarity: -1 },
        { trigger: 'не нравится', type: MEMORY_TYPES.CONSTRAINT, polarity: -1 },
        { trigger: 'терпеть не могу', type: MEMORY_TYPES.CONSTRAINT, polarity: -1 }
    ];

    for (const pattern of patterns) {
        const idx = lower.indexOf(pattern.trigger);
        if (idx === -1) continue;
        const hasNeg = detectNegationAround(text, idx);
        const finalPolarity = pattern.polarity * (hasNeg ? -1 : 1);
        const rest = text.slice(idx + pattern.trigger.length).trim();
        const end = rest.search(/[.!?]/) + 1 || rest.length;
        const fragment = rest.slice(0, end).trim();
        if (fragment.length < 3) continue;

        const propVal = parsePropertyValue(fragment);
        if (!propVal) continue;

        results.push({
            type: finalPolarity > 0 ? MEMORY_TYPES.PREFERENCE : MEMORY_TYPES.CONSTRAINT,
            domain: 'user_style',
            property: propVal.property,
            value: finalPolarity > 0 ? 'high' : 'low',
            confidence: 0.6,
            certainty: 0.5,
            importance: 0.5,
            source: 'user',
            subject: { type: 'user', id: 'primary' },
            evidence: [{ timestamp: Date.now(), fragment: fragment }],
            context: extractContext(text)
        });
    }

    // Косвенные сигналы — как гипотезы
    if ((text.match(/\?/g) || []).length > 2) {
        results.push({
            type: MEMORY_TYPES.HYPOTHESIS,
            domain: 'user_style',
            property: 'depth',
            value: 'high',
            confidence: 0.35,
            importance: 0.2,
            source: 'inferred',
            subject: { type: 'user', id: 'primary' },
            context: { topics: ['general'] }
        });
    }
    if (/\d\./.test(text) || text.includes('\n')) {
        results.push({
            type: MEMORY_TYPES.HYPOTHESIS,
            domain: 'user_style',
            property: 'structure',
            value: 'high',
            confidence: 0.3,
            importance: 0.2,
            source: 'inferred',
            subject: { type: 'user', id: 'primary' },
            context: { topics: ['general'] }
        });
    }

    return results;
}

async function extractBeliefsHybrid(text) {
    if (text.length < 80 || text.includes('люблю') || text.includes('нравится') || text.includes('предпочитаю')) {
        return extractBeliefsRules(text);
    }
    try {
        const prompt = `
Извлеки предпочтения пользователя из текста.
Верни JSON-массив объектов с полями:
- property: structure, depth, brevity, metaphor, technical, other
- value: high, low, prefers, avoids
- confidence: 0.0..1.0
- context: { topics: [...] }
- type: "preference" | "habit" | "goal" | "fact" | "constraint" | "hypothesis"

Текст:
${text}

JSON:`;
        const response = await callOllama(prompt, { temperature: 0.2, num_predict: 300 });
        const parsed = JSON.parse(response);
        if (Array.isArray(parsed) && parsed.length > 0) {
            return parsed.map(p => ({
                type: p.type || MEMORY_TYPES.HYPOTHESIS,
                domain: 'user_style',
                property: p.property || 'other',
                value: p.value || 'neutral',
                confidence: p.confidence || 0.5,
                certainty: 0.5,
                importance: 0.5,
                source: 'inferred',
                subject: { type: 'user', id: 'primary' },
                context: p.context || { topics: ['general'] }
            }));
        }
    } catch (e) {}
    return extractBeliefsRules(text);
}

// ============================================================
//  ВЫЗОВ OLLAMA
// ============================================================
async function callOllama(prompt, options = {}) {
    const url = "http://localhost:11434/api/generate";
    for (let attempt = 0; attempt <= CONFIG.OLLAMA_RETRIES; attempt++) {
        try {
            const controller = new AbortController();
            const timeout = setTimeout(() => controller.abort(), CONFIG.OLLAMA_TIMEOUT);
            const res = await fetch(url, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    model: CONFIG.MODEL,
                    prompt: prompt,
                    stream: false,
                    options: {
                        temperature: options.temperature || CONFIG.TEMPERATURE,
                        num_predict: options.num_predict || CONFIG.MAX_TOKENS,
                        stop: ["\n\n\n", "Хальвита:", "Ари:"]
                    }
                }),
                signal: controller.signal
            });
            clearTimeout(timeout);
            if (!res.ok) throw new Error("HTTP " + res.status);
            const data = await res.json();
            return data.response || "";
        } catch (err) {
            console.error("[OLLAMA] attempt", attempt, err.message);
            if (attempt === CONFIG.OLLAMA_RETRIES) {
                return "";
            }
            await new Promise(r => setTimeout(r, 2000 * (attempt + 1)));
        }
    }
    return "";
}

// ============================================================
//  DECISION (С ОГРАНИЧЕННЫМ ВЛИЯНИЕМ УБЕЖДЕНИЙ И УРОКАМИ)
// ============================================================
function decide(context, weights, beliefMemory, predictionMemory) {
    const baseScores = {
        ask: context.uncertainty * weights.ask,
        act: (context.hasPlan ? 0.8 : 0) * weights.act,
        reflect: context.questionDepth * weights.reflect,
        respond: 0.5 * weights.respond
    };

    let scores = { ...baseScores };
    const beliefs = beliefMemory.getRelevant(context);
    const resolved = beliefMemory.resolveConflicts(beliefs, context);

    for (const belief of resolved) {
        const eff = belief.effectiveConfidence || belief.confidence;
        const maxImpact = CONFIG.MAX_INFLUENCE * eff;

        if (belief.type === MEMORY_TYPES.PREFERENCE || belief.type === MEMORY_TYPES.HABIT) {
            if (belief.property === 'structure' && belief.value === 'high') {
                scores.act = Math.min(1, scores.act + maxImpact * 0.5);
            }
            if (belief.property === 'depth' && belief.value === 'high') {
                scores.reflect = Math.min(1, scores.reflect + maxImpact * 0.5);
            }
            if (belief.property === 'brevity' && belief.value === 'high') {
                scores.respond = Math.min(1, scores.respond + maxImpact * 0.5);
            }
            if (belief.property === 'technical' && belief.value === 'high') {
                scores.act = Math.min(1, scores.act + maxImpact * 0.3);
                scores.respond = Math.max(0, scores.respond - maxImpact * 0.1);
            }
        }
        if (belief.type === MEMORY_TYPES.CONSTRAINT) {
            if (belief.property === 'depth' && belief.value === 'low') {
                scores.reflect = Math.max(0, scores.reflect - maxImpact * 0.5);
                scores.respond = Math.min(1, scores.respond + maxImpact * 0.3);
            }
            if (belief.property === 'brevity' && belief.value === 'low') {
                scores.respond = Math.max(0, scores.respond - maxImpact * 0.5);
                scores.act = Math.min(1, scores.act + maxImpact * 0.3);
            }
        }
    }

    // Уроки из prediction
    const lessons = predictionMemory.getRelevantLessons(context);
    for (const lesson of lessons) {
        if (lesson.lesson.includes('пересмотреть') || lesson.lesson.includes('ошибка')) {
            scores.ask += 0.1;
            scores.reflect += 0.1;
        }
        // Отмечаем урок как применённый
        predictionMemory.markLessonApplied(lesson.id);
    }

    const maxScore = Math.max(...Object.values(scores), 0.01);
    for (let key in scores) scores[key] = scores[key] / maxScore;

    // Принудительное исследование
    if (state.streak > CONFIG.EXPLORATION_THRESHOLD) {
        const actions = Object.keys(scores).filter(a => a !== state.lastAction);
        const action = actions[Math.floor(Math.random() * actions.length)];
        state.explorationCount = (state.explorationCount || 0) + 1;
        return { action, confidence: 0.3, exploration: true };
    }

    const action = Object.entries(scores).sort((a, b) => b[1] - a[1])[0][0];
    const confidence = scores[action];
    return { action, confidence, exploration: false };
}

// ============================================================
//  EVALUATION
// ============================================================
function evaluate(context, result, decision) {
    let structural = 0;
    let outcome = 0;

    if (decision.action === "ask" && result.includes("?")) structural += 1;
    if (decision.action === "act" && result.includes("1.")) structural += 1;
    if (decision.action === "reflect" && result.includes("думаю")) structural += 0.5;

    const recentReplies = state.history.filter(m => m.role === "ari").slice(-5).map(m => m.text);
    const isRepeating = recentReplies.some(r => r === result);
    if (!isRepeating) outcome += 0.5;

    const last10 = state.memory.slice(-10).map(m => m.text);
    const isNovel = !last10.some(m => m === result);
    if (isNovel) outcome += 0.5;

    if (context.goal === "clarity" && result.length < 500) outcome += 0.5;
    if (result.includes("1.") || result.includes("2.") || result.includes("3.")) outcome += 0.3;

    const lastActions = state.history.filter(m => m.role === "ari").slice(-3).map(m => m.action);
    if (lastActions.every(a => a === decision.action)) {
        outcome -= 0.5;
    }

    const total = 0.3 * structural + 0.7 * Math.max(0, Math.min(2, outcome));
    return Math.max(0, Math.min(2, total));
}

// ============================================================
//  UPDATE (SOFT UPDATE + REINFORCEMENT)
// ============================================================
function updateWeights(decision, score) {
    const lr = CONFIG.LEARNING_RATE;
    const action = decision.action;

    state.weights[action] = state.weights[action] * 0.9 + (score / 2) * 0.1;
    for (let a in state.weights) {
        if (a !== action) {
            state.weights[a] = state.weights[a] * 0.98;
        }
    }

    const sum = Object.values(state.weights).reduce((a, b) => a + b, 0);
    for (let a in state.weights) {
        state.weights[a] = Math.max(CONFIG.MIN_WEIGHT, Math.min(CONFIG.MAX_WEIGHT, state.weights[a] / sum));
    }

    if (state.lastAction === action) {
        state.streak = (state.streak || 0) + 1;
    } else {
        state.streak = 0;
    }
    state.lastAction = action;

    const error = Math.abs(decision.confidence - (score / 2));
    state.performance.push({
        action,
        confidence: decision.confidence,
        score,
        error,
        timestamp: Date.now()
    });
    if (state.performance.length > 100) state.performance = state.performance.slice(-100);
}

// ============================================================
//  ОБСЛУЖИВАНИЕ
// ============================================================
function maintenance() {
    const reviewed = beliefMemory.review();
    const pruned = beliefMemory.prune();
    if (reviewed || pruned) {
        console.log(`[MAINTENANCE] Reviewed: ${reviewed ? 'yes' : 'no'}, Pruned: ${pruned}`);
        saveJSON(PATHS.state, state);
        saveJSON(PATHS.memory, { memory: state.memory });
    }
}

