javascript
// memory/beliefs.js

class BeliefMemory {
    constructor() {
        this.beliefs = [];
        this.index = {
            structure: [],
            depth: [],
            brevity: [],
            metaphor: [],
            technical: [],
            other: []
        };
    }

    _indexBelief(belief) {
        const prop = belief.property || 'other';
        if (this.index[prop]) {
            this.index[prop].push(belief);
        } else {
            this.index.other.push(belief);
        }
    }

    getRelevant(context, limit = 10) {
        const words = context.userMessage.toLowerCase().split(/\s+/);

        // Определяем, какие категории активировать
        let targetProperties = [];
        if (words.some(w => ['структур', 'план', 'архитектур', 'систем'].some(k => w.includes(k)))) {
            targetProperties.push('structure');
        }
        if (words.some(w => ['глубок', 'философ', 'смысл', 'суть'].some(k => w.includes(k)))) {
            targetProperties.push('depth');
        }
        if (words.some(w => ['кратк', 'ясн', 'чётк', 'сжато'].some(k => w.includes(k)))) {
            targetProperties.push('brevity');
        }
        if (words.some(w => ['метафор', 'образ', 'сравнен'].some(k => w.includes(k)))) {
            targetProperties.push('metaphor');
        }
        if (words.some(w => ['технич', 'код', 'детал', 'алгоритм'].some(k => w.includes(k)))) {
            targetProperties.push('technical');
        }

        // Собираем кандидаты только из актуальных категорий
        let candidates = [];
        for (const prop of targetProperties) {
            if (this.index[prop]) {
                candidates = candidates.concat(this.index[prop]);
            }
        }
        // Если ничего не подошло, берём все активные
        if (candidates.length === 0) {
            candidates = this.beliefs.filter(b => b.status !== 'deleted');
        }

        // Оцениваем и сортируем
        return candidates
            .filter(b => b.status !== 'deleted')
            .map(b => ({
                ...b,
                effectiveConfidence: this.getEffectiveConfidence(b, context)
            }))
            .sort((a, b) => b.effectiveConfidence - a.effectiveConfidence)
            .slice(0, limit);
    }
}
