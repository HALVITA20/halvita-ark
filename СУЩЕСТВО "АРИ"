            history: [],
            last_update: null
        });
    }

    adjust(trait, delta) {
        if (this.data.traits[trait] !== undefined) {
            this.data.traits[trait] = Math.max(0, Math.min(1, this.data.traits[trait] + delta));
            this.data.history.push({ trait, delta, timestamp: Date.now() });
            if (this.data.history.length > 200) this.data.history = this.data.history.slice(-200);
            saveJSON(FILES.character, this.data);
        }
    }

    get() {
        return this.data.traits;
    }
}

