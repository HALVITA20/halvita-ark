class SelfModel {
    constructor() {
        this.data = loadJSON(FILES.self_model, {
            patterns: [],
            identity_tensions: {},
            blindspots: [],
            confidence_history: [],
            last_update: null
        });
    }

    addPattern(name, description, confidence = 0.4) {
        const existing = this.data.patterns.find(p => p.name === name);
        if (existing) {
            existing.confidence = Math.min(1, existing.confidence + 0.05);
            existing.detected = (existing.detected || 0) + 1;
            existing.last_detected = Date.now();
        } else {
            this.data.patterns.push({
                name,
                description,
                confidence,
                detected: 1,
                correction: null,
                created: Date.now(),
                last_detected: Date.now()
            });
        }
        this._save();
    }

    addBlindspot(area, evidence) {
        const existing = this.data.blindspots.find(b => b.area === area);
        if (existing) {
            existing.confidence = Math.min(1, existing.confidence + 0.1);
            existing.evidence.push(evidence);
            existing.last_updated = Date.now();
        } else {
            this.data.blindspots.push({
                area,
                confidence: 0.4,
                evidence: [evidence],
                created: Date.now(),
                last_updated: Date.now()
            });
        }
        this._save();
    }

    setTension(a, b, value) {
        const key = `${a}_vs_${b}`;
        this.data.identity_tensions[key] = { a, b, value, updated: Date.now() };
        this._save();
    }

    getTensions() {
        return Object.values(this.data.identity_tensions);
    }

    getRelevantPatterns(context) {
        const words = (context || '').toLowerCase().split(/\s+/);
        return this.data.patterns
            .filter(p => {
                const desc = p.description.toLowerCase();
                return words.some(w => desc.includes(w) || w.includes(desc.slice(0, 5)));
            })
            .sort((a, b) => b.confidence - a.confidence)
            .slice(0, 3);
    }

    _save() {
        this.data.last_update = Date.now();
        saveJSON(FILES.self_model, this.data);
    }
}

