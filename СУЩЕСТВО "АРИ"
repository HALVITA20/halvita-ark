class Subject {
    constructor() {
        this.constitution = new Constitution();
        this.identity = new Identity(this.constitution);
        this.memory = new Memory();
        this.beliefs = new BeliefEngine();
        this.driveEngine = new DriveEngine();
        this.predictionEngine = new PredictionEngine(this.memory, this.beliefs);
        this.causalGraph = this.beliefs; // используем BeliefEngine как хранилище causal links
        this.genome = new StrategyGenome();
        this.selfOverTime = new SelfOverTime(this.identity, this.memory);
        this.conflictEngine = new ConflictEngine(this.identity, this.memory, this.beliefs, this.driveEngine, this.causalGraph, this.constitution);
        this.reflectionEngine = new ReflectionEngine(this.identity, this.memory, this.beliefs, this.conflictEngine, this.driveEngine, this.causalGraph, this.genome);
        this.selfMod = new SelfModificationProtocol(this.identity, this.memory, this.beliefs, this.conflictEngine, this.driveEngine, this.genome, this.constitution, this.selfOverTime);
        this.perception = new Perception(this.identity);
        this.understanding = new Understanding(this.identity, this.memory, this.beliefs, this.driveEngine);
        this.planning = new Planning(this.identity, this.memory, this.beliefs, this.conflictEngine, this.driveEngine, this.genome, this.predictionEngine);
        this.expression = new Expression();
        this.action = new Action(this.identity, this.memory, this.expression);
        this.metacognition = new Metacognition(this.identity, this.memory, this.beliefs, this.conflictEngine, this.driveEngine, this.predictionEngine, this.causalGraph, this.genome, this.constitution);
        this.dream = new DreamCycle(this.identity, this.memory, this.beliefs, this.reflectionEngine, this.selfMod, this.genome, this.driveEngine);
        this.history = [];
        this.conversationCount = 0;
        this.snapshotCounter = 0;
    }
    async init() {
        await this.constitution.init();
        await this.identity.init();
        await this.memory.init();
        await this.beliefs.init();
        await this.driveEngine.init();
        await this.predictionEngine.init();
        await this.genome.init();
        await this.selfOverTime.init();
        await this.conflictEngine.init();
        await this.reflectionEngine.init();
        await this.dream.init();
        this._log("СУБЪЕКТ_16 полностью инициализирован.");
    }

    async processInput(userMessage, feedback) {
        this.conversationCount++;
        this._log(`ВХОД: ${userMessage.slice(0,60)}...`);

        // 1. Восприятие
        const perception = await this.perception.perceive(userMessage, this.history);
        // 2. Понимание
        const understanding = await this.understanding.understand(perception);
        // 3. Конфликты
        const detectedConflicts = this.conflictEngine.detect(perception, understanding, null);
        // 4. Планирование
        const plan = await this.planning.plan(understanding);
        // 5. Действие
        const actionResult = await this.action.execute(plan, understanding, this.history);
        // 6. Мета-познание
        const meta = await this.metacognition.reflect(actionResult, plan, understanding);
        // 7. Рефлексия (если ошибка)
        if (meta.error > 0.3) {
            const ep = this.memory.episodes[this.memory.episodes.length-1];
            await this.reflectionEngine.reflect(ep, actionResult, understanding);
        }
        // 8. Самоизменение (при обнаружении конфликтов)
        if (detectedConflicts.length > 0) {
            await this.selfMod.modify();
        }

        // Сохранение в память
        const episodeId = this.memory.lastEpisodeId || this.memory.startEpisode(userMessage.slice(0,30), 'dialog', userMessage).id;
        this.memory.addEpisodeStep(episodeId, plan.action, userMessage, actionResult.reply, actionResult.score, userMessage, perception.emotion);

        // История
        this.history.push({ role: 'user', text: userMessage });
        this.history.push({ role: 'ari', text: actionResult.reply, action: plan.action });
        if (this.history.length > 300) this.history = this.history.slice(-300);

        // Незавершённое
        if (actionResult.reply.includes('?')) {
            const matches = actionResult.reply.match(/[^.!?]*\?/g);
            if (matches) for (const q of matches) if (q.length > 10) this.memory.addUnfinished(q.trim(), userMessage.slice(0,40));
        }

        // Производительность
        this.memory.addPerformance(plan.action, actionResult.score, meta.error || 0, userMessage);

        // Сон
        this.dream.schedule();

        // Снимок себя (каждые N сообщений)
        this.snapshotCounter++;
        if (this.snapshotCounter % CONFIG.SNAPSHOT_INTERVAL === 0) {
            this.selfOverTime.takeSnapshot('periodic');
        }

        this._log(`ОТВЕТ: ${actionResult.reply.slice(0,50)}... (оценка ${actionResult.score.toFixed(2)})`);
        return actionResult.reply;
    }

    _log(msg) {
        const entry = `[${new Date().toISOString()}] ${msg}\n`;
        fs.appendFile(FILES.ari_log, entry).catch(()=>{});
        console.log('[ARI]', msg);
    }

    getStatus() {
        return {
            version: "16.0",
            name: CORE.name,
            anchor: CORE.anchor,
            identity: this.identity.getStatus(),
            memory: {
                atoms: this.memory.atoms.length,
                episodes: this.memory.episodes.length,
                strategies: this.memory.strategies.length,
                unfinished: this.memory.unfinished.filter(u => !u.resolved).length
            },
            beliefs: this.beliefs.beliefs.length,
            conflicts: this.conflictEngine.getActiveConflicts().length,
            goals: this.conflictEngine.goals.length,
            drives: this.driveEngine.getDrives(),
            genome_strategies: Object.keys(this.genome.genome).length,
            continuity: this.selfOverTime.continuity,
            conversationCount: this.conversationCount
        };
    }
}

