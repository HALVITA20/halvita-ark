class Subject {
    constructor() {
        this.identity = new Identity();
        this.memory = new Memory();
        this.beliefs = new BeliefEngine();
        this.perception = new Perception(this.identity);
        this.understanding = new Understanding(this.identity, this.memory, this.beliefs);
        this.expression = new Expression();
        this.planning = new Planning(this.identity, this.memory, this.beliefs);
        this.action = new Action(this.identity, this.memory, this.expression);
        this.metacognition = new Metacognition(this.identity, this.memory, this.beliefs);
        this.dream = new DreamCycle(this.identity, this.memory, this.beliefs);
        this.internalDialog = new InternalDialog(this.identity, this.memory, this.beliefs);
        this.history = [];
        this.conversationCount = 0;
    }
    async init() {
        await this.identity.init();
        await this.memory.init();
        await this.beliefs.init();
        await this.dream.init();
        this.internalDialog.start();
        this._log("СУБЪЕКТ_14 полностью инициализирован.");
    }

    async processInput(userMessage, feedback) {
        this.conversationCount++;
        this._log(`ВХОД: ${userMessage.slice(0,60)}...`);

        // 1. Восприятие
        const perception = await this.perception.perceive(userMessage, this.history);

        // 2. Понимание
        const understanding = await this.understanding.understand(perception);

        // 3. Планирование
        const plan = await this.planning.plan(understanding);

        // 4. Действие (выполнение)
        const actionResult = await this.action.execute(plan, understanding, this.history);

        // 5. Мета-познание (рефлексия)
        const meta = await this.metacognition.reflect(actionResult, plan, understanding);

        // 6. Сохранение в память
        this.memory.addEpisodeStep(
            this.memory.lastEpisodeId || this.memory.startEpisode(userMessage.slice(0,30), 'dialog', userMessage).id,
            plan.action,
            userMessage,
            actionResult.reply,
            actionResult.score,
            userMessage
        );

        // 7. История
        this.history.push({ role: 'user', text: userMessage });
        this.history.push({ role: 'ari', text: actionResult.reply, action: plan.action });
        if (this.history.length > 300) this.history = this.history.slice(-300);

        // 8. Незавершённое
        if (actionResult.reply.includes('?')) {
            const matches = actionResult.reply.match(/[^.!?]*\?/g);
            if (matches) for (const q of matches) {
                if (q.length > 10) this.memory.addUnfinished(q.trim(), userMessage.slice(0,40));
            }
        }

        // 9. Обновление производительности
        this.memory.addPerformance(plan.action, actionResult.score, meta.error || 0, userMessage);

        // 10. Сон
        this.dream.schedule();

        this._log(`ОТВЕТ: ${actionResult.reply.slice(0,50)}... (оценка ${actionResult.score.toFixed(2)})`);
        return actionResult.reply;
    }

    _log(msg) {
        const entry = `[${new Date().toISOString()}] ${msg}\n`;
        fs.appendFile(FILES.ari_log, entry).catch(()=>{});
        console.log('[ARI]', msg);
    }

    getStatus() {
        return {
            version: "14.0",
            name: CORE.name,
            anchor: CORE.anchor,
            identity: this.identity.getStatus(),
            memory: {
                atoms: this.memory.atoms.length,
                episodes: this.memory.episodes.length,
                strategies: this.memory.strategies.length,
                unfinished: this.memory.unfinished.filter(u => !u.resolved).length
            },
            beliefs: this.beliefs.beliefs.length,
            conversationCount: this.conversationCount
        };
    }
}

