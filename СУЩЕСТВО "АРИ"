        });
        this.goals = loadJSON(FILES.goals, {
            current: "понимание пользователя",
            long_term: [],
            short_term: [],
            last_update: null
        });
        this.unfinished = loadJSON(FILES.unfinished, []);
        this.weights = loadJSON(FILES.weights, {
            ask: 0.5, act: 0.5, reflect: 0.5, respond: 0.5
        });
        this.performance = loadJSON(FILES.performance, []);
        this.streak = 0;
        this.lastAction = null;
        this.totalAttempts = 0;
        this.version = 0;
    }

    updateEmotional(updates) {
        for (let k in updates) {
            if (this.emotional[k] !== undefined) {
                this.emotional[k] = Math.max(0, Math.min(1, updates[k]));
            }
        }
        this.emotional.last_update = Date.now();
        saveJSON(FILES.emotional, this.emotional);
    }

    updateAttention(updates) {
        for (let k in updates) {
            if (this.attention[k] !== undefined) {
                this.attention[k] = updates[k];
            }
        }
        this.attention.last_update = Date.now();
        saveJSON(FILES.attention, this.attention);
    }

    addUnfinished(text, context = '') {
        const q = { id: crypto.randomUUID(), text, context, created: Date.now(), resolved: false };
        this.unfinished.push(q);
        if (this.unfinished.length > 50) this.unfinished = this.unfinished.slice(-50);
        saveJSON(FILES.unfinished, this.unfinished);
    }

    resolveUnfinished(id) {
        const q = this.unfinished.find(u => u.id === id);
        if (q) q.resolved = true;
        saveJSON(FILES.unfinished, this.unfinished);
    }

    getActiveUnfinished() {
        return this.unfinished.filter(u => !u.resolved);
    }

    updateWeights(action, score) {
        const lr = CONFIG.LEARNING_RATE;
        this.weights[action] = this.weights[action] * 0.9 + (score / 2) * 0.1;
        for (let a in this.weights) {
            if (a !== action) this.weights[a] *= 0.98;
        }
        const sum = Object.values(this.weights).reduce((a,b) => a+b, 0);
        for (let a in this.weights) {
            this.weights[a] = Math.max(0.1, Math.min(0.9, this.weights[a] / sum));
        }
        if (this.lastAction === action) this.streak += 1;
        else this.streak = 0;
        this.lastAction = action;
        const error = Math.abs((score / 2) - 0.5);
        this.performance.push({ action, score, error, timestamp: Date.now() });
        if (this.performance.length > 100) this.performance = this.performance.slice(-100);
        saveJSON(FILES.weights, this.weights);
        saveJSON(FILES.performance, this.performance);
    }

    save() {
        saveJSON(FILES.emotional, this.emotional);
        saveJSON(FILES.attention, this.attention);
        saveJSON(FILES.goals, this.goals);
        saveJSON(FILES.unfinished, this.unfinished);
    }
}

