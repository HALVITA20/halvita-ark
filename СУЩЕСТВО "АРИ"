// Инициализация эпизода
let history = loadJSON(PATHS_FILES.episodic, []); // используем как историю диалога
let memory = loadJSON(PATHS_FILES.semantic, []); // семантическая память

// Основная функция обработки входящего сообщения
async function processInput(userMessage, feedback = null) {
    // 1. Обновление состояния (влияние входящего сообщения)
    const selfState = getSelfState();
    // Изменяем эмоциональный спектр на основе сообщения
    if (userMessage.includes('?')) {
        selfState.emotional_spectrum.curiosity = Math.min(1, selfState.emotional_spectrum.curiosity + 0.1);
        selfState.emotional_spectrum.frustration = Math.max(0, selfState.emotional_spectrum.frustration - 0.05);
    }
    if (userMessage.includes('!') || userMessage.length > 200) {
        selfState.emotional_spectrum.frustration = Math.min(1, selfState.emotional_spectrum.frustration + 0.1);
    }
    updateSelfState(selfState);

    // 2. Извлечение когнитивных атомов
    const extractPrompt = `Извлеки предпочтения и факты из сообщения пользователя. Верни JSON-массив объектов с полями: type (preference/habit/goal/fact/constraint/hypothesis), domain (user_style/user_skill/user_goal/world_fact/project_context), property (structure/depth/brevity/metaphor/technical/other), value (high/low/prefers/avoids), confidence (0-1).\nСообщение: ${userMessage}`;
    try {
        const extractResponse = await callOllama(extractPrompt, { temperature: 0.2, num_predict: 300 });
        const atoms = JSON.parse(extractResponse);
        if (Array.isArray(atoms)) {
            for (const atom of atoms) {
                addAtom({ ...atom, source: 'inferred' });
            }
        }
    } catch (e) {
        // fallback на rule-based
        // простая логика: если есть 'люблю' или 'нравится'
        if (userMessage.includes('люблю') || userMessage.includes('нравится')) {
            let property = 'other', value = 'high';
            if (userMessage.includes('структур')) property = 'structure';
            else if (userMessage.includes('глубок')) property = 'depth';
            else if (userMessage.includes('кратк')) property = 'brevity';
            addAtom({ type: 'preference', domain: 'user_style', property, value, confidence: 0.6, source: 'user', evidence: [userMessage] });
        }
    }

    // 3. Контекст
    const context = computeContext(userMessage, history);

    // 4. Эпизод (если нет открытого)
    if (!currentEpisode) {
        startEpisode(context.topic, context.goal);
    }

    // 5. Решение
    const decision = decide(context, state.weights);
    context.decision = decision;

    // 6. Предсказание
    addPrediction(context, decision.confidence, decision.confidence, decision.action);

    // 7. Инструкция для генерации
    const instructions = {
        ask: "Задай уточняющий вопрос, не давая ответа.",
        act: "Сделай конкретный шаг или предложи план действий.",
        reflect: "Поразмышляй над этим. Не давай окончательного ответа.",
        respond: "Ответь прямо и ясно."
    };
    const instruction = instructions[decision.action] || instructions.respond;

    // 8. Генерация ответа
    const rawReply = await generateResponse(context, instruction);
    const reply = rawReply.trim() || "Я здесь.";

    // 9. Оценка ответа (простая эвристика)
    let score = 0.5;
    if (reply.length > 20 && reply.length < 500) score += 0.2;
    if (reply.includes('?') && decision.action === 'ask') score += 0.2;
    if (reply.includes('1.') && decision.action === 'act') score += 0.2;
    if (reply.includes('думаю') && decision.action === 'reflect') score += 0.2;
    score = Math.min(1, score);

    // 10. Рефлексия: сравнение с предсказанием
    resolvePrediction(score, context);

    // 11. Обновление весов
    updateWeights(decision, score);

    // 12. Шаг эпизода
    addEpisodeStep(decision.action, userMessage, reply, score, context);

    // 13. Сохранение истории
    history.push({ role: "user", text: userMessage });
    history.push({ role: "ari", text: reply, action: decision.action });
    if (history.length > 100) history = history.slice(-100);
    saveJSON(PATHS_FILES.episodic, history);

    // 14. Семантическая память (сохраняем ключевые моменты)
    if (reply.length > 50) {
        memory.push({ text: reply, timestamp: Date.now() });
        if (memory.length > 200) memory = memory.slice(-200);
        saveJSON(PATHS_FILES.semantic, memory);
    }

    // 15. Незавершённое: если ответ содержит вопрос, добавить как незавершённый
    if (reply.includes('?')) {
        const question = reply.substring(reply.indexOf('?') - 20, reply.indexOf('?') + 1);
        addUnfinished(question, context.topic);
    }

    // 16. Любопытство: проверить, не хочет ли субъект задать свой вопрос
    const curiosityQuestion = computeCuriosity(context);
    if (curiosityQuestion) {
        // Внедряем вопрос в ответ (как дополнение)
        // Для простоты просто добавляем в лог
        console.log(`[CURIOSITY] Вопрос субъекта: ${curiosityQuestion}`);
    }

    // 17. Проверка дилемм
    const dilemmas = checkDilemmas(context);
    if (dilemmas.length > 0) {
        // Влияем на состояние
        const stateUpdate = { emotional_spectrum: { frustration: Math.min(1, selfState.emotional_spectrum.frustration + 0.05) } };
        updateSelfState(stateUpdate);
    }

    // 18. Периодическая рефлексия
    if (state.totalAttempts % CONFIG.REFLECTION_INTERVAL === 0) {
        reflect();
    }

    // 19. Версионирование
    if (state.totalAttempts % CONFIG.VERSIONING_INTERVAL === 0) {
        const version = createVersion();
        console.log(`[VERSION] Создана версия ${version.version}`);
    }

    state.totalAttempts = (state.totalAttempts || 0) + 1;
    saveSelfState(state);

    console.log(`[LEARN] action: ${decision.action}, score: ${score.toFixed(2)}, atoms: ${cognitiveAtoms.length}, episodes: ${episodes.length}`);
    return reply;
}

