//  VI. ЭВОЛЮЦИЯ (Learning & Versioning)
// ============================================================

function updateWeights(decision, score) {
    const lr = CONFIG.LEARNING_RATE;
    const action = decision.action;
    state.weights[action] = state.weights[action] * 0.9 + (score / 2) * 0.1;
    for (let a in state.weights) {
        if (a !== action) {
            state.weights[a] = state.weights[a] * 0.98;
        }
    }
    const sum = Object.values(state.weights).reduce((a, b) => a + b, 0);
    for (let a in state.weights) {
        state.weights[a] = Math.max(CONFIG.MIN_WEIGHT, Math.min(CONFIG.MAX_WEIGHT, state.weights[a] / sum));
    }
    if (state.lastAction === action) {
        state.streak = (state.streak || 0) + 1;
    } else {
        state.streak = 0;
    }
    state.lastAction = action;
    const error = Math.abs(decision.confidence - (score / 2));
    state.performance = state.performance || [];
    state.performance.push({ action, confidence: decision.confidence, score, error, timestamp: Date.now() });
    if (state.performance.length > 100) state.performance = state.performance.slice(-100);
    saveJSON(PATHS_FILES.self_state, state);
}

function reflect() {
    const state = getSelfState();
    // Проверяем ошибки и корректируем состояние
    const recent = state.performance ? state.performance.slice(-10) : [];
    const avgError = recent.reduce((a,b) => a + b.error, 0) / recent.length || 0;
    if (avgError > 0.4) {
        // Увеличиваем сомнение в атомах
        cognitiveAtoms.forEach(a => {
            if (a.confidence < 0.8) a.doubt = Math.min(0.9, a.doubt + 0.05);
        });
        saveJSON(PATHS_FILES.cognitive_atoms, cognitiveAtoms);
    }
    // Логируем рефлексию
    const logEntry = {
        timestamp: new Date().toISOString(),
        avgError,
        state: { ...state },
        atomCount: cognitiveAtoms.length,
        episodeCount: episodes.length
    };
    fs.appendFileSync(PATHS_FILES.reflection_log, JSON.stringify(logEntry) + '\n');
}

// Версионирование себя
function createVersion() {
    const state = getSelfState();
    const version = {
        version: (state.version || 0) + 1,
        timestamp: new Date().toISOString(),
        identity: identity,
        laws: laws,
        state: state,
        atomCount: cognitiveAtoms.length,
        episodeCount: episodes.length
    };
    const history = loadJSON(PATHS_FILES.version_history, []);
    history.push(version);
    if (history.length > 100) history = history.slice(-100);
    saveJSON(PATHS_FILES.version_history, history);
    state.version = version.version;
    saveSelfState(state);
    return version;
}

