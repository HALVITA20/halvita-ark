async function parseSemantic(sentence) {
    // Используем маленький LLM-вызов с жёстким JSON-схемой
    const prompt = `
    Проанализируй предложение и верни JSON-объект:
    {
        type: "preference"|"fact"|"goal"|"constraint",
        property: "structure"|"depth"|"brevity"|"technical"|"other",
        value: "high"|"low"|"true"|"false"|"neutral",
        subject: "user"|"other",
        confidence: 0.0..1.0,
        context: { topics: [...] },
        isNegated: true/false
    }

    Предложение: "${sentence}"
    `;
    try {
        const response = await callOllama(prompt, { temperature: 0.2, num_predict: 300 });
        return JSON.parse(response);
    } catch {
        // fallback на rule-based
