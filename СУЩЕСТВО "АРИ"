    if (emotionalMemory.length > 200) emotionalMemory = emotionalMemory.slice(-200);
    saveJSON(PATHS.emotional, emotionalMemory);
}

function getEmotionalContext(query) {
    const rel = emotionalMemory.filter(e => query.toLowerCase().includes(e.context.slice(0, 20).toLowerCase()));
    if (!rel.length) return null;
    return rel.slice(-5).map(e => `- ${e.emotion} (${e.intensity.toFixed(1)}): ${e.context}`).join("\n");
}

