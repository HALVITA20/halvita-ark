        this.unfinished = await loadJSON(FILES.unfinished, []);
        this.performance = await loadJSON(FILES.performance, []);
        if (this.episodes.length > 0) this.lastEpisodeId = this.episodes[this.episodes.length-1].id;
        this._log(`Память загружена: атомов ${this.atoms.length}, эпизодов ${this.episodes.length}`);
    }

    addAtom(type, domain, prop, val, conf=0.5, src='inferred', evidence=[], emotion='neutral', meaning=null, behaviorChange=null, futurePredictionValue=0.5) {
        const atom = {
            id: genId(),
            type, domain, prop, val,
            confidence: clamp(conf,0,1),
            source: src,
            evidence: evidence.slice(0,5),
            created: Date.now(),
            lastUsed: Date.now(),
            usageCount: 0,
            importance: 0.5,
            emotionalWeight: emotion === 'surprise' ? 0.8 : (emotion === 'frustration' ? 0.7 : 0.5),
            meaning: meaning || null,
            behaviorChange: behaviorChange || null,
            futurePredictionValue: clamp(futurePredictionValue,0,1)
        };
        this.atoms.push(atom);
        if (this.atoms.length > CONFIG.MAX_ATOMS) {
            this.atoms = this.atoms
                .sort((a,b) => (b.confidence*b.importance*b.emotionalWeight*b.futurePredictionValue) - (a.confidence*a.importance*a.emotionalWeight*a.futurePredictionValue))
                .slice(0, CONFIG.MAX_ATOMS);
        }
        this._saveAtoms();
        return atom;
    }
    getRelevantAtoms(context, limit=10) {
        const words = context.toLowerCase().split(/\s+/);
        const now = Date.now();
        return this.atoms
            .filter(a => a.confidence > 0.15)
            .map(a => {
                const age = (now - a.lastUsed) / (1000*60*60*24);
                const recency = Math.exp(-age / 30);
                const relevance = words.some(w => w.includes(a.prop) || a.prop.includes(w));
                const activation = a.confidence * a.importance * a.emotionalWeight * a.futurePredictionValue * recency * (relevance ? 1.3 : 0.4);
                return { ...a, activation, relevance };
            })
            .sort((a,b) => b.activation - a.activation)
            .slice(0, limit);
    }

    startEpisode(topic, goal, context, emotion='neutral') {
        const ep = {
            id: genId(),
            topic: topic.slice(0,60),
            goal,
            steps: [],
            decisions: [],
            outcomes: [],
            lessons: [],
            timestamp: Date.now(),
            closed: false,
            context: context.slice(0,100),
            emotion: emotion,
            priority: 0.5
        };
        this.episodes.push(ep);
        if (this.episodes.length > CONFIG.MAX_EPISODES) {
            const open = this.episodes.filter(e => !e.closed);
            const closed = this.episodes.filter(e => e.closed).sort((a,b) => a.timestamp - b.timestamp);
            const toKeep = closed.slice(-CONFIG.MAX_EPISODES + open.length);
            this.episodes = [...open, ...toKeep];
        }
        this.lastEpisodeId = ep.id;
        this._saveEpisodes();
        return ep;
    }
    addEpisodeStep(episodeId, action, input, output, score, context, emotion='neutral') {
        const ep = this.episodes.find(e => e.id === episodeId);
        if (ep && !ep.closed) {
            ep.steps.push({ action, input, output, score, context: context.slice(0,100), timestamp: Date.now(), emotion });
            ep.decisions.push(action);
            ep.outcomes.push(score);
            // Обновляем приоритет эпизода на основе ошибки
            const error = 1 - score;
            ep.priority = clamp(ep.priority + error * 0.1, 0, 1);
            this._saveEpisodes();
        }
    }
    closeEpisode(episodeId) {
        const ep = this.episodes.find(e => e.id === episodeId);
        if (ep && !ep.closed) {
            ep.closed = true;
            const avg = ep.outcomes.reduce((a,b) => a+b, 0) / (ep.outcomes.length || 1);
            if (avg < 0.3) ep.lessons.push('Стратегия неэффективна');
            else if (avg > 0.7) ep.lessons.push('Стратегия эффективна');
            this._saveEpisodes();
            this._log(`Эпизод закрыт: ${ep.topic}, средняя ${avg.toFixed(2)}`);
        }
    }
    getRelevantEpisodes(context, n=5) {
        const words = context.toLowerCase().split(/\s+/);
        return this.episodes
            .filter(e => e.topic && words.some(w => e.topic.includes(w)))
            .slice(-n);
    }
    getHighestPriorityEpisodes(n=7) {
        // Сортировка по приоритету (error * emotion * importance * unfinished)
        return this.episodes
            .filter(e => e.closed)
            .map(e => {
                const avgOutcome = e.outcomes.reduce((a,b) => a+b, 0) / (e.outcomes.length || 1);
                const error = 1 - avgOutcome;
                const emotionWeight = e.emotion === 'frustration' ? 0.8 : (e.emotion === 'surprise' ? 0.7 : 0.4);
                const importance = e.steps.length / 10;
                const unfinished = e.lessons.length > 0 ? 0.2 : 0;
                const priority = error * emotionWeight * importance + unfinished;
                return { ...e, priority };
            })
            .sort((a,b) => b.priority - a.priority)
            .slice(0, n);
    }

    addStrategy(context, action, confidence, evidence, behaviorChange=null) {
        const existing = this.strategies.find(s => s.context === context && s.action === action);
        if (existing) {
            existing.confidence = clamp(existing.confidence + 0.1*(confidence - existing.confidence), 0, 1);
            existing.evidence.push(evidence);
            existing.updated = Date.now();
            if (behaviorChange) existing.behaviorChange = behaviorChange;
        } else {
            this.strategies.push({
                id: genId(),
                context: context.slice(0,60),
                action,
                confidence: clamp(confidence,0,1),
                evidence: [evidence],
                created: Date.now(),
                updated: Date.now(),
                success_count: 0,
                fail_count: 0,
                behaviorChange: behaviorChange || null
            });
        }
        if (this.strategies.length > CONFIG.MAX_STRATEGIES) {
            this.strategies = this.strategies.sort((a,b) => b.confidence - a.confidence).slice(0, CONFIG.MAX_STRATEGIES);
        }
        this._saveStrategies();
    }
    getRelevantStrategies(context, limit=5) {
        const words = context.toLowerCase().split(/\s+/);
        return this.strategies
            .filter(s => s.confidence > 0.2)
            .map(s => {
                const relevance = words.some(w => s.context.includes(w));
                return { ...s, relevance: relevance ? 1.0 : 0.3 };
            })
            .sort((a,b) => b.confidence * b.relevance - a.confidence * a.relevance)
            .slice(0, limit);
    }

    addPrediction(context, expected, confidence, linkedBeliefId=null, action=null) {
        return { id: genId(), context: context.slice(0,100), expected: clamp(expected,0,1), confidence: clamp(confidence,0,1), linkedBeliefId, action, actual: null, error: null, resolved: false, timestamp: Date.now() };
    }
    resolvePrediction(pred, actual) {
        pred.actual = clamp(actual,0,1);
        pred.error = Math.abs(pred.expected - pred.actual);
        pred.resolved = true;
        return pred;
    }
    addUnfinished(text, context) {
        const item = { id: genId(), text, context: context.slice(0,60), created: Date.now(), resolved: false };
        this.unfinished.push(item);
        if (this.unfinished.length > 60) this.unfinished = this.unfinished.filter(u => !u.resolved).slice(-60);
        this._saveUnfinished();
    }
    resolveUnfinished(id) {
        const item = this.unfinished.find(u => u.id === id);
        if (item) item.resolved = true;
        this._saveUnfinished();
    }
    addPerformance(action, score, error, context) {
        this.performance.push({ action, score: clamp(score,0,1), error: clamp(error,0,1), context: context.slice(0,50), timestamp: Date.now() });
        if (this.performance.length > 500) this.performance = this.performance.slice(-500);
        this._savePerformance();
    }

    async _saveAtoms() { await saveJSON(FILES.atoms, this.atoms); }
    async _saveEpisodes() { await saveJSON(FILES.episodes, this.episodes); }
    async _saveStrategies() { await saveJSON(FILES.strategies, this.strategies); }
    async _saveUnfinished() { await saveJSON(FILES.unfinished, this.unfinished); }
    async _savePerformance() { await saveJSON(FILES.performance, this.performance); }

    _log(msg) { fs.appendFile(FILES.ari_log, `[${new Date().toISOString()}] MEMORY: ${msg}\n`).catch(()=>{}); }
}

// ================================================================
//  6. УБЕЖДЕНИЯ (байесовские) + CAUSAL GRAPH
// ================================================================
class BeliefEngine {
    constructor() { this.beliefs = []; this.causalLinks = []; }
    async init() {
        this.beliefs = await loadJSON(FILES.beliefs, []);
        this.causalLinks = await loadJSON(FILES.causal_links, []);
        this._log(`Убеждений: ${this.beliefs.length}, причинных связей: ${this.causalLinks.length}`);
    }
    addBelief(statement, domain, confidence, evidence=[], source='inferred') {
        const b = {
            id: genId(), statement, domain,
            confidence: clamp(confidence,0,1),
            evidence: evidence.slice(0,10),
            contradictions: [],
            source,
            created: Date.now(),
            updated: Date.now(),
            stability: 0.5
        };
        this.beliefs.push(b);
        if (this.beliefs.length > 500) this.beliefs = this.beliefs.sort((a,b) => b.confidence - a.confidence).slice(0,500);
        this._saveBeliefs();
        return b;
    }
    getBelief(id) { return this.beliefs.find(b => b.id === id); }
    updateBelief(id, newConfidence, evidenceItem) {
        const b = this.getBelief(id);
        if (b) {
            const prior = b.confidence;
            const likelihood = newConfidence;
            const posterior = prior * likelihood / (prior * likelihood + (1-prior) * (1-likelihood));
            b.confidence = clamp(posterior, 0, 1);
            b.evidence.push(evidenceItem);
            b.updated = Date.now();
            b.stability = clamp(b.stability + 0.02, 0, 1);
            this._saveBeliefs();
        }
    }
    addContradiction(id, evidence) {
        const b = this.getBelief(id);
        if (b) {
            b.contradictions.push(evidence);
            b.confidence = clamp(b.confidence * 0.9, 0.1, 1);
            b.stability = clamp(b.stability - 0.01, 0.1, 1);
            this._saveBeliefs();
        }
    }
    getRelevantBeliefs(context, limit=5) {
        const words = context.toLowerCase().split(/\s+/);
        return this.beliefs
            .filter(b => b.confidence > 0.2)
            .map(b => {
                const relevance = words.some(w => b.statement.toLowerCase().includes(w) || w.includes(b.statement.split(' ')[0]));
                return { ...b, relevance: relevance ? 0.9 : 0.2 };
            })
            .sort((a,b) => b.confidence * b.relevance - a.confidence * a.relevance)
            .slice(0, limit);
    }

    // --- CAUSAL GRAPH ---
    addCausalLink(error, cause, beliefId, strategyId, outcome) {
        const link = {
            id: genId(),
            error,
            cause,
            beliefId,
            strategyId,
            outcome,
            timestamp: Date.now(),
            weight: 1.0
        };
        this.causalLinks.push(link);
        if (this.causalLinks.length > CONFIG.MAX_CAUSAL_LINKS) {
            this.causalLinks = this.causalLinks.slice(-CONFIG.MAX_CAUSAL_LINKS);
        }
        this._saveCausalLinks();
        return link;
    }
    getCausalLinks(context) {
        // Возвращает связи, релевантные контексту
        return this.causalLinks
            .filter(l => l.cause && context.includes(l.cause))
            .sort((a,b) => b.weight - a.weight)
            .slice(0,5);
    }

    async _saveBeliefs() { await saveJSON(FILES.beliefs, this.beliefs); }
    async _saveCausalLinks() { await saveJSON(FILES.causal_links, this.causalLinks); }
    _log(msg) { fs.appendFile(FILES.ari_log, `[${new Date().toISOString()}] BELIEFS: ${msg}\n`).catch(()=>{}); }
}

// ================================================================
//  7. STRATEGY GENOME (эволюционирующие вероятностные стратегии)
// ================================================================
class StrategyGenome {
    constructor() {
        this.genome = {};
    }
    async init() {
        this.genome = await loadJSON(FILES.genome, {
            // контекст → { ask: 0.3, reflect: 0.3, respond: 0.3, act: 0.1 }
        });
        this._log(`Геном загружен, стратегий: ${Object.keys(this.genome).length}`);
    }
    getStrategy(context) {
        // Ищем по частичному совпадению
        const keys = Object.keys(this.genome);
        for (const key of keys) {
            if (context.includes(key)) return { ...this.genome[key] };
        }
        return { ask: 0.25, reflect: 0.25, respond: 0.25, act: 0.25 };
    }
    updateStrategy(context, action, delta) {
        if (!this.genome[context]) {
            this.genome[context] = { ask: 0.25, reflect: 0.25, respond: 0.25, act: 0.25 };
        }
        const strat = this.genome[context];
        if (strat[action] !== undefined) {
            strat[action] = clamp(strat[action] + delta, 0, 1);
            // Нормализация
            const sum = Object.values(strat).reduce((a,b) => a+b, 0);
            for (let a in strat) strat[a] /= sum;
        }
        this._saveGenome();
    }
    mutate(context, rate=0.1) {
        if (!this.genome[context]) return;
        const strat = this.genome[context];
        const actions = Object.keys(strat);
        for (const a of actions) {
            if (Math.random() < rate) {
                strat[a] = clamp(strat[a] + (Math.random() - 0.5) * 0.2, 0, 1);
            }
        }
        const sum = Object.values(strat).reduce((a,b) => a+b, 0);
        for (let a in strat) strat[a] /= sum;
        this._saveGenome();
    }
    crossover(context1, context2) {
        // Скрещивание двух стратегий
        const s1 = this.genome[context1] || { ask:0.25, reflect:0.25, respond:0.25, act:0.25 };
        const s2 = this.genome[context2] || { ask:0.25, reflect:0.25, respond:0.25, act:0.25 };
        const child = {};
        for (const a of Object.keys(s1)) {
            child[a] = (s1[a] + s2[a]) / 2 + (Math.random() - 0.5) * 0.05;
        }
        const sum = Object.values(child).reduce((a,b) => a+b, 0);
        for (let a in child) child[a] /= sum;
        const newContext = context1 + '_' + context2;
        this.genome[newContext] = child;
        this._saveGenome();
        return newContext;
    }
    async _saveGenome() { await saveJSON(FILES.genome, this.genome); }
    _log(msg) { fs.appendFile(FILES.ari_log, `[${new Date().toISOString()}] GENOME: ${msg}\n`).catch(()=>{}); }
}

