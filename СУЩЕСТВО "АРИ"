async function sleepPhase() {
    console.log("[SLEEP] Начало");
    // Обновляем веса убеждений на основе эмоциональной памяти
    identity.beliefs.forEach(b => {
        const emotionMatches = emotionalMemory.filter(e => e.context.includes(b.text.slice(0, 20)));
        if (emotionMatches.length > 0) {
            b.weight = Math.min(1.0, b.weight + 0.05 * emotionMatches.length);
        } else {
            b.weight = Math.max(0.3, b.weight - 0.02);
        }
    });
    saveJSON(PATHS.identity, identity);

    // Цели — из уроков и эмоций
    if (lessons.length > 0 && goals.length < 10) {
        const lastLesson = lessons[lessons.length-1];
        const goalText = lastLesson.text.slice(0, 80);
        if (!goals.some(g => g.text === goalText)) {
            goals.push({ text: goalText, timestamp: Date.now(), status: 'active' });
            saveJSON(PATHS.goals, goals);
        }
    }
    console.log("[SLEEP] Завершено");
}

