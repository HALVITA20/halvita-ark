        this._savePersonality();
        this._log(`Личность ${trait} → ${this.personality[trait].toFixed(3)} (${cause})`);
    }
    adjustMood(mood, delta, cause = "") {
        if (!this.mood[mood]) return;
        this.mood[mood] = clamp(this.mood[mood] + delta, 0, 1);
        this._saveMood();
        this._log(`Настроение ${mood} → ${this.mood[mood].toFixed(3)} (${cause})`);
    }
    decayMood() {
        for (let k in this.mood) {
            const baseline = ['frustration','fatigue','anxiety'].includes(k) ? 0.1 : 0.5;
            this.mood[k] = this.mood[k] * (1 - CONFIG.MOOD_DECAY) + baseline * CONFIG.MOOD_DECAY;
        }
        this._saveMood();
    }
    addSelfBelief(belief, confidence, evidence, source = "reflection") {
        const existing = this.selfModel.beliefs.find(b => b.belief === belief);
        if (existing) {
            existing.confidence = (existing.confidence * existing.evidence.length + confidence) / (existing.evidence.length + 1);
            existing.evidence.push({ evidence, source, timestamp: Date.now() });
            existing.updated = Date.now();
        } else {
            this.selfModel.beliefs.push({ belief, confidence, evidence: [{ evidence, source, timestamp: Date.now() }], created: Date.now(), updated: Date.now() });
        }
        this.selfModel.stability = clamp(this.selfModel.stability + 0.005, 0.5, 1);
        this._saveSelfModel();
        this._log(`Самоощущение: ${belief} (conf=${confidence.toFixed(2)})`);
    }
    attributeError(error, context, causes) {
        if (causes.me > 0.5) {
            this.adjustPersonality('confidence', -0.01 * error, `ошибка (я)`);
            this.addSelfBelief(`Я часто ошибаюсь в "${context.slice(0,30)}"`, clamp(0.3 + error*0.3,0.3,0.8), { error, context, causes });
        } else if (causes.user > 0.5) {
            this.adjustMood('frustration', 0.05 * error, "непонятный пользователь");
        } else if (causes.data > 0.5) {
            this.adjustPersonality('curiosity', 0.02, "недостаточно данных");
        }
        return causes;
    }
    async _savePersonality() { await saveJSON(FILES.personality, this.personality); }
    async _saveMood() { await saveJSON(FILES.mood, this.mood); }
    async _saveSelfModel() { await saveJSON(FILES.self_model, this.selfModel); }
    _log(msg) { fs.appendFile(FILES.ari_log, `[${new Date().toISOString()}] IDENTITY: ${msg}\n`).catch(()=>{}); }
    getStatus() { return { personality: this.personality, mood: this.mood, selfBeliefs: this.selfModel.beliefs.length }; }
}

