4. Конфликты с учётом контекста
javascript
// memory/conflicts.js

function findConflict(newBelief, existingBeliefs) {
    return existingBeliefs.find(b => {
        // Противоположное значение в том же домене
        if (b.domain !== newBelief.domain) return false;
        if (b.property !== newBelief.property) return false;
        if (b.value === newBelief.value) return false;
        if (b.status === 'deleted') return false;

        // Проверяем контекст: если у одного из них нет контекста, считаем конфликт
        const hasContextA = b.context && b.context.topics && b.context.topics.length > 0;
        const hasContextB = newBelief.context && newBelief.context.topics && newBelief.context.topics.length > 0;

        // Если оба без контекста → конфликт
        if (!hasContextA && !hasContextB) return true;

        // Если контекст разный → не конфликт (могут сосуществовать)
        if (hasContextA && hasContextB) {
            const intersect = b.context.topics.some(t => newBelief.context.topics.includes(t));
            if (!intersect) return false; // разные контексты, могут жить вместе
        }

        // Если один с контекстом, другой без → конфликт (только если второй более общий)
        return true;
    });
}
