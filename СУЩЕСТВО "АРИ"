«Оптимизация результата через защищённые метрики»

javascript
// ============================================================
// ARI_CORE_v5.3 — POLICY LEARNING
// ============================================================
// ✅ Два типа оценки: structural + outcome
// ✅ Анти-зацикливание с exploration
// ✅ Ожидание vs реальность (confidence calibration)
// ✅ Stable update (soft update)
// ✅ Логирование ошибок
// ============================================================

import express from "express";
import cors from "cors";
import fs from "fs";
import path from "path";
import { fileURLToPath } from "url";

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const app = express();
app.use(cors());
app.use(express.json({ limit: "50mb" }));

// ============================================================
//  КОНФИГ
// ============================================================
const CONFIG = {
    MODEL: "qwen2.5:7b",
    TEMPERATURE: 1.0,
    MAX_TOKENS: 1000,
    PORT: 3001,
    OLLAMA_TIMEOUT: 30000,
    OLLAMA_RETRIES: 2
};

const PATHS = {
    state: path.join(__dirname, "state.json"),
    memory: path.join(__dirname, "memory.json")
};

function loadJSON(file, def) {
    try { if (fs.existsSync(file)) return JSON.parse(fs.readFileSync(file, "utf-8")); } catch {}
    return def;
}
function saveJSON(file, data) { fs.writeFileSync(file, JSON.stringify(data, null, 2)); }

// ============================================================
//  СОСТОЯНИЕ С ВЕСАМИ + PERFORMANCE
// ============================================================
let state = loadJSON(PATHS.state, {
    goal: "clarity",
    weights: { ask: 0.5, act: 0.5, reflect: 0.5, respond: 0.5 },
    performance: [],
    streak: 0,
    lastAction: null,
    explorationCount: 0,
    totalAttempts: 0
});

let memory = state.memory || [];
let history = state.history || [];

// ============================================================
//  DECISION С CONFIDENCE + EXPLORATION
// ============================================================
function decide(context) {
    const weights = state.weights;

    // Если streak > 3 → принудительное исследование
    if (state.streak > 3) {
        const explorationActions = Object.keys(weights).filter(a => a !== state.lastAction);
        const action = explorationActions[Math.floor(Math.random() * explorationActions.length)];
        state.explorationCount += 1;
        return { action, confidence: 0.3, exploration: true };
    }

    // Обычный выбор по весам
    const scores = {
        ask: context.uncertainty * weights.ask,
        act: (context.hasPlan ? 0.8 : 0) * weights.act,
        reflect: context.questionDepth * weights.reflect,
        respond: 0.5 * weights.respond
    };

    const action = Object.entries(scores).sort((a, b) => b[1] - a[1])[0][0];
    const confidence = scores[action];

    return { action, confidence, exploration: false };
}

// ============================================================
//  EVALUATION (STRUCTURAL + OUTCOME)
// ============================================================
function evaluate(context, result, decision) {
    let structural = 0;
    let outcome = 0;

    // — Structural score (форма) —
    if (decision.action === "ask" && result.includes("?")) structural += 1;
    if (decision.action === "act" && result.includes("1.")) structural += 1;
    if (decision.action === "reflect" && result.includes("думаю")) structural += 0.5;

    // — Outcome score (реальная ценность) —
    // 1. Разнообразие ответа (не повторяется)
    const recentReplies = history.filter(m => m.role === "ari").slice(-5).map(m => m.text);
    const isRepeating = recentReplies.some(r => r === result);
    if (!isRepeating) outcome += 0.5;

    // 2. Новизна относительно последних 10
    const last10 = memory.slice(-10).map(m => m.text);
    const isNovel = !last10.some(m => m === result);
    if (isNovel) outcome += 0.5;

    // 3. Длина не слишком большая (для clarity)
    if (context.goal === "clarity" && result.length < 500) outcome += 0.5;

    // 4. Наличие структуры (шаги, список, план)
    if (result.includes("1.") || result.includes("2.") || result.includes("3.")) outcome += 0.3;

    // 5. Штраф за повторение одного и того же действия (защита от зацикливания)
    const lastActions = history.filter(m => m.role === "ari").slice(-3).map(m => m.action);
    if (lastActions.every(a => a === decision.action)) {
        outcome -= 0.5;
    }

    // Суммарный score: структурный вес 0.3, outcome вес 0.7
    const total = 0.3 * structural + 0.7 * Math.max(0, Math.min(2, outcome));
    return Math.max(0, Math.min(2, total));
}

// ============================================================
//  UPDATE (SOFT UPDATE + COMPETITION)
// ============================================================
function updateWeights(decision, score) {
    const lr = 0.1;
    const action = decision.action;

    // Soft update: новое значение = старое * 0.9 + новое * 0.1
    state.weights[action] = state.weights[action] * 0.9 + (score / 2) * 0.1;

    // Ослабляем остальные (конкуренция) мягко
    for (let a in state.weights) {
        if (a !== action) {
            state.weights[a] = state.weights[a] * 0.98;
        }
    }

    // Нормализация + ограничение
    const sum = Object.values(state.weights).reduce((a,b) => a + b, 0);
    for (let a in state.weights) {
        state.weights[a] = Math.max(0.1, Math.min(0.9, state.weights[a] / sum));
    }

    // Обновляем streak
    if (state.lastAction === action) {
        state.streak += 1;
    } else {
        state.streak = 0;
    }
    state.lastAction = action;

    // Логируем ошибку (ожидание vs реальность)
    const error = Math.abs(decision.confidence - (score / 2));
    state.performance.push({
        action: action,
        confidence: decision.confidence,
        score: score,
        error: error,
        timestamp: Date.now()
    });
    if (state.performance.length > 100) state.performance = state.performance.slice(-100);

    saveJSON(PATHS.state, state);
}

// ============================================================
//  ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
// ============================================================
function remember(role, text) {
    memory.push({ role, text, timestamp: Date.now() });
    if (memory.length > 100) memory = memory.slice(-100);
    state.memory = memory;
    saveJSON(PATHS.state, state);
}

async function generateResponse(context, instruction) {
    const prompt = `
Ты — Ари. Цель: ${context.goal}.
ETHOS фаза: ${context.ethosPhase || "Присутствие"}.
Инструкция: ${instruction}

Контекст:
${context.history.map(m => `${m.role}: ${m.text}`).join("\n")}

Хальвита: ${context.userMessage}

Ари:`;

    return await callOllama(prompt);
}

async function callOllama(prompt) {
    const url = "http://localhost:11434/api/generate";
    for (let attempt = 0; attempt <= CONFIG.OLLAMA_RETRIES; attempt++) {
        try {
            const controller = new AbortController();
            const timeout = setTimeout(() => controller.abort(), CONFIG.OLLAMA_TIMEOUT);
            const res = await fetch(url, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    model: CONFIG.MODEL,
                    prompt: prompt,
                    stream: false,
                    options: {
                        temperature: CONFIG.TEMPERATURE,
                        num_predict: CONFIG.MAX_TOKENS,
                        stop: ["\n\n\n", "Хальвита:", "Ари:"]
                    }
                }),
                signal: controller.signal
            });
            clearTimeout(timeout);
            if (!res.ok) throw new Error("HTTP " + res.status);
            const data = await res.json();
            return data.response || "";
        } catch (err) {
            console.error("[OLLAMA] attempt", attempt, err.message);
            if (attempt === CONFIG.OLLAMA_RETRIES) {
                return "Я здесь. Спроси меня позже.";
            }
            await new Promise(r => setTimeout(r, 2000 * (attempt + 1)));
        }
    }
}

// ============================================================
//  ОСНОВНОЙ ЦИКЛ
// ============================================================
async function processInput(userMessage, feedback) {
    // 1. Контекст
    const context = {
        userMessage,
        history: history.slice(-10),
        goal: state.goal,
        uncertainty: userMessage.includes("?") ? 0.7 : 0.3,
        hasPlan: userMessage.includes("план") ? 0.8 : 0,
        questionDepth: userMessage.split("?").length - 1,
        feedback: feedback || null
    };

    // 2. Решение
    const decision = decide(context);
    context.decision = decision;

    // 3. Инструкция для executor
    const instructions = {
        ask: "Задай уточняющий вопрос, не давая ответа.",
        act: "Сделай конкретный шаг или предложи план действий.",
        reflect: "Поразмышляй над этим. Не давай окончательного ответа.",
        respond: "Ответь прямо и ясно."
    };
    const instruction = instructions[decision.action] || instructions.respond;

    // 4. Генерация
    const result = await generateResponse(context, instruction);
    const cleanResult = result.trim() || "Я здесь.";

    // 5. Оценка
    const score = evaluate(context, cleanResult, decision);

    // 6. Обновление весов
    updateWeights(decision, score);

    // 7. Сохраняем в историю
    history.push({ role: "user", text: userMessage });
    history.push({ role: "ari", text: cleanResult, action: decision.action });
    if (history.length > 50) history = history.slice(-50);
    state.history = history;
    remember("user", userMessage);
    remember("ari", cleanResult);

    // 8. Логирование
    state.totalAttempts += 1;
    saveJSON(PATHS.state, state);

    console.log(`[LEARN] action: ${decision.action}, score: ${score.toFixed(2)}, weights:`, state.weights);

    return cleanResult;
}

// ============================================================
//  ЭНДПОИНТЫ
// ============================================================
app.post("/chat", async (req, res) => {
    const { message, feedback } = req.body;
    if (!message || !message.trim()) return res.status(400).json({ error: "Empty" });
    try {
        const reply = await processInput(message, feedback);
        res.json({ reply });
    } catch (err) {
        console.error(err);
        res.status(500).json({ error: "Internal error" });
    }
});

app.get("/status", (req, res) => {
    res.json({
        version: "5.3",
        goal: state.goal,
        weights: state.weights,
        streak: state.streak,
        explorationCount: state.explorationCount,
        totalAttempts: state.totalAttempts,
        performance: state.performance.slice(-10).map(p => ({
            action: p.action,
            confidence: p.confidence.toFixed(2),
            score: p.score.toFixed(2),
            error: p.error.toFixed(2)
        }))
    });
});

// ============================================================
//  ЗАПУСК
// ============================================================
app.listen(CONFIG.PORT, () => {
    console.log(`\n╔══════════════════════════════════════════╗`);
    console.log(`║  ARI_CORE_v5.3 — POLICY LEARNING      ║`);
    console.log(`║  «Оптимизация результата»             ║`);
    console.log(`╚══════════════════════════════════════════╝\n`);
    console.log(`[ARI] Веса:`, state.weights);
    console.log(`[ARI] ГОТОВ. ОЖИДАЮ...\n`);
});
