${text}

Уроки (каждый на отдельной строке):`;
    try {
        const resp = await callOllama(prompt, { temperature: 0.4, num_predict: 200 });
        if (resp) {
            const lines = resp.split('\n').filter(l => l.length > 15);
            for (let line of lines) {
                const clean = cleanReply(line);
                if (clean.length > 10 && !lessons.some(l => l.text === clean)) {
