function validateCandidate(candidate) {
    // Проверка уверенности, источника, контекста
    if (candidate.confidence < 0.4) {
        return { valid: false, reason: 'low_confidence' };
    }
    if (!candidate.property) {
        return { valid: false, reason: 'no_property' };
    }
    // Может быть, проверка на уже существующее убеждение
    const existing = beliefMemory.findSimilar(candidate);
    if (existing && existing.confidence > candidate.confidence) {
        return { valid: false, reason: 'already_exists' };
    }
    return { valid: true, belief: candidate };
}
