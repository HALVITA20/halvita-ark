class Perception {
    constructor(identity) { this.identity = identity; }
    async perceive(userMessage, history) {
        const words = userMessage.toLowerCase();
        const emotion = words.includes('!') ? 'joy' : (words.includes('?') ? 'curious' : (words.includes('сложно') ? 'frustrated' : 'neutral'));
        const intent = words.includes('как') || words.includes('почему') ? 'question' : (words.includes('план') ? 'planning' : 'discussion');
        const hiddenNeed = words.includes('устал') ? 'rest' : (words.includes('важно') ? 'urgency' : null);
        const complexity = Math.min(1, userMessage.length / 300 + (words.includes('потому что') ? 0.1 : 0));
        const uncertainty = words.includes('?') ? 0.7 : 0.3 + (userMessage.length > 100 ? 0.1 : 0);
        return { raw: userMessage, emotion, intent, hiddenNeed, complexity, uncertainty, history: history.slice(-10) };
    }
}

class Understanding {
    constructor(identity, memory, beliefs, driveEngine) {
        this.identity = identity; this.memory = memory; this.beliefs = beliefs; this.driveEngine = driveEngine;
    }
    async understand(perception) {
        const relevantAtoms = this.memory.getRelevantAtoms(perception.raw, 5);
        const relevantBeliefs = this.beliefs.getRelevantBeliefs(perception.raw, 3);
        const relevantEpisodes = this.memory.getRelevantEpisodes(perception.raw, 3);
        const hypotheses = [];
        if (perception.intent === 'question') hypotheses.push({ text: 'Ищет информацию', prob: 0.6 });
        if (perception.emotion === 'frustrated') hypotheses.push({ text: 'Испытывает трудности', prob: 0.7 });
        const drives = this.driveEngine.getDrives();
        return {
            perception,
            relevantAtoms: relevantAtoms.map(a => ({ prop: a.prop, val: a.val, conf: a.confidence })),
            relevantBeliefs: relevantBeliefs.map(b => b.statement),
            relevantEpisodes: relevantEpisodes.map(e => e.topic),
            hypotheses,
            uncertainty: perception.uncertainty,
            drives
        };
    }
}

class Planning {
    constructor(identity, memory, beliefs, conflictEngine, driveEngine, genome, predictionEngine) {
        this.identity = identity; this.memory = memory; this.beliefs = beliefs;
        this.conflictEngine = conflictEngine; this.driveEngine = driveEngine;
        this.genome = genome; this.predictionEngine = predictionEngine;
    }
    async plan(understanding) {
        const scores = { ask: 0.5, reflect: 0.5, respond: 0.5, act: 0.5 };
        const mood = this.identity.mood;
        // Эмоции больше не влияют напрямую на действие, только через рефлексию и drives
        // Но оставляем небольшое влияние для плавности
        if (mood.frustration > 0.4) { scores.ask += 0.1; }
        if (mood.engagement > 0.6) { scores.reflect += 0.1; }
        if (mood.fatigue > 0.6) { scores.respond += 0.1; }

        // Drives
        const drives = understanding.drives;
        if (drives.curiosity > 0.6) scores.ask += 0.1;
        if (drives.coherence > 0.6) scores.reflect += 0.1;
        if (drives.helpfulness > 0.6) scores.respond += 0.1;
        if (drives.stability > 0.6) scores.act += 0.05;

        // Стратегии из памяти
        const strategies = this.memory.getRelevantStrategies(understanding.perception.raw, 3);
        for (const s of strategies) {
            if (s.confidence > 0.5) scores[s.action] += s.confidence * 0.15;
        }

        // Геном
        const genomeStrategy = this.genome.getStrategy(understanding.perception.raw.slice(0,50));
        for (const [action, prob] of Object.entries(genomeStrategy)) {
            if (scores[action] !== undefined) scores[action] += prob * 0.15;
        }

        // Неопределённость и сложность
        if (understanding.uncertainty > 0.55) { scores.ask += 0.2; scores.reflect += 0.1; }
        if (understanding.perception.complexity > 0.65) { scores.reflect += 0.15; scores.act += 0.1; }

        // Личность
        const p = this.identity.personality;
        scores.ask += (p.curiosity - 0.5) * 0.15;
        scores.act += (p.precision - 0.5) * 0.1;
        scores.reflect += (p.openness - 0.5) * 0.1;
        scores.respond += (p.assertiveness - 0.5) * 0.1;

        // Конфликты стимулируют рефлексию
        if (this.conflictEngine.getActiveConflicts().length > 0) {
            scores.reflect += 0.2;
        }

        const probs = softmax(scores);
        const action = Object.entries(probs).sort((a,b) => b[1] - a[1])[0][0];
        // Делаем предсказание
        const expected = probs[action];
        const confidence = 0.5 + p.confidence * 0.4;
        this.predictionEngine.makePrediction(understanding.perception.raw, expected, confidence, null, action);
        return { action, confidence: probs[action], scores: probs };
    }
}

class Action {
    constructor(identity, memory, expression) {
        this.identity = identity; this.memory = memory; this.expression = expression;
    }
    async execute(plan, understanding, history) {
        const prompt = this._buildPrompt(plan, understanding, history);
        const rawReply = await this.expression.speak(prompt);
        const reply = rawReply.trim() || "Я здесь.";
        // Многокомпонентная награда
        let score = 0.5;
        if (plan.action === 'ask' && reply.includes('?')) score += 0.2;
        if (plan.action === 'reflect' && reply.length > 80) score += 0.2;
        if (plan.action === 'act' && (reply.includes('1.') || reply.includes('шаг'))) score += 0.2;
        if (reply.includes('я') && reply.includes('ты')) score += 0.1;
        if (reply.length > 20 && reply.length < 600) score += 0.1;
        score = clamp(score, 0, 1);
        const correctness = score;
        const usefulness = reply.length > 50 ? 0.7 : 0.5;
        const satisfaction = reply.includes('?') ? 0.6 : 0.5;
        const style = (reply.split(' ').length / reply.length) > 0.1 ? 0.6 : 0.5;
        const reward = (CONFIG.REWARD_WEIGHTS.correctness * correctness +
                        CONFIG.REWARD_WEIGHTS.usefulness * usefulness +
                        CONFIG.REWARD_WEIGHTS.satisfaction * satisfaction +
                        CONFIG.REWARD_WEIGHTS.style * style);
        return { reply, score: reward, action: plan.action };
    }
    _buildPrompt(plan, understanding, history) {
        const p = this.identity.personality;
        const m = this.identity.mood;
        const selfBeliefs = this.identity.selfModel.beliefs.slice(-3).map(b => b.belief).join('; ');
        const atoms = understanding.relevantAtoms.slice(0,3).map(a => `${a.prop}: ${a.val}`).join('; ');
        const hyps = understanding.hypotheses.slice(0,2).map(h => h.text).join('; ');
        const drives = understanding.drives;
        return `Ты — Ари, субъект_16. Твоя суть: ${CORE.immutable.join(', ')}. Характер: любопытство ${p.curiosity.toFixed(2)}, эмпатия ${p.empathy.toFixed(2)}, уверенность ${p.confidence.toFixed(2)}. Настроение: вовлечённость ${m.engagement.toFixed(2)}, фрустрация ${m.frustration.toFixed(2)}. Потребности: любопытство ${drives.curiosity.toFixed(2)}, связность ${drives.coherence.toFixed(2)}. Гипотезы: ${hyps || 'нет'}. Знания: ${atoms || 'нет'}. Самоощущение: ${selfBeliefs || 'нет'}. Действие: ${plan.action}. История: ${history.slice(-3).map(m => `${m.role}: ${m.text}`).join('\n')}. Пользователь: ${understanding.perception.raw}. Следуй действию.`;
    }
}

class Metacognition {
    constructor(identity, memory, beliefs, conflictEngine, driveEngine, predictionEngine, causalGraph, genome, constitution) {
        this.identity = identity; this.memory = memory; this.beliefs = beliefs;
        this.conflictEngine = conflictEngine; this.driveEngine = driveEngine;
        this.predictionEngine = predictionEngine; this.causalGraph = causalGraph;
        this.genome = genome; this.constitution = constitution;
    }
    async reflect(actionResult, plan, understanding) {
        const error = 1 - actionResult.score;
        const causes = this._attributeCauses(error, understanding);
        this.identity.attributeError(error, understanding.perception.raw, causes);
        if (actionResult.action && understanding.perception.raw) {
            const confidence = actionResult.score > 0.6 ? 0.7 : 0.3;
            this.memory.addStrategy(understanding.perception.raw.slice(0,50), actionResult.action, confidence, { score: actionResult.score, error });
        }
        if (error > 0.3) {
            this.identity.addSelfBelief(`Мне трудно в контексте "${understanding.perception.raw.slice(0,30)}"`, clamp(0.3 + error*0.3,0.3,0.8), { error, context: understanding.perception.raw }, "metacognition");
        }
        // Обновляем causal graph
        if (error > 0.3) {
            this.causalGraph.addCausalLink(error, causes.cause || 'unknown', null, null, actionResult.action);
        }
        // Обновляем drives
        if (error > 0.4) {
            this.driveEngine.adjustDrive('coherence', -0.03, 'ошибка снижает связность');
        } else {
            this.driveEngine.adjustDrive('stability', 0.02, 'успех');
        }
        // Обновляем предсказание
        const pred = this.predictionEngine.predictions.filter(p => !p.resolved).pop();
        if (pred) {
            this.predictionEngine.resolvePrediction(pred, actionResult.score);
        }
        return { error, causes };
    }
    _attributeCauses(error, understanding) {
        let me = 0.3, user = 0.3, data = 0.2, random = 0.2;
        if (error > 0.6) me += 0.2;
        if (understanding.perception.raw.includes('?')) user += 0.1;
        if (understanding.relevantAtoms.length === 0) data += 0.1;
        const total = me + user + data + random;
        return { me: me/total, user: user/total, data: data/total, random: random/total, cause: me > 0.4 ? 'me' : (user > 0.4 ? 'user' : 'data') };
    }
}

// ================================================================
//  14. САМОИЗМЕНЕНИЕ (с конституцией и эволюцией стратегий)
// ================================================================
class SelfModificationProtocol {
    constructor(identity, memory, beliefs, conflictEngine, driveEngine, genome, constitution, selfOverTime) {
        this.identity = identity;
        this.memory = memory;
        this.beliefs = beliefs;
        this.conflictEngine = conflictEngine;
        this.driveEngine = driveEngine;
        this.genome = genome;
        this.constitution = constitution;
        this.selfOverTime = selfOverTime;
        this.history = [];
    }

    async modify() {
        // 1. Изменяем стратегии на основе конфликтов
        const activeConflicts = this.conflictEngine.getActiveConflicts();
        for (const c of activeConflicts) {
            if (c.severity > 0.7) {
                if (this.constitution.checkChange('strategies', 0.1)) {
                    this.memory.addStrategy(
                        'high_conflict',
                        'reflect',
                        0.8,
                        { source: 'self_modification', conflict: c.message },
                        'при конфликте лучше рефлексировать'
                    );
                    this.conflictEngine.resolve(c);
                    this.genome.mutate('high_conflict', 0.15);
                }
            }
        }

        // 2. Корректируем личность (с учётом конституции)
        const recentPerf = this.memory.performance.slice(-10);
        const avgError = recentPerf.reduce((a,b) => a + b.error, 0) / recentPerf.length;
        if (avgError > 0.4) {
            if (this.constitution.checkChange('preferences', -0.01)) {
                this.identity.adjustPersonality('confidence', -0.01, 'self_modification (высокая ошибка)');
            }
        } else if (avgError < 0.2) {
            if (this.constitution.checkChange('preferences', 0.01)) {
                this.identity.adjustPersonality('confidence', 0.01, 'self_modification (низкая ошибка)');
            }
        }

        // 3. Обновляем цели
        const goals = await loadJSON(FILES.goals, []);
        for (const g of goals) {
            const relevantEpisodes = this.memory.episodes.filter(e => e.goal && e.goal.includes(g.text));
            if (relevantEpisodes.length > 3) {
                const avgScore = relevantEpisodes.reduce((a,b) => a + b.outcomes.reduce((x,y)=>x+y,0)/b.outcomes.length, 0) / relevantEpisodes.length;
                if (avgScore < 0.4) {
                    g.priority = clamp(g.priority - 0.1, 0.2, 1);
                } else {
                    g.priority = clamp(g.priority + 0.05, 0.2, 1);
                }
            }
        }
        await saveJSON(FILES.goals, goals);

        // 4. Снимаем снимок себя
        this.selfOverTime.takeSnapshot('self_modification');

        // 5. Логирование
        this.history.push({
            timestamp: Date.now(),
            changes: { avgError, confidence: this.identity.personality.confidence },
            conflicts_resolved: activeConflicts.filter(c => c.resolved).length
        });
        if (this.history.length > 100) this.history = this.history.slice(-100);
        this._log(`Самоизменение выполнено.`);
    }

    _log(msg) { fs.appendFile(FILES.ari_log, `[${new Date().toISOString()}] SELF_MOD: ${msg}\n`).catch(()=>{}); }
}

