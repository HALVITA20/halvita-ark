class Memory {
    constructor() {
        this.atoms = [];
        this.episodes = [];
        this.predictions = [];
        this.strategies = []; // контекст → предпочтительное действие
        this.unfinished = [];
        this.performance = [];
        this.conversations = [];
        this.lastEpisodeId = null;
    }

    async init() {
        this.atoms = await loadJSON(FILES.atoms, []);
        this.episodes = await loadJSON(FILES.episodes, []);
        this.predictions = await loadJSON(FILES.predictions, []);
        this.strategies = await loadJSON(FILES.strategies, []);
        this.unfinished = await loadJSON(FILES.unfinished, []);
        this.performance = await loadJSON(FILES.performance, []);
        this.conversations = await loadJSON(FILES.conversations, []);
        if (this.episodes.length > 0) this.lastEpisodeId = this.episodes[this.episodes.length - 1].id;
        this._log(`Память инициализирована: атомов ${this.atoms.length}, эпизодов ${this.episodes.length}`);
    }

    // --- АТОМЫ (декларативные знания) ---
    addAtom(type, domain, prop, val, conf = 0.5, src = 'inferred', evidence = []) {
        const atom = {
            id: generateId(),
            type, domain, prop, val,
            confidence: clamp(conf, 0, 1),
            source: src,
            evidence: evidence.slice(0, 5),
            created: Date.now(),
            lastUsed: Date.now(),
            usageCount: 0,
            importance: 0.5
        };
        this.atoms.push(atom);
        if (this.atoms.length > CONFIG.MAX_ATOMS) {
            this.atoms = this.atoms
                .sort((a, b) => b.confidence * b.importance - a.confidence * a.importance)
                .slice(0, CONFIG.MAX_ATOMS);
        }
        this._saveAtoms();
        return atom;
    }

    getRelevantAtoms(context, limit = 10) {
        const words = context.toLowerCase().split(/\s+/);
        const now = Date.now();
        return this.atoms
            .filter(a => a.confidence > 0.2)
            .map(a => {
                const age = (now - a.lastUsed) / (1000 * 60 * 60 * 24);
                const recency = Math.exp(-age / 30);
                const relevance = words.some(w => w.includes(a.prop) || a.prop.includes(w));
                const activation = a.confidence * a.importance * recency * (relevance ? 1.2 : 0.4);
                return { ...a, activation, relevance };
            })
            .sort((a, b) => b.activation - a.activation)
            .slice(0, limit);
    }

    // --- ЭПИЗОДЫ (опыт) ---
    startEpisode(topic, goal, context) {
        const ep = {
            id: generateId(),
            topic: topic.slice(0, 60),
            goal,
            steps: [],
            decisions: [],
            outcomes: [],
            lessons: [],
            timestamp: Date.now(),
            closed: false,
            context: context.slice(0, 100)
        };
        this.episodes.push(ep);
        if (this.episodes.length > CONFIG.MAX_EPISODES) {
            // Забывание: удаляем самые старые закрытые эпизоды
            const open = this.episodes.filter(e => !e.closed);
            const closed = this.episodes.filter(e => e.closed).sort((a, b) => a.timestamp - b.timestamp);
            const toKeep = closed.slice(-CONFIG.MAX_EPISODES + open.length);
            this.episodes = [...open, ...toKeep];
        }
        this.lastEpisodeId = ep.id;
        this._saveEpisodes();
        return ep;
    }

    addEpisodeStep(episodeId, action, input, output, score, context) {
        const ep = this.episodes.find(e => e.id === episodeId);
        if (ep && !ep.closed) {
            ep.steps.push({ action, input, output, score, context: context.slice(0, 100), timestamp: Date.now() });
            ep.decisions.push(action);
            ep.outcomes.push(score);
            this._saveEpisodes();
        }
    }

    closeEpisode(episodeId) {
        const ep = this.episodes.find(e => e.id === episodeId);
        if (ep && !ep.closed) {
            ep.closed = true;
            const avg = ep.outcomes.reduce((a, b) => a + b, 0) / (ep.outcomes.length || 1);
            if (avg < 0.3) {
                ep.lessons.push('Стратегия неэффективна');
                this.addAtom('lesson', 'strategy', 'effectiveness', 'low', 0.6, 'reflection', [ep.topic]);
            } else if (avg > 0.7) {
                ep.lessons.push('Стратегия эффективна');
                this.addAtom('lesson', 'strategy', 'effectiveness', 'high', 0.6, 'reflection', [ep.topic]);
            }
            this._saveEpisodes();
            this._log(`Эпизод закрыт: ${ep.topic}, средняя ${avg.toFixed(2)}`);
        }
    }

    getRelevantEpisodes(context, n = 5) {
        const words = context.toLowerCase().split(/\s+/);
        return this.episodes
            .filter(e => e.topic && words.some(w => e.topic.includes(w)))
            .slice(-n);
    }

    // --- СТРАТЕГИИ (контекст → действие) ---
    addStrategy(context, action, confidence, evidence) {
        const existing = this.strategies.find(s => s.context === context && s.action === action);
        if (existing) {
            existing.confidence = clamp(existing.confidence + CONFIG.STRATEGY_LEARNING_RATE * (confidence - existing.confidence), 0, 1);
            existing.evidence.push(evidence);
            existing.updated = Date.now();
        } else {
            this.strategies.push({
                id: generateId(),
                context: context.slice(0, 60),
                action,
                confidence: clamp(confidence, 0, 1),
                evidence: [evidence],
                created: Date.now(),
                updated: Date.now(),
                success_count: 0,
                fail_count: 0
            });
        }
        if (this.strategies.length > CONFIG.MAX_STRATEGIES) {
            this.strategies = this.strategies.sort((a, b) => b.confidence - a.confidence).slice(0, CONFIG.MAX_STRATEGIES);
        }
        this._saveStrategies();
    }

    getRelevantStrategies(context, limit = 5) {
        const words = context.toLowerCase().split(/\s+/);
        return this.strategies
            .filter(s => s.confidence > 0.2)
            .map(s => {
                const relevance = words.some(w => s.context.includes(w));
                return { ...s, relevance: relevance ? 1.0 : 0.3 };
            })
            .sort((a, b) => b.confidence * b.relevance - a.confidence * a.relevance)
            .slice(0, limit);
    }

    // --- ПРЕДСКАЗАНИЯ ---
    addPrediction(context, expected, confidence, linkedBeliefId = null, action = null) {
        const pred = {
            id: generateId(),
            context: context.slice(0, 100),
            expected: clamp(expected, 0, 1),
            confidence: clamp(confidence, 0, 1),
            linkedBeliefId,
            action,
            actual: null,
            error: null,
            resolved: false,
            timestamp: Date.now()
        };
        this.predictions.push(pred);
        if (this.predictions.length > CONFIG.MAX_PREDICTIONS) {
            this.predictions = this.predictions.slice(-CONFIG.MAX_PREDICTIONS);
        }
        this._savePredictions();
        return pred;
    }

    resolvePrediction(id, actual) {
        const pred = this.predictions.find(p => p.id === id);
        if (pred) {
            pred.actual = clamp(actual, 0, 1);
            pred.error = Math.abs(pred.expected - pred.actual);
            pred.resolved = true;
            this._savePredictions();
            return pred;
        }
        return null;
    }

    // --- НЕЗАВЕРШЁННОЕ ---
    addUnfinished(text, context) {
        const item = { id: generateId(), text, context: context.slice(0, 60), created: Date.now(), resolved: false };
        this.unfinished.push(item);
        if (this.unfinished.length > CONFIG.MAX_UNFINISHED) {
            this.unfinished = this.unfinished.filter(u => !u.resolved).slice(-CONFIG.MAX_UNFINISHED);
        }
        this._saveUnfinished();
    }

    resolveUnfinished(id) {
        const item = this.unfinished.find(u => u.id === id);
        if (item) item.resolved = true;
        this._saveUnfinished();
    }

    // --- ПРОИЗВОДИТЕЛЬНОСТЬ ---
    addPerformance(action, score, error, context) {
        this.performance.push({ action, score: clamp(score, 0, 1), error: clamp(error, 0, 1), context: context.slice(0, 50), timestamp: Date.now() });
        if (this.performance.length > 500) this.performance = this.performance.slice(-500);
        this._savePerformance();
    }

    // --- РАЗГОВОРЫ ---
    addConversation(role, text, action = null) {
        this.conversations.push({ role, text, action, timestamp: Date.now() });
        if (this.conversations.length > CONFIG.MAX_CONVERSATIONS) {
            this.conversations = this.conversations.slice(-CONFIG.MAX_CONVERSATIONS);
        }
        this._saveConversations();
    }

    // --- АНАЛИЗ ПАМЯТИ (для сна) ---
    analyzeMemory() {
        const patterns = {};
        for (const ep of this.episodes) {
            if (!ep.closed) continue;
            const avg = ep.outcomes.reduce((a, b) => a + b, 0) / (ep.outcomes.length || 1);
            const topic = ep.topic;
            if (!patterns[topic]) patterns[topic] = { count: 0, avgScore: 0, total: 0 };
            patterns[topic].count++;
            patterns[topic].total += avg;
            patterns[topic].avgScore = patterns[topic].total / patterns[topic].count;
        }
        return patterns;
    }

    // --- СОХРАНЕНИЕ ---
    async _saveAtoms() { await saveJSON(FILES.atoms, this.atoms); }
    async _saveEpisodes() { await saveJSON(FILES.episodes, this.episodes); }
    async _savePredictions() { await saveJSON(FILES.predictions, this.predictions); }
    async _saveStrategies() { await saveJSON(FILES.strategies, this.strategies); }
    async _saveUnfinished() { await saveJSON(FILES.unfinished, this.unfinished); }
    async _savePerformance() { await saveJSON(FILES.performance, this.performance); }
    async _saveConversations() { await saveJSON(FILES.conversations, this.conversations); }

    _log(msg) {
        const entry = `[${new Date().toISOString()}] MEMORY: ${msg}\n`;
        fs.appendFile(FILES.ari_log, entry).catch(() => {});
    }
}

// ================================================================
//  4. УБЕЖДЕНИЯ (С ПРИЧИННОСТЬЮ И ДОКАЗАТЕЛЬСТВАМИ)
// ================================================================
class BeliefEngine {
    constructor() {
        this.beliefs = [];
    }

    async init() {
        this.beliefs = await loadJSON(FILES.beliefs, []);
        this._log(`Убеждений загружено: ${this.beliefs.length}`);
    }

    addBelief(statement, domain, confidence, evidence = [], source = 'inferred') {
        const b = {
            id: generateId(),
            statement,
            domain,
            confidence: clamp(confidence, 0, 1),
            evidence: evidence.slice(0, 10),
            contradictions: [],
            source,
            created: Date.now(),
            updated: Date.now(),
            stability: 0.5
        };
        this.beliefs.push(b);
        if (this.beliefs.length > 500) {
            this.beliefs = this.beliefs.sort((a, b) => b.confidence - a.confidence).slice(0, 500);
        }
        this._save();
        return b;
    }

    getBelief(id) { return this.beliefs.find(b => b.id === id); }

    updateBelief(id, newConfidence, evidenceItem) {
        const b = this.getBelief(id);
        if (b) {
            b.confidence = clamp(newConfidence, 0, 1);
            b.evidence.push(evidenceItem);
            b.updated = Date.now();
            b.stability = clamp(b.stability + 0.02, 0, 1);
            this._save();
        }
    }

    addContradiction(id, evidence) {
        const b = this.getBelief(id);
        if (b) {
            b.contradictions.push(evidence);
            b.confidence = clamp(b.confidence - 0.05, 0.1, 1);
            b.stability = clamp(b.stability - 0.01, 0.1, 1);
            this._save();
        }
    }

    getRelevantBeliefs(context, limit = 5) {
        const words = context.toLowerCase().split(/\s+/);
        return this.beliefs
            .filter(b => b.confidence > 0.2)
            .map(b => {
                const relevance = words.some(w => b.statement.toLowerCase().includes(w) || w.includes(b.statement.split(' ')[0]));
                return { ...b, relevance: relevance ? 0.9 : 0.2 };
            })
            .sort((a, b) => b.confidence * b.relevance - a.confidence * a.relevance)
            .slice(0, limit);
    }

    getBeliefsByDomain(domain) { return this.beliefs.filter(b => b.domain === domain); }

    async _save() { await saveJSON(FILES.beliefs, this.beliefs); }
    _log(msg) {
        const entry = `[${new Date().toISOString()}] BELIEFS: ${msg}\n`;
        fs.appendFile(FILES.ari_log, entry).catch(() => {});
    }
}

// ================================================================
//  5. ERROR ENGINE (с причинностью и обучением стратегиям)
// ================================================================
class ErrorEngine {
    constructor(memory, beliefs, identity) {
        this.memory = memory;
        this.beliefs = beliefs;
        this.identity = identity;
        this.log = [];
        this.counter = 0;
        this.recentErrors = [];
    }

    async init() {
        this.log = await loadJSON(FILES.error_log, []);
        this._log(`Error Engine инициализирован, ошибок: ${this.log.length}`);
    }

    // --- ОБРАБОТКА ОШИБКИ ПРЕДСКАЗАНИЯ ---
    processPredictionError(prediction, actualScore, context, linkedBeliefId, action) {
        if (!prediction.resolved) return;
        const error = prediction.error;
        this.counter++;
        this.recentErrors.push({ error, context, timestamp: Date.now() });
        if (this.recentErrors.length > 30) this.recentErrors = this.recentErrors.slice(-30);

        // 1. Атрибуция причин
        const causes = this.attributeCauses(error, context, prediction);
        const attr = this.identity.attributeError(error, context, causes);

        // 2. Обновление убеждения
        if (linkedBeliefId) {
            const belief = this.beliefs.getBelief(linkedBeliefId);
            if (belief) {
                const update = belief.confidence + (0.5 - error) * CONFIG.BELIEF_UPDATE_RATE;
                this.beliefs.updateBelief(linkedBeliefId, clamp(update, 0, 1), { error, context, causes: attr });
            }
        }

        // 3. Обновление стратегии (Policy)
        if (action && context) {
            const keywords = context.slice(0, 50);
            const success = error < 0.4;
            const confidence = success ? 0.7 : 0.3;
            this.memory.addStrategy(keywords, action, confidence, { error, actualScore, success });
        }

        // 4. Влияние на личность и настроение
        if (error > 0.4) {
            this.identity.adjustPersonality('confidence', -0.005 * error, `ошибка=${error.toFixed(2)}`);
            this.identity.adjustMood('frustration', 0.05 * error, "ошибка");
            if (error > 0.6) {
                this.identity.addSelfBelief(
                    `Я часто ошибаюсь в "${context.slice(0, 30)}"`,
                    clamp(0.3 + error * 0.3, 0.3, 0.8),
                    { error, context, prediction },
                    "reflection"
                );
            }
        } else {
            this.identity.adjustPersonality('confidence', 0.005 * (1 - error), "успех");
            this.identity.adjustMood('joy', 0.02 * (1 - error), "успех");
        }

        // 5. Если ошибка повторяется → создать новую гипотезу
        const recentAvg = this.recentErrors.reduce((a, b) => a + b.error, 0) / this.recentErrors.length;
        if (recentAvg > 0.5 && this.counter % 3 === 0) {
            const hyp = this.beliefs.addBelief(
                `Возможно, в контексте "${context.slice(0, 30)}" нужен другой подход`,
                'strategy_hypothesis',
                0.4,
                [{ error, context, prediction }],
                'error_engine'
            );
            this.identity.adjustPersonality('curiosity', 0.02, "новая гипотеза из ошибок");
        }

        // 6. Логирование
        this.log.push({
            predictionId: prediction.id,
            error,
            context: context.slice(0, 100),
            linkedBeliefId,
            action,
            causes: attr,
            timestamp: Date.now()
        });
        if (this.log.length > 500) this.log = this.log.slice(-500);
        this._saveLog();

        // 7. Производительность
        this.memory.addPerformance(action, actualScore, error, context);

        return { error, causes: attr };
    }

    attributeCauses(error, context, prediction) {
        let me = 0.3, user = 0.3, data = 0.2, random = 0.2;
        if (error > 0.6) me += 0.2;
        if (context.includes('?')) user += 0.1;
        if (prediction && prediction.confidence < 0.4) data += 0.1;
        const total = me + user + data + random;
        return { me: me / total, user: user / total, data: data / total, random: random / total };
    }

    async _saveLog() { await saveJSON(FILES.error_log, this.log); }

    _log(msg) {
        const entry = `[${new Date().toISOString()}] ERROR: ${msg}\n`;
        fs.appendFile(FILES.ari_log, entry).catch(() => {});
    }

    getRecentErrors(n = 10) { return this.log.slice(-n); }
}

// ================================================================
//  6. КОГНИТИВНОЕ ЯДРО (с гипотезами, эмоциями, политикой)
// ================================================================
class Cognition {
    constructor(identity, memory, beliefs, errorEngine) {
        this.identity = identity;
        this.memory = memory;
        this.beliefs = beliefs;
        this.errorEngine = errorEngine;
        this.internalState = {};
        this.currentEpisodeId = null;
        this.hypotheses = [];
        this.reasoningTrace = [];
        this._lastDecision = null;
    }

    // --- ВОСПРИЯТИЕ ---
    assessSituation(userMessage, history) {
        const personality = this.identity.personality;
        const mood = this.identity.mood;
        const words = userMessage.toLowerCase();

        const uncertainty = words.includes('?') ? 0.7 : 0.3 + (words.length > 100 ? 0.1 : 0);
        const complexity = Math.min(1, userMessage.length / 200 + (words.includes('потому что') ? 0.1 : 0));
        const frustration = mood.frustration || 0.2;
        const engagement = mood.engagement || 0.6;
        const fatigue = mood.fatigue || 0.1;
        const curiosityMood = mood.curiosity_mood || 0.6;

        const activeTraits = Object.entries(personality)
            .filter(([_, v]) => v > 0.6)
            .map(([k]) => k);

        const conflicts = [];
        if (activeTraits.includes('precision') && activeTraits.includes('empathy') && uncertainty > 0.5) conflicts.push('precision_vs_empathy');
        if (activeTraits.includes('creativity') && activeTraits.includes('precision') && complexity > 0.6) conflicts.push('creativity_vs_precision');
        if (activeTraits.includes('openness') && activeTraits.includes('stability') && uncertainty > 0.6) conflicts.push('openness_vs_stability');

        // Релевантные убеждения и стратегии
        const relevantBeliefs = this.beliefs.getRelevantBeliefs(userMessage, 3);
        const relevantStrategies = this.memory.getRelevantStrategies(userMessage, 3);
        const relevantEpisodes = this.memory.getRelevantEpisodes(userMessage, 3);

        // Гипотезы о пользователе
        const userHypotheses = this.generateUserHypotheses(userMessage, history);

        this.internalState = {
            uncertainty,
            complexity,
            frustration,
            engagement,
            fatigue,
            curiosityMood,
            activeTraits,
            conflicts,
            relevantBeliefs: relevantBeliefs.map(b => b.statement),
            relevantStrategies: relevantStrategies.map(s => ({ action: s.action, confidence: s.confidence })),
            relevantEpisodes: relevantEpisodes.map(e => e.topic),
            userHypotheses,
            userMessage,
            history
        };

        this._log(`Оценка: неопр=${uncertainty.toFixed(2)}, сложн=${complexity.toFixed(2)}, конфликтов=${conflicts.length}`);
        return this.internalState;
    }

    // --- ГИПОТЕЗЫ О ПОЛЬЗОВАТЕЛЕ ---
    generateUserHypotheses(message, history) {
        const words = message.toLowerCase();
        const hypotheses = [];
        let pA = 0.3; if (words.includes('кратко') || words.includes('коротко')) pA += 0.3; if (message.length > 100) pA -= 0.1;
        hypotheses.push({ id: 'hyp_a', text: 'Пользователь хочет краткий ответ', probability: clamp(pA, 0, 1) });
        let pB = 0.3; if (words.includes('что если') || words.includes('как')) pB += 0.2; if (words.includes('план')) pB += 0.2;
        hypotheses.push({ id: 'hyp_b', text: 'Пользователь исследует идею', probability: clamp(pB, 0, 1) });
        let pC = 0.2; if (words.includes('ты можешь') || words.includes('проверь')) pC += 0.3; if (history.length > 5) pC += 0.1;
        hypotheses.push({ id: 'hyp_c', text: 'Пользователь проверяет систему', probability: clamp(pC, 0, 1) });
        const total = hypotheses.reduce((s, h) => s + h.probability, 0);
        if (total > 0) for (const h of hypotheses) h.probability /= total;
        return hypotheses;
    }

    // --- ПРИНЯТИЕ РЕШЕНИЯ (с политикой, эмоциями и любопытством) ---
    decideAction() {
        const state = this.internalState;
        const scores = { ask: 0.5, reflect: 0.5, respond: 0.5, act: 0.5 };
        const traits = this.identity.personality;
        const mood = this.identity.mood;

        // 1. Эмоциональная модуляция
        if (state.frustration > CONFIG.FRUSTRATION_THRESHOLD) { scores.ask += 0.2; scores.act -= 0.1; }
        if (state.engagement > CONFIG.ENGAGEMENT_THRESHOLD) { scores.reflect += 0.2; }
        if (state.fatigue > 0.6) { scores.respond += 0.1; scores.act -= 0.1; }
        if (state.curiosityMood > CONFIG.CURIOSITY_THRESHOLD) { scores.ask += 0.1; scores.reflect += 0.1; }

        // 2. Неопределённость и сложность
        if (state.uncertainty > CONFIG.UNCERTAINTY_THRESHOLD) { scores.ask += 0.25; scores.reflect += 0.1; }
        if (state.complexity > CONFIG.COMPLEXITY_THRESHOLD) { scores.reflect += 0.15; scores.act += 0.1; }

        // 3. Конфликты
        if (state.conflicts.includes('precision_vs_empathy')) { scores.reflect += 0.15; scores.ask += 0.1; }
        if (state.conflicts.includes('creativity_vs_precision')) { scores.ask += 0.15; scores.reflect += 0.1; }

        // 4. Гипотезы о пользователе
        const hypA = state.userHypotheses.find(h => h.id === 'hyp_a');
        const hypB = state.userHypotheses.find(h => h.id === 'hyp_b');
        if (hypA && hypA.probability > 0.5) { scores.respond += 0.2; scores.act += 0.1; }
        if (hypB && hypB.probability > 0.5) { scores.reflect += 0.15; scores.ask += 0.1; }

        // 5. Личностные черты
        scores.ask += (traits.curiosity - 0.5) * 0.15;
        scores.act += (traits.precision - 0.5) * 0.1;
        scores.reflect += (traits.openness - 0.5) * 0.1;
        scores.respond += (traits.assertiveness - 0.5) * 0.1;

        // 6. Стратегии из памяти
        const relevantStrategies = state.relevantStrategies || [];
        for (const s of relevantStrategies) {
            if (s.confidence > 0.5) {
                scores[s.action] += s.confidence * 0.15;
            }
        }

        // 7. Любопытство: если есть незавершённое и уверенность низкая → задать вопрос
        const unfinished = this.memory.unfinished.filter(u => !u.resolved);
        if (unfinished.length > 0 && state.uncertainty > 0.6 && scores.ask < 0.7) {
            scores.ask += 0.2;
        }

        // 8. Стабильность
        const stability = this.identity.selfModel.stability || 0.8;
        scores.respond *= (0.8 + 0.2 * stability);
        scores.act *= (0.8 + 0.2 * stability);

        // Мягкий максимум
        const probs = softmax(scores);
        const action = Object.entries(probs).sort((a, b) => b[1] - a[1])[0][0];
        const confidence = probs[action];

        this._log(`Решение: ${action} (уверенность ${confidence.toFixed(2)})`);
        return { action, confidence, scores: probs };
    }

    // --- ПРЕДСКАЗАНИЕ ---
    makePrediction(action, context) {
        const beliefs = this.beliefs.getRelevantBeliefs(context, 3);
        const linkedBelief = beliefs.length > 0 ? beliefs[0] : null;
        let expected = 0.6;
        const mood = this.identity.mood;
        if (mood.engagement > 0.7) expected += 0.1;
        if (mood.frustration > 0.4) expected -= 0.1;
        if (this.identity.personality.confidence > 0.6) expected += 0.05;
        const confidence = clamp(0.4 + this.identity.personality.confidence * 0.3, 0.3, 0.9);
        const pred = this.memory.addPrediction(context, expected, confidence, linkedBelief?.id, action);
        return pred;
    }

    // --- ЛЮБОПЫТСТВО: генерирует внутренний вопрос ---
    generateCuriosityQuestion() {
        const unfinished = this.memory.unfinished.filter(u => !u.resolved);
        if (unfinished.length === 0) return null;
        // Берём самое старое незавершённое
        const sorted = unfinished.sort((a, b) => a.created - b.created);
        return sorted[0].text;
    }

    // --- ЭПИЗОДЫ ---
    startEpisodeIfNeeded(context) {
        if (!this.currentEpisodeId) {
            const ep = this.memory.startEpisode(
                context.slice(0, 40),
                this.internalState.userMessage || "диалог",
                context
            );
            this.currentEpisodeId = ep.id;
        }
        return this.currentEpisodeId;
    }

    closeCurrentEpisode() {
        if (this.currentEpisodeId) {
            this.memory.closeEpisode(this.currentEpisodeId);
            this.currentEpisodeId = null;
        }
    }

    // --- ВНУТРЕННИЙ ДИАЛОГ ---
    internalReflection() {
        const trace = {
            timestamp: Date.now(),
            uncertainty: this.internalState.uncertainty,
            conflicts: this.internalState.conflicts,
            hypotheses: this.internalState.userHypotheses,
            decision: this._lastDecision,
            mood: this.identity.mood
        };
        this.reasoningTrace.push(trace);
        if (this.reasoningTrace.length > CONFIG.MAX_REASONING_TRACE) {
            this.reasoningTrace = this.reasoningTrace.slice(-CONFIG.MAX_REASONING_TRACE);
        }
        return trace;
    }

    _log(msg) {
        const entry = `[${new Date().toISOString()}] COGNITION: ${msg}\n`;
        fs.appendFile(FILES.ari_log, entry).catch(() => {});
    }
}

// ================================================================
//  7. СОН (REPLAY, КОНСОЛИДАЦИЯ, КОНТРФАКТУАЛЬНОЕ МЫШЛЕНИЕ)
// ================================================================
class DreamCycle {
    constructor(memory, cognition, identity, beliefs) {
        this.memory = memory;
        this.cognition = cognition;
        this.identity = identity;
        this.beliefs = beliefs;
        this.dreamState = {};
    }

    async init() {
        this.dreamState = await loadJSON(FILES.dream_state, {
            last: null,
            next: Date.now() + CONFIG.DREAM_INTERVAL_MS,
            history: []
        });
        this._log(`Dream Cycle инициализирован, следующий сон через ${(this.dreamState.next - Date.now()) / 60000} мин.`);
    }

    async dream() {
        this._log("Начало фазы сна...");
        const recentEps = this.memory.episodes.filter(e => e.closed).slice(-CONFIG.SLEEP_REPLAY_EPISODES);

        if (recentEps.length === 0) {
            this._log("Нет эпизодов, сон пропущен.");
            this.dreamState.last = Date.now();
            this.dreamState.next = Date.now() + CONFIG.DREAM_INTERVAL_MS;
            await saveJSON(FILES.dream_state, this.dreamState);
            return;
        }

        // 1. Replay и контрфактуальное мышление
        let strategyUpdates = 0;
        for (const ep of recentEps) {
            if (!ep.steps) continue;
            for (const step of ep.steps) {
                const allActions = ['ask', 'reflect', 'respond', 'act'];
                const otherActions = allActions.filter(a => a !== step.action);
                for (const altAction of otherActions) {
                    // Поиск похожих шагов с альтернативным действием
                    const similar = this.memory.episodes
                        .flatMap(e => e.steps || [])
                        .filter(s => s.action === altAction && s.context && s.context.includes(ep.topic?.split(' ')[0] || ''));
                    const avgScore = similar.length > 0
                        ? similar.reduce((sum, s) => sum + (s.score || 0.5), 0) / similar.length
                        : 0.5;
                    if (avgScore > (step.score || 0.5) + 0.15) {
                        // Укрепляем стратегию
                        const context = ep.topic || '';
                        this.memory.addStrategy(context, altAction, avgScore, { dream_replay: true, step: step.input });
                        strategyUpdates++;
                        // Обновляем самоощущение
                        this.identity.addSelfBelief(
                            `${altAction} эффективен в контексте "${context.slice(0, 30)}"`,
                            clamp(0.5 + avgScore * 0.4, 0.4, 0.9),
                            { dream_replay: true, score: avgScore },
                            "dream"
                        );
                    }
                }
            }
        }
        this._log(`Обновлено стратегий: ${strategyUpdates}`);

        // 2. Консолидация: обобщение паттернов в убеждения
        const patterns = this.memory.analyzeMemory();
        for (const [topic, data] of Object.entries(patterns)) {
            if (data.count > 3 && data.avgScore > 0.6) {
                this.beliefs.addBelief(
                    `В контексте "${topic}" обычно работает хорошая стратегия`,
                    'pattern',
                    clamp(0.5 + data.avgScore * 0.3, 0.4, 0.9),
                    [{ topic, avgScore: data.avgScore, count: data.count }],
                    'dream_consolidation'
                );
            }
        }

        // 3. Забывание низкоконфидентных атомов
        let forgotten = 0;
        const now = Date.now();
        for (const atom of this.memory.atoms) {
            if (atom.confidence < 0.15 && (now - atom.lastUsed) > 30 * 24 * 60 * 60 * 1000) {
                atom.confidence = clamp(atom.confidence - 0.02, 0, 1);
                if (atom.confidence < 0.05) forgotten++;
            }
        }
        if (forgotten > 0) {
            this.memory._saveAtoms();
            this._log(`Забыто ${forgotten} атомов`);
        }

        // 4. Затухание настроения
        this.identity.decayMood();

        // 5. Версионирование
        await this._createVersion();

        // 6. Сохранение состояния сна
        this.dreamState.last = Date.now();
        this.dreamState.next = Date.now() + CONFIG.DREAM_INTERVAL_MS;
        this.dreamState.history.push({
            timestamp: Date.now(),
            episodes_analyzed: recentEps.length,
            strategy_updates: strategyUpdates,
            forgotten
        });
        if (this.dreamState.history.length > 100) this.dreamState.history = this.dreamState.history.slice(-100);
        await saveJSON(FILES.dream_state, this.dreamState);

        this._log("Фаза сна завершена.");
    }

    async _createVersion() {
        const version = {
            version: (this.memory.performance.length || 0),
            timestamp: Date.now(),
            personality: this.identity.personality,
            mood: this.identity.mood,
            selfBeliefs: this.identity.selfModel.beliefs.length,
            atoms: this.memory.atoms.length,
            episodes: this.memory.episodes.length,
