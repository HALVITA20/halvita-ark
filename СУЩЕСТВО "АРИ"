function processObservation(text) {
    // 1. Извлечение сырых наблюдений
    const candidates = extractBeliefs(text);

    // 2. Валидация каждого кандидата
    const validated = candidates.map(c => validateCandidate(c));

    // 3. Сохранение в память только валидных
    for (const candidate of validated) {
        if (candidate.valid) {
            beliefMemory.add(candidate.belief);
