3. Правильное ограничение влияния убеждений в decision
javascript
// core/decision.js

function decide(context) {
    const weights = state.weights;
    const beliefs = beliefMemory.getRelevant(context);

    // Базовые scores
    let baseScores = {
        ask: context.uncertainty * weights.ask,
        act: (context.hasPlan ? 0.8 : 0) * weights.act,
        reflect: context.questionDepth * weights.reflect,
        respond: 0.5 * weights.respond
    };

    // Копируем для модификации
    let scores = { ...baseScores };
    const influenceLimit = 0.2;

    // Применяем убеждения с ограничением
    for (const belief of beliefs) {
        const effConf = belief.effectiveConfidence || belief.confidence;
        const maxImpact = influenceLimit * effConf;

        if (belief.type === 'preference' || belief.type === 'rule') {
            if (belief.property === 'structure' && belief.value === 'high') {
                scores.act = Math.min(1, scores.act + maxImpact * 0.5);
            }
            if (belief.property === 'depth' && belief.value === 'high') {
                scores.reflect = Math.min(1, scores.reflect + maxImpact * 0.5);
            }
            if (belief.property === 'brevity' && belief.value === 'high') {
                scores.respond = Math.min(1, scores.respond + maxImpact * 0.5);
            }
            if (belief.property === 'technical' && belief.value === 'high') {
                scores.act = Math.min(1, scores.act + maxImpact * 0.3);
                scores.respond = Math.max(0, scores.respond - maxImpact * 0.1);
            }
        }
        if (belief.type === 'avoidance') {
            if (belief.property === 'depth' && belief.value === 'low') {
                scores.reflect = Math.max(0, scores.reflect - maxImpact * 0.5);
                scores.respond = Math.min(1, scores.respond + maxImpact * 0.3);
            }
            if (belief.property === 'brevity' && belief.value === 'low') {
                scores.respond = Math.max(0, scores.respond - maxImpact * 0.5);
                scores.act = Math.min(1, scores.act + maxImpact * 0.3);
            }
        }
    }

    // Нормализуем, чтобы суммы не выходили за пределы 0..1
    // (в реальности они используются для выбора, так что порядок важен)
    const maxScore = Math.max(...Object.values(scores), 0.01);
    for (let key in scores) {
        scores[key] = scores[key] / maxScore;
    }

    // Исследование при стрике
    if (state.streak > 3) {
        const actions = Object.keys(scores).filter(a => a !== state.lastAction);
        const action = actions[Math.floor(Math.random() * actions.length)];
        state.explorationCount += 1;
        return { action, confidence: 0.3, exploration: true };
    }

    const action = Object.entries(scores).sort((a, b) => b[1] - a[1])[0][0];
    const confidence = scores[action];
    return { action, confidence, exploration: false };
