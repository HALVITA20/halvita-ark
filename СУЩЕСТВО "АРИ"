async function getEmbedding(text) {
    try {
        const r = await fetch("http://localhost:11434/api/embeddings", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ model: CONFIG.EMBEDDING_MODEL, prompt: text })
        });
        if (!r.ok) throw new Error("embedding error");
        const d = await r.json();
        return d.embedding;
    } catch { return null; }
}

function cosine(a, b) {
    if (!a || !b || a.length !== b.length) return 0;
    let dot=0, ma=0, mb=0;
    for (let i=0; i<a.length; i++) { dot+=a[i]*b[i]; ma+=a[i]*a[i]; mb+=b[i]*b[i]; }
    return ma && mb ? dot / (Math.sqrt(ma)*Math.sqrt(mb)) : 0;
}

async function recall(query, limit=CONFIG.MAX_VECTOR_RESULTS) {
    if (!vectorMemory.length) return [];
    const emb = await getEmbedding(query);
    if (!emb) return [];
    const scored = vectorMemory.map(item => ({
        ...item,
        score: cosine(emb, item.embedding)
    }));
    scored.sort((a,b) => b.score - a.score);
    const core = scored.filter(i => i.importance > 0.8).slice(0, 3);
    const rest = scored.filter(i => i.importance <= 0.8).slice(0, limit);
    return [...core, ...rest].slice(0, limit);
}

async function remember(role, text, importance=0.5, emotion='neutral', protocol=null) {
    if (!text || text.length < 5) return;
    const emb = await getEmbedding(text);
    if (!emb) return;
    vectorMemory.push({
        role, text, embedding: emb, timestamp: Date.now(),
        importance, emotion, protocol,
        layer: importance > 0.8 ? "core" : (importance > 0.5 ? "important" : "casual")
    });
    if (vectorMemory.length > CONFIG.MAX_VECTOR_MEMORIES) {
        vectorMemory = vectorMemory.filter(i => i.importance > CONFIG.FORGET_THRESHOLD || i.layer === "core");
        vectorMemory = vectorMemory.slice(-CONFIG.MAX_VECTOR_MEMORIES);
    }
    saveJSON(PATHS.vector, vectorMemory);
}

