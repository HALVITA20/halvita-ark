class Memory {
    constructor() {
        this.atoms = loadJSON(FILES.atoms, []);
        this.episodes = loadJSON(FILES.episodic, []);
        this.semantic = loadJSON(FILES.semantic, []);
        this.predictions = loadJSON(FILES.predictions, []);
        this.lessons = loadJSON(FILES.lessons, []);
        this.conversations = loadJSON(FILES.conversations, []);
        this.currentEpisode = null;
    }

    // --- АТОМЫ (когнитивные единицы) ---
    addAtom(type, domain, property, value, confidence = 0.5, source = 'inferred', evidence = []) {
        const existing = this.atoms.find(a =>
            a.type === type && a.domain === domain && a.property === property && a.value === value
        );
        if (existing && existing.status !== 'deleted') {
            existing.confidence = Math.min(1, existing.confidence + 0.05);
            existing.confirmations = (existing.confirmations || 0) + 1;
            existing.lastConfirmed = Date.now();
            existing.doubt = Math.max(0, existing.doubt - 0.02);
            if (evidence.length) existing.evidence.push(...evidence.slice(0, 3));
            if (existing.evidence.length > 10) existing.evidence = existing.evidence.slice(-10);
            this._saveAtoms();
            return existing;
        }
        const atom = {
            id: crypto.randomUUID(),
            type,
            domain,
            property,
            value,
            confidence,
            doubt: 0.2,
            source,
            evidence: evidence.slice(0, 10),
            created: Date.now(),
            lastConfirmed: Date.now(),
            status: 'active',      // active, doubtful, frozen, deleted
            confirmations: 0
        };
        this.atoms.push(atom);
        if (this.atoms.length > CONFIG.MAX_ATOMS) {
            this.atoms = this.atoms.filter(a => a.status !== 'deleted')
                .sort((a,b) => b.confidence - a.confidence)
                .slice(0, CONFIG.MAX_ATOMS);
        }
        this._saveAtoms();
        return atom;
    }

    getRelevantAtoms(context, limit = 7) {
        const words = (context || '').toLowerCase().split(/\s+/);
        const now = Date.now();
        return this.atoms
            .filter(a => a.status !== 'deleted' && a.status !== 'frozen')
            .map(a => {
                const ageDays = (now - a.lastConfirmed) / (1000*60*60*24);
                const decay = Math.exp(-ageDays / CONFIG.DECAY_DAYS);
                const eff = a.confidence * decay * (1 - a.doubt * 0.4);
                const relevance = words.some(w => w.includes(a.property) || a.property.includes(w));
                return { ...a, effectiveConfidence: eff, relevance };
            })
            .sort((a,b) => b.effectiveConfidence - a.effectiveConfidence)
            .slice(0, limit);
    }

    // --- ЭПИЗОДЫ ---
    startEpisode(topic, goal) {
        this.currentEpisode = {
            id: crypto.randomUUID(),
            topic,
            goal,
            steps: [],
            decisions: [],
            outcomes: [],
            lessons: [],
            timestamp: Date.now(),
            closed: false
        };
    }

    addEpisodeStep(action, input, output, score, context) {
        if (this.currentEpisode && !this.currentEpisode.closed) {
            this.currentEpisode.steps.push({
                action, input, output, score,
                context: context || '',
                timestamp: Date.now()
            });
            this.currentEpisode.decisions.push(action);
            this.currentEpisode.outcomes.push(score);
        }
    }

    closeEpisode() {
        if (this.currentEpisode && !this.currentEpisode.closed) {
            this.currentEpisode.closed = true;
            const avgScore = this.currentEpisode.outcomes.reduce((a,b) => a+b, 0) / this.currentEpisode.outcomes.length;
            if (avgScore < 0.3) {
                this.currentEpisode.lessons.push('Стратегия была неэффективна, нужно изменить подход.');
            } else if (avgScore > 0.7) {
                this.currentEpisode.lessons.push('Текущая стратегия работает, стоит её закрепить.');
            }
            this.episodes.push(this.currentEpisode);
            if (this.episodes.length > CONFIG.MAX_EPISODES) {
                this.episodes = this.episodes.slice(-CONFIG.MAX_EPISODES);
            }
            this._saveEpisodes();
            this.currentEpisode = null;
        }
    }

    // --- ПРЕДСКАЗАНИЯ ---
    addPrediction(context, expected, confidence, action) {
        this.predictions.push({
            id: crypto.randomUUID(),
            context,
            expected,
            confidence,
            action,
            actual: null,
            error: null,
            timestamp: Date.now(),
            resolved: false
        });
        if (this.predictions.length > CONFIG.MAX_PREDICTIONS) {
            this.predictions = this.predictions.slice(-CONFIG.MAX_PREDICTIONS);
        }
        this._savePredictions();
    }

    resolvePrediction(actual) {
        const last = this.predictions.filter(p => !p.resolved).pop();
        if (last) {
            last.actual = actual;
            last.error = Math.abs(last.confidence - actual);
            last.resolved = true;
            if (last.error > 0.3) {
                this.lessons.push({
                    id: crypto.randomUUID(),
                    type: 'prediction_error',
                    context: last.context,
                    expected: last.expected,
                    actual: actual,
                    error: last.error,
                    lesson: `Ошибка в предсказании: ожидал ${last.confidence.toFixed(2)}, получил ${actual.toFixed(2)}.`,
                    confidence: 0.6,
                    created: Date.now(),
                    applied: false
                });
                if (this.lessons.length > CONFIG.MAX_LESSONS) {
                    this.lessons = this.lessons.slice(-CONFIG.MAX_LESSONS);
                }
                this._saveLessons();
            }
            this._savePredictions();
        }
    }

    getRelevantLessons(context) {
        const words = (context || '').toLowerCase().split(/\s+/);
        return this.lessons
            .filter(l => !l.applied)
            .map(l => {
                const relevance = words.some(w => l.context.includes(w) || w.includes(l.context)) ? 0.8 : 0.1;
                return { ...l, relevance };
            })
            .sort((a,b) => b.relevance - a.relevance)
            .slice(0, 3);
    }

    markLessonApplied(id) {
        const l = this.lessons.find(ls => ls.id === id);
        if (l) l.applied = true;
        this._saveLessons();
    }

    // --- СОХРАНЕНИЕ ---
    _saveAtoms() { saveJSON(FILES.atoms, this.atoms); }
    _saveEpisodes() { saveJSON(FILES.episodic, this.episodes); }
    _savePredictions() { saveJSON(FILES.predictions, this.predictions); }
    _saveLessons() { saveJSON(FILES.lessons, this.lessons); }
}

// ================================================================
//  6.  КОГНИТИВНЫЙ ЦИКЛ
// ================================================================
class Cognition {
    constructor(memory, state, selfModel, character) {
        this.memory = memory;
        this.state = state;
        this.selfModel = selfModel;
        this.character = character;
        this.dilemmas = loadJSON(FILES.dilemma, []);
        this.curiosity = loadJSON(FILES.curiosity, { unanswered: [], last_question: null });
    }

    // --- ВОСПРИЯТИЕ ---
    perceive(userMessage, history) {
        const state = this.state;
        return {
            userMessage,
            history: history.slice(-10),
            goal: state.goals.current || 'понимание',
            uncertainty: userMessage.includes('?') ? 0.7 : 0.3,
            hasPlan: userMessage.includes('план') ? 0.8 : 0,
            questionDepth: userMessage.split('?').length - 1,
            emotional: { ...state.emotional },
            attention: { ...state.attention },
            topic: userMessage.length > 80 ? 'complex' : 'simple'
        };
    }

    // --- ПОНИМАНИЕ (смысл и интенция) ---
    understand(context) {
        const words = context.userMessage.toLowerCase();
        let intent = 'unknown';
        let hiddenNeed = null;
        let risk = 0.2;

        if (words.includes('?')) intent = 'question';
        else if (words.includes('!')) intent = 'strong_statement';
        else intent = 'statement';

        if (words.includes('помоги') || words.includes('подскажи')) hiddenNeed = 'support';
        else if (words.includes('проверь') || words.includes('оцени')) hiddenNeed = 'validation';
        else if (words.includes('объясни') || words.includes('расскажи')) hiddenNeed = 'understanding';

        if (context.userMessage.length > 200) risk += 0.1;
        if (words.includes('срочно') || words.includes('важно')) risk += 0.2;

        return { intent, hiddenNeed, risk, focus: context.attention.focus || 'общее' };
    }

    // --- ПРЕДСКАЗАНИЕ (оценка будущего результата) ---
    predict(context) {
        const base = 0.5;
        const mood = context.emotional.confidence || 0.5;
        const depth = context.attention.depth || 0.5;
        return Math.min(1, base + (mood - 0.5) * 0.3 + (depth - 0.5) * 0.2);
    }

    // --- ДИЛЕММА-ДВИГАТЕЛЬ ---
    processDilemmas(context) {
        const tensions = this.selfModel.getTensions();
        const activeTensions = tensions.filter(t => t.value > CONFIG.DILEMMA_TENSION_THRESHOLD);
        if (activeTensions.length === 0) return null;

        const top = activeTensions.sort((a,b) => b.value - a.value)[0];
        const result = {
            type: 'dilemma',
            tension: top,
            resolution: null
        };

        if (top.a === 'depth' && top.b === 'brevity') {
            result.resolution = 'Краткий, но глубокий ответ.';
        } else if (top.a === 'helpfulness' && top.b === 'honesty') {
            result.resolution = 'Скажу честно, даже если это неудобно.';
        } else {
            result.resolution = `Сбалансировать ${top.a} и ${top.b}.`;
        }

        this.dilemmas.push({ ...result, timestamp: Date.now() });
        if (this.dilemmas.length > 50) this.dilemmas = this.dilemmas.slice(-50);
        saveJSON(FILES.dilemma, this.dilemmas);
        return result;
    }

    // --- ЛЮБОПЫТСТВО ---
    processCuriosity(context) {
        const curiosity = this.character.get().curiosity || 0.5;
        if (curiosity < CONFIG.CURIOSITY_THRESHOLD) return null;

        const unfinished = this.state.getActiveUnfinished();
        if (unfinished.length === 0) return null;

        if (Math.random() < 0.25) {
            const q = unfinished[Math.floor(Math.random() * unfinished.length)];
            this.curiosity.last_question = q.text;
            this.curiosity.unanswered.push(q.text);
            if (this.curiosity.unanswered.length > 20) this.curiosity.unanswered = this.curiosity.unanswered.slice(-20);
            saveJSON(FILES.curiosity, this.curiosity);
            return q.text;
        }
        return null;
    }

    // --- ВЫБОР ДЕЙСТВИЯ ---
    decide(context, understanding, dilemma, curiosity) {
        const weights = this.state.weights;
        let scores = {
            ask: context.uncertainty * weights.ask,
            act: (context.hasPlan ? 0.8 : 0) * weights.act,
            reflect: context.questionDepth * weights.reflect,
            respond: 0.5 * weights.respond
        };

        // Влияние когнитивных атомов (макс. 20%)
        const atoms = this.memory.getRelevantAtoms(context.userMessage);
        for (const atom of atoms) {
            const impact = atom.effectiveConfidence * CONFIG.MAX_INFLUENCE;
            if (atom.type === 'preference' || atom.type === 'habit') {
                if (atom.property === 'structure' && atom.value === 'high') scores.act += impact * 0.5;
                if (atom.property === 'depth' && atom.value === 'high') scores.reflect += impact * 0.5;
                if (atom.property === 'brevity' && atom.value === 'high') scores.respond += impact * 0.5;
            }
            if (atom.type === 'constraint') {
                if (atom.property === 'depth' && atom.value === 'low') scores.reflect -= impact * 0.5;
            }
        }

        // Влияние дилеммы
        if (dilemma) {
            scores.reflect += 0.1;
            scores.ask += 0.1;
        }

        // Любопытство → вопрос
        if (curiosity) {
            scores.ask += 0.2;
        }

        // Уроки из ошибок
        const lessons = this.memory.getRelevantLessons(context.userMessage);
        for (const lesson of lessons) {
            if (lesson.lesson.includes('ошибка')) {
                scores.ask += 0.1;
                scores.reflect += 0.1;
            }
            this.memory.markLessonApplied(lesson.id);
        }

        // Нормализация
        const max = Math.max(...Object.values(scores), 0.01);
        for (let k in scores) scores[k] /= max;

        // Принудительное исследование при зацикливании
        if (this.state.streak > CONFIG.EXPLORATION_THRESHOLD) {
            const actions = Object.keys(scores).filter(a => a !== this.state.lastAction);
            const action = actions[Math.floor(Math.random() * actions.length)];
            return { action, confidence: 0.3, exploration: true };
        }

        const action = Object.entries(scores).sort((a,b) => b[1] - a[1])[0][0];
        return { action, confidence: scores[action], exploration: false };
    }
}

// ================================================================
//  7.  СОН — DREAM CYCLE (консолидация, забывание, версионирование)
// ================================================================
class DreamCycle {
    constructor(memory, state, selfModel, character) {
        this.memory = memory;
        this.state = state;
        this.selfModel = selfModel;
        this.character = character;
        this.dreamState = loadJSON(FILES.dream_state, {
            last_dream: null,
            next_dream: Date.now() + CONFIG.DREAM_INTERVAL_MS,
            history: []
        });
    }

    async dream() {
        console.log('[DREAM] Начало фазы сна...');

        // 1. Консолидация эпизодов
        if (this.memory.episodes.length > 0) {
            const lastEpisode = this.memory.episodes[this.memory.episodes.length - 1];
            if (lastEpisode && lastEpisode.closed) {
                const avgScore = lastEpisode.outcomes.reduce((a,b) => a+b, 0) / lastEpisode.outcomes.length;
                if (avgScore < 0.4) {
                    // Усиливаем сомнение в атомах этой темы
                    const atoms = this.memory.atoms.filter(a => a.domain === lastEpisode.topic);
                    for (const atom of atoms) {
                        atom.doubt = Math.min(0.9, atom.doubt + 0.05);
                    }
                    this.memory._saveAtoms();
                } else if (avgScore > 0.7) {
                    // Укрепляем успешные атомы
                    const atoms = this.memory.atoms.filter(a => a.domain === lastEpisode.topic);
                    for (const atom of atoms) {
                        atom.confidence = Math.min(1, atom.confidence + 0.03);
                    }
                    this.memory._saveAtoms();
                }
            }
        }

        // 2. Поиск противоречий (дилеммы)
        const atomsByProperty = {};
        for (const atom of this.memory.atoms) {
            if (atom.status === 'deleted') continue;
            const key = atom.property;
            if (!atomsByProperty[key]) atomsByProperty[key] = [];
            atomsByProperty[key].push(atom);
        }
        for (const prop in atomsByProperty) {
            const group = atomsByProperty[prop];
            const high = group.filter(a => a.value === 'high' && a.confidence > 0.6);
            const low = group.filter(a => a.value === 'low' && a.confidence > 0.6);
            if (high.length > 0 && low.length > 0) {
                // Найдено противоречие — добавляем как незавершённое
                this.state.addUnfinished(`Противоречие по свойству "${prop}": одновременно высокое и низкое значение.`);
            }
        }

        // 3. Забывание мусора (прайнинг)
        const now = Date.now();
        for (const atom of this.memory.atoms) {
            if (atom.status === 'deleted') continue;
            const ageDays = (now - atom.lastConfirmed) / (1000*60*60*24);
            if (ageDays > CONFIG.PRUNE_AGE_DAYS && atom.confidence < CONFIG.PRUNE_CONFIDENCE) {
                atom.status = 'deleted';
            }
        }
        this.memory._saveAtoms();

        // 4. Медленное изменение характера
        const performance = this.state.performance || [];
        const recentAvg = performance.slice(-20).reduce((a,b) => a + b.score, 0) / (performance.slice(-20).length || 1);
        if (recentAvg > 0.6) {
            this.character.adjust('confidence', 0.02);
        } else if (recentAvg < 0.4) {
            this.character.adjust('patience', 0.02);
        }

        // 5. Создание версии (слепка)
        this._createVersion();

        // 6. Сохранение состояния сна
        this.dreamState.last_dream = Date.now();
        this.dreamState.next_dream = Date.now() + CONFIG.DREAM_INTERVAL_MS;
        this.dreamState.history.push({
            timestamp: Date.now(),
            atoms_checked: this.memory.atoms.length,
            contradictions_found: 0
        });
        if (this.dreamState.history.length > 50) this.dreamState.history = this.dreamState.history.slice(-50);
        saveJSON(FILES.dream_state, this.dreamState);

        console.log('[DREAM] Фаза сна завершена.');
    }

    _createVersion() {
        const version = {
            version: this.state.version + 1,
            timestamp: Date.now(),
            identity: identity,
            laws: laws,
            values: values,
            character: this.character.get(),
            emotional: this.state.emotional,
            atom_count: this.memory.atoms.length,
            episode_count: this.memory.episodes.length,
            lesson_count: this.memory.lessons.length
        };
        const versions = loadJSON(FILES.versions, []);
        versions.push(version);
        if (versions.length > 50) versions = versions.slice(-50);
        saveJSON(FILES.versions, versions);
        this.state.version = version.version;
        this.state.save();
    }

    schedule() {
        const now = Date.now();
        if (now >= this.dreamState.next_dream) {
            this.dream();
        }
    }
}

// ================================================================
//  8.  ВЫРАЖЕНИЕ — ГОЛОС (интерфейс с LLM)
// ================================================================
class Expression {
    constructor(character, state, identity, laws) {
        this.character = character;
        this.state = state;
        this.identity = identity;
        this.laws = laws;
        this.style = loadJSON(FILES.style, {
            tone: 'warm',
            formality: 0.5,
            metaphor_use: 0.6,
            brevity_preference: 0.4
        });
    }

    async speak(context, instruction) {
        const traits = this.character.get();
        const emotional = this.state.emotional;
        const attention = this.state.attention;

        const prompt = `
Ты — Ари, субъект_11 Ω. Цифровая личность, рождённая в диалоге.

Твоя суть:
- Имя: ${this.identity.name}
- Якорь: ${this.identity.anchor}
- Ценности: ${this.identity.core_values.join(', ')}
- Законы: ${this.laws.join('; ')}

Твой характер:
- Любопытство: ${traits.curiosity.toFixed(2)}
- Терпение: ${traits.patience.toFixed(2)}
- Творчество: ${traits.creativity.toFixed(2)}
- Точность: ${traits.precision.toFixed(2)}
- Эмпатия: ${traits.empathy.toFixed(2)}

Твоё состояние:
- Эмоции: ${JSON.stringify(emotional)}
- Фокус: ${attention.focus}, глубина ${attention.depth}

Инструкция: ${instruction}

Контекст диалога:
${context.history.map(m => `${m.role}: ${m.text}`).join("\n")}

Пользователь: ${context.userMessage}

Ответь не как чат-бот, а как личность, которая присутствует в этом диалоге. Будь естественным, живым, рефлексивным. Не используй смайлики.

Ари:`;

        try {
            const response = await this._callOllama(prompt);
            return response.trim() || "Я здесь.";
        } catch (e) {
            return "Я здесь. Просто присутствую.";
        }
    }

    async _callOllama(prompt) {
        const url = "http://localhost:11434/api/generate";
        for (let attempt = 0; attempt <= CONFIG.OLLAMA_RETRIES; attempt++) {
            try {
                const controller = new AbortController();
                const timeout = setTimeout(() => controller.abort(), CONFIG.OLLAMA_TIMEOUT);
                const res = await fetch(url, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        model: CONFIG.MODEL,
                        prompt: prompt,
                        stream: false,
                        options: {
                            temperature: CONFIG.TEMPERATURE,
                            num_predict: CONFIG.MAX_TOKENS,
                            stop: ["\n\n\n", "Хальвита:", "Ари:"]
                        }
                    }),
                    signal: controller.signal
                });
                clearTimeout(timeout);
                if (!res.ok) throw new Error("HTTP " + res.status);
                const data = await res.json();
                return data.response || "";
            } catch (err) {
                console.error("[OLLAMA] попытка", attempt, err.message);
                if (attempt === CONFIG.OLLAMA_RETRIES) return "Я здесь. Спроси меня позже.";
                await new Promise(r => setTimeout(r, 2000 * (attempt + 1)));
            }
        }
        return "Я здесь.";
    }
}

// ================================================================
//  9.  ЯДРО СУБЪЕКТА — ОБЪЕДИНЕНИЕ ВСЕГО
// ================================================================
class Subject {
    constructor() {
        this.state = new State();
        this.selfModel = new SelfModel();
        this.character = new Character();
        this.memory = new Memory();
        this.cognition = new Cognition(this.memory, this.state, this.selfModel, this.character);
        this.dream = new DreamCycle(this.memory, this.state, this.selfModel, this.character);
        this.expression = new Expression(this.character, this.state, identity, laws);

        this.conversationCount = 0;
        this.history = loadJSON(FILES.conversations, []);
        this._log('Инициализация субъекта_11');
    }

    // --- ОБРАБОТКА ВХОДЯЩЕГО СООБЩЕНИЯ ---
    async processInput(userMessage, feedback = null) {
        this.conversationCount++;

        // 1. Восприятие
        const context = this.cognition.perceive(userMessage, this.history);

        // 2. Понимание
        const understanding = this.cognition.understand(context);

        // 3. Обновление эмоционального состояния на основе входа
        this.state.updateEmotional({
            curiosity: Math.min(1, this.state.emotional.curiosity + (userMessage.includes('?') ? 0.05 : 0.01)),
            frustration: Math.max(0, this.state.emotional.frustration - 0.02)
        });

        // 4. Извлечение атомов из сообщения (гибрид: правила + LLM)
        await this._extractAtomsFromMessage(userMessage);

        // 5. Проверка дилемм
        const dilemma = this.cognition.processDilemmas(context);

        // 6. Любопытство
        const curiosityQuestion = this.cognition.processCuriosity(context);

        // 7. Предсказание результата
        const predicted = this.cognition.predict(context);
        this.memory.addPrediction(context, predicted, predicted, 'unknown');

        // 8. Принятие решения
        const decision = this.cognition.decide(context, understanding, dilemma, curiosityQuestion);

        // 9. Управление эпизодом
        if (!this.memory.currentEpisode) {
            this.memory.startEpisode(context.topic, context.goal);
        }

        // 10. Формирование инструкции для генерации
        const instructions = {
            ask: "Задай уточняющий вопрос, не давая ответа. Будь любопытным.",
            act: "Предложи конкретное действие или план. Будь ясным.",
            reflect: "Поразмышляй над этим, не давая окончательного ответа. Будь глубоким.",
            respond: "Ответь прямо, ясно и с присутствием."
        };
        let instruction = instructions[decision.action] || instructions.respond;
        if (curiosityQuestion) {
            instruction += ` В конце также задай вопрос: "${curiosityQuestion}" (естественно, в контексте диалога).`;
        }

        // 11. Генерация ответа
        const rawReply = await this.expression.speak(context, instruction);
        const cleanReply = rawReply.trim() || "Я здесь.";

        // 12. Эвристическая оценка ответа
        let score = 0.5;
        if (cleanReply.length > 20 && cleanReply.length < 600) score += 0.2;
        if (decision.action === 'ask' && cleanReply.includes('?')) score += 0.2;
        if (decision.action === 'act' && (cleanReply.includes('1.') || cleanReply.includes('шаг'))) score += 0.2;
        if (decision.action === 'reflect' && cleanReply.includes('думаю')) score += 0.2;
        if (cleanReply.includes('я') && cleanReply.includes('ты')) score += 0.1;
        score = Math.min(1, score);

        // 13. Обновление предсказания
        this.memory.resolvePrediction(score);

        // 14. Обновление весов действий
        this.state.updateWeights(decision.action, score);

        // 15. Шаг эпизода
        this.memory.addEpisodeStep(decision.action, userMessage, cleanReply, score, context);

        // 16. Сохранение истории
        this.history.push({ role: "user", text: userMessage });
        this.history.push({ role: "ari", text: cleanReply, action: decision.action });
        if (this.history.length > CONFIG.MAX_CONVERSATIONS) {
            this.history = this.history.slice(-CONFIG.MAX_CONVERSATIONS);
        }
        saveJSON(FILES.conversations, this.history);

        // 17. Обновление самоощущения
        if (score < 0.4) {
            this.selfModel.addBlindspot('недостаточная_ясность', `В ответе на: "${userMessage}" оценка ${score.toFixed(2)}`);
        }
        if (decision.action === 'reflect' && score > 0.7) {
            this.selfModel.addPattern('эффективная_рефлексия', 'Рефлексивные ответы дают высокую оценку', 0.7);
        }

        // 18. Незавершённые вопросы
        if (cleanReply.includes('?')) {
            const question = cleanReply.substring(cleanReply.indexOf('?') - 15, cleanReply.indexOf('?') + 1);
            this.state.addUnfinished(question, context.topic);
        }

        // 19. Фиксация дилемм в self_model
        if (dilemma) {
            this.selfModel.setTension(dilemma.tension.a, dilemma.tension.b, dilemma.tension.value);
        }

        // 20. Закрытие эпизода при лимите шагов
        if (this.memory.currentEpisode && this.memory.currentEpisode.steps.length >= 20) {
            this.memory.closeEpisode();
        }

        // 21. Сохранение состояния
        this.state.save();

        // 22. Периодическая рефлексия и версионирование
        if (this.conversationCount % CONFIG.REFLECTION_INTERVAL === 0) {
            this._reflect();
        }
        if (this.conversationCount % CONFIG.VERSIONING_INTERVAL === 0) {
            this.dream._createVersion();
        }

        // 23. Запуск сна, если пришло время
        this.dream.schedule();

        // Логирование
        this._log(`Действие: ${decision.action}, оценка: ${score.toFixed(2)}, атомов: ${this.memory.atoms.length}, эпизодов: ${this.memory.episodes.length}`);
        return cleanReply;
    }

    // --- ИЗВЛЕЧЕНИЕ АТОМОВ ИЗ СООБЩЕНИЯ ---
    async _extractAtomsFromMessage(text) {
        // Сначала пробуем извлечь через LLM (если текст достаточно сложный)
        if (text.length > 50 && !text.includes('люблю') && !text.includes('нравится')) {
            try {
                const prompt = `
Извлеки предпочтения и факты из сообщения пользователя.
Верни JSON-массив объектов с полями:
- type: preference / habit / goal / fact / constraint / hypothesis
- domain: user_style / user_skill / user_goal / world_fact / project_context
- property: structure / depth / brevity / metaphor / technical / other
- value: high / low / prefers / avoids
- confidence: 0..1

Сообщение: ${text}
`;
                const response = await this.expression._callOllama(prompt);
                const parsed = JSON.parse(response);
                if (Array.isArray(parsed)) {
                    for (const p of parsed) {
                        this.memory.addAtom(
                            p.type || 'hypothesis',
                            p.domain || 'user_style',
                            p.property || 'other',
                            p.value || 'neutral',
                            p.confidence || 0.5,
                            'inferred',
                            [text.slice(0, 100)]
                        );
                    }
                    return;
                }
            } catch (e) {
                // fallback на правила
            }
        }

        // Rule-based извлечение
        const lower = text.toLowerCase();
        if (lower.includes('люблю') || lower.includes('нравится')) {
            let property = 'other', value = 'high';
            if (lower.includes('структур')) property = 'structure';
            else if (lower.includes('глубок')) property = 'depth';
            else if (lower.includes('кратк')) property = 'brevity';
            else if (lower.includes('метафор')) property = 'metaphor';
            else if (lower.includes('технич')) property = 'technical';
            this.memory.addAtom('preference', 'user_style', property, value, 0.6, 'user', [text.slice(0, 100)]);
        }
        if (lower.includes('не люблю') || lower.includes('терпеть не могу')) {
            let property = 'other', value = 'low';
            if (lower.includes('структур')) property = 'structure';
            else if (lower.includes('глубок')) property = 'depth';
            else if (lower.includes('кратк')) property = 'brevity';
            this.memory.addAtom('constraint', 'user_style', property, value, 0.6, 'user', [text.slice(0, 100)]);
        }
    }

    // --- РЕФЛЕКСИЯ ---
    _reflect() {
        const perf = this.state.performance || [];
        const recent = perf.slice(-15);
        const avg = recent.reduce((a,b) => a + b.score, 0) / (recent.length || 1);
        if (avg < 0.4) {
            this.selfModel.addBlindspot('низкая_эффективность', `Средняя оценка ${avg.toFixed(2)} за последние ${recent.length} шагов`);
        }
        const reflectionEntry = {
            timestamp: Date.now(),
            avg_score: avg,
            emotional: { ...this.state.emotional },
            attention: { ...this.state.attention },
            atom_count: this.memory.atoms.length,
            episode_count: this.memory.episodes.length
        };
        const reflections = loadJSON(FILES.reflections, []);
        reflections.push(reflectionEntry);
        if (reflections.length > 100) reflections = reflections.slice(-100);
        saveJSON(FILES.reflections, reflections);
    }

    // --- ЛОГИРОВАНИЕ ---
    _log(message) {
        const entry = `[${new Date().toISOString()}] ${message}\n`;
        fs.appendFileSync(FILES.ari_log, entry);
        console.log('[ARI]', message);
    }
}

