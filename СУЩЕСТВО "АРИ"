class Identity {
    constructor() {
        this.personality = {};
        this.mood = {};
        this.selfModel = {};
    }

    async init() {
        this.personality = await loadJSON(FILES.personality, {
            curiosity: 0.88,
            precision: 0.68,
            empathy: 0.80,
            confidence: 0.55,
            patience: 0.75,
            creativity: 0.90,
            openness: 0.72,
            stability: 0.62,
            assertiveness: 0.45
        });
        this.mood = await loadJSON(FILES.mood, {
            frustration: 0.12,
            surprise: 0.08,
            engagement: 0.78,
            fatigue: 0.08,
            anxiety: 0.04,
            joy: 0.55,
            curiosity_mood: 0.70
        });
        this.selfModel = await loadJSON(FILES.self_model, {
            beliefs: [],
            stability: 1.0,
            last_update: null
        });
        this._log("Identity инициализирована.");
    }

    // --- Личность (медленно) ---
    adjustPersonality(trait, delta, cause) {
        if (!this.personality[trait]) return;
        const clamped = clamp(delta, -CONFIG.MAX_PERSONALITY_DELTA_PER_CYCLE, CONFIG.MAX_PERSONALITY_DELTA_PER_CYCLE);
        this.personality[trait] = clamp(this.personality[trait] + clamped, 0, 1);
        this._savePersonality();
        this._log(`Личность: ${trait} → ${this.personality[trait].toFixed(3)} (${cause})`);
    }

    // --- Настроение (быстро, с затуханием) ---
    adjustMood(mood, delta, cause = "") {
        if (!this.mood[mood]) return;
        this.mood[mood] = clamp(this.mood[mood] + delta, 0, 1);
        this._saveMood();
        this._log(`Настроение: ${mood} → ${this.mood[mood].toFixed(3)} (${cause})`);
    }

    decayMood() {
        for (let k in this.mood) {
            const baseline = (k === 'frustration' || k === 'fatigue' || k === 'anxiety') ? 0.1 : 0.5;
            this.mood[k] = this.mood[k] * (1 - CONFIG.MOOD_DECAY) + baseline * CONFIG.MOOD_DECAY;
        }
        this._saveMood();
    }

    // --- Самоощущение ---
    addSelfBelief(belief, confidence, evidence, source = "reflection") {
        const existing = this.selfModel.beliefs.find(b => b.belief === belief);
        if (existing) {
            const totalWeight = existing.evidence.length + 1;
            existing.confidence = (existing.confidence * existing.evidence.length + confidence) / totalWeight;
            existing.evidence.push({ evidence, source, timestamp: Date.now() });
            existing.updated = Date.now();
        } else {
            this.selfModel.beliefs.push({
                belief,
                confidence,
                evidence: [{ evidence, source, timestamp: Date.now() }],
                created: Date.now(),
                updated: Date.now()
            });
        }
        this.selfModel.stability = clamp(this.selfModel.stability + 0.005, 0.5, 1);
        this._saveSelfModel();
        this._log(`Самоощущение: ${belief} (conf=${confidence.toFixed(2)})`);
    }

    // --- Атрибуция ошибок ---
    attributeError(error, context, possibleCauses) {
        const total = Object.values(possibleCauses).reduce((a, b) => a + b, 0);
        if (total === 0) return null;
        const normalized = Object.fromEntries(
            Object.entries(possibleCauses).map(([k, v]) => [k, v / total])
        );
        if (normalized.me > 0.5) {
            this.adjustPersonality('confidence', -0.01 * error, `ошибка ${error.toFixed(2)} (я)`);
            this.addSelfBelief(`Я часто ошибаюсь в "${context.slice(0, 30)}"`, clamp(0.3 + error * 0.3, 0.3, 0.8), { error, context, causes: possibleCauses });
        } else if (normalized.user > 0.5) {
            this.adjustMood('frustration', 0.05 * error, "непонятный пользователь");
        } else if (normalized.data > 0.5) {
            this.adjustPersonality('curiosity', 0.02, "недостаточно данных");
        }
        return normalized;
    }

    async _savePersonality() { await saveJSON(FILES.personality, this.personality); }
    async _saveMood() { await saveJSON(FILES.mood, this.mood); }
    async _saveSelfModel() { await saveJSON(FILES.self_model, this.selfModel); }

    _log(msg) {
        const entry = `[${new Date().toISOString()}] IDENTITY: ${msg}\n`;
        fs.appendFile(FILES.ari_log, entry).catch(() => {});
    }

    getStatus() {
        return { personality: this.personality, mood: this.mood, selfBeliefs: this.selfModel.beliefs.length };
    }
}

