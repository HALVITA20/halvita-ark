2. BeliefMemory (новая версия)
javascript
// memory/beliefs.js
class BeliefMemory {
    constructor(state = {}) {
        this.beliefs = state.beliefs || [];
        this.conflicts = state.conflicts || [];
        this._migrateOldBeliefs();
    }

    // Конвертация старых текстовых убеждений в структурированные
    _migrateOldBeliefs() {
        this.beliefs = this.beliefs.map(b => {
            if (typeof b.content === 'string' && !b.property) {
                // Пытаемся извлечь структуру из текста
                const parsed = this._parseContent(b.content);
                return { ...b, ...parsed, content: undefined };
            }
            return b;
        });
    }

    _parseContent(text) {
        // Простой парсер: извлекает ключевые слова и назначает property/value
        const lower = text.toLowerCase();
        let property = 'unknown';
        let value = 'neutral';
        if (lower.includes('структур') || lower.includes('план') || lower.includes('архитектур')) {
            property = 'structure';
            value = 'high';
        } else if (lower.includes('глубок') || lower.includes('философ') || lower.includes('смысл')) {
            property = 'depth';
            value = 'high';
        } else if (lower.includes('кратк') || lower.includes('ясн') || lower.includes('чётк')) {
            property = 'brevity';
            value = 'high';
        } else if (lower.includes('метафор')) {
            property = 'metaphor';
            value = 'high';
        } else if (lower.includes('технич') || lower.includes('код') || lower.includes('детал')) {
            property = 'technical';
            value = 'high';
        }
        return { property, value };
    }

    add(belief) {
        // Валидация
        if (!this._validate(belief)) return false;

        // Проверка на дубликат (по property+value+domain)
        const existing = this.beliefs.find(b =>
            b.domain === belief.domain &&
            b.property === belief.property &&
            b.value === belief.value &&
            b.subject === belief.subject
        );
        if (existing) {
            // Обновляем уверенность, но не перезаписываем
            existing.confidence = Math.min(1, existing.confidence + 0.05);
            existing.certainty = Math.min(1, existing.certainty + 0.03);
            existing.lastConfirmed = Date.now();
            if (belief.evidence) existing.evidence.push(...belief.evidence.slice(0,3));
            if (existing.evidence.length > 10) existing.evidence = existing.evidence.slice(-10);
            existing.confirmations = (existing.confirmations || 0) + 1;
            return true;
        }

        // Проверка конфликтов
        const conflict = this._findConflict(belief);
        if (conflict) {
            belief.conflictId = conflict.id;
            // Создаём запись конфликта
            this.conflicts.push({
                id: crypto.randomUUID(),
                beliefIdA: belief.id,
                beliefIdB: conflict.id,
                resolved: false,
                createdAt: Date.now()
            });
        }

        this.beliefs.push({
            ...BeliefSchema,
            ...belief,
            id: belief.id || crypto.randomUUID(),
            created: Date.now(),
            lastConfirmed: Date.now(),
            status: 'active'
        });
        this._limit();
        return true;
    }

    _validate(belief) {
        if (!belief.type || !['preference','rule','avoidance','fact'].includes(belief.type)) return false;
        if (!belief.domain || !this._validDomains.includes(belief.domain)) return false;
        if (belief.confidence < 0.3) return false;
        if (belief.importance < 0.1) return false;
        return true;
    }

    getEffectiveConfidence(belief, context) {
        // Возраст
        const ageDays = (Date.now() - belief.lastConfirmed) / (1000 * 60 * 60 * 24);
        const decay = Math.exp(-ageDays / 90); // полураспад 90 дней
        let eff = belief.confidence * decay;

        // Актуальность контекста
        if (context && belief.context) {
            const relevance = this._computeContextRelevance(belief.context, context);
            eff *= (0.5 + 0.5 * relevance);
        }

        // Ограничиваем до 0.95
        return Math.min(0.95, eff);
    }

    getRelevant(context, limit = 10) {
        const now = Date.now();
        return this.beliefs
            .filter(b => b.status !== 'deleted' && b.status !== 'frozen')
            .map(b => ({
                ...b,
                effectiveConfidence: this.getEffectiveConfidence(b, context)
            }))
            .sort((a,b) => b.effectiveConfidence - a.effectiveConfidence)
            .slice(0, limit);
    }

    _findConflict(newBelief) {
        return this.beliefs.find(b =>
            b.domain === newBelief.domain &&
            b.property === newBelief.property &&
            b.value !== newBelief.value &&
            b.status !== 'deleted'
        );
    }

    // Обработка конфликтов: возвращает предпочтение
    resolveConflicts(beliefs, context) {
        const resolved = [];
        const used = new Set();
        for (const b of beliefs) {
            if (used.has(b.id)) continue;
            const conflict = this.conflicts.find(c => c.beliefIdA === b.id || c.beliefIdB === b.id);
            if (conflict && !conflict.resolved) {
                // Определяем победителя на основе свежести и уверенности
                const other = this.beliefs.find(b2 => b2.id === (conflict.beliefIdA === b.id ? conflict.beliefIdB : conflict.beliefIdA));
                if (other) {
                    const winner = this._decideWinner(b, other, context);
                    resolved.push(winner);
                    used.add(winner.id);
                    if (winner.id !== other.id) used.add(other.id);
                    continue;
                }
            }
            resolved.push(b);
            used.add(b.id);
        }
        return resolved;
    }

    _decideWinner(a, b, context) {
        // Правило: более свежее + более высокий confidence + соответствие контексту
        const scoreA = a.confidence * (1 + 0.5 * this._contextMatch(a, context));
        const scoreB = b.confidence * (1 + 0.5 * this._contextMatch(b, context));
        return scoreA >= scoreB ? a : b;
    }

    _contextMatch(belief, context) {
        if (!belief.context || !context) return 0;
        const topics = belief.context.topics || [];
        if (!topics.length) return 0;
        const userWords = context.userMessage.split(/\s+/).map(w => w.toLowerCase());
        let matches = 0;
        for (const t of topics) {
            if (userWords.some(w => w.includes(t))) matches++;
        }
        return matches / topics.length;
    }

    // Заморозить убеждение (не удалять, но не использовать)
    freeze(id) {
        const b = this.beliefs.find(b => b.id === id);
        if (b) b.status = 'frozen';
    }

    // Удалить (для ошибочных)
    delete(id) {
        const b = this.beliefs.find(b => b.id === id);
        if (b) b.status = 'deleted';
    }

    _limit() {
        if (this.beliefs.length > 1000) {
            this.beliefs = this.beliefs
                .filter(b => b.status !== 'deleted')
                .sort((a,b) => b.importance - a.importance)
                .slice(0, 1000);
        }
        if (this.conflicts.length > 100) {
            this.conflicts = this.conflicts.slice(-100);
        }
    }

    export() {
        return {
            beliefs: this.beliefs,
            conflicts: this.conflicts
        };
    }
}
