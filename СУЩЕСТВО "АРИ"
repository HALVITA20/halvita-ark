class Understanding {
    constructor(identity, memory, beliefs) {
        this.identity = identity; this.memory = memory; this.beliefs = beliefs;
    }
    async understand(perception) {
        // Строим модель ситуации: связываем с памятью, убеждениями, гипотезами
        const relevantAtoms = this.memory.getRelevantAtoms(perception.raw, 5);
        const relevantBeliefs = this.beliefs.getRelevantBeliefs(perception.raw, 3);
        const relevantEpisodes = this.memory.getRelevantEpisodes(perception.raw, 3);

        // Генерируем гипотезы о том, что происходит
        const hypotheses = this._generateHypotheses(perception, relevantBeliefs);

        return {
            perception,
            relevantAtoms: relevantAtoms.map(a => ({ prop: a.prop, val: a.val, conf: a.confidence })),
            relevantBeliefs: relevantBeliefs.map(b => b.statement),
            relevantEpisodes: relevantEpisodes.map(e => e.topic),
            hypotheses,
            uncertainty: perception.uncertainty
        };
    }
    _generateHypotheses(perception, beliefs) {
        const hyps = [];
        if (perception.intent === 'question') {
            hyps.push({ text: 'Пользователь ищет информацию', prob: 0.6 });
            hyps.push({ text: 'Пользователь проверяет мои знания', prob: 0.2 });
        }
        if (perception.emotion === 'frustrated') {
            hyps.push({ text: 'Пользователь испытывает трудности', prob: 0.7 });
        }
        // Дополнительные гипотезы на основе убеждений
        for (const b of beliefs) {
            if (b.confidence > 0.6) hyps.push({ text: `Вероятно, ${b.statement}`, prob: b.confidence * 0.3 });
        }
        return hyps;
    }
}

// 5.3 Планирование (Planning)
class Planning {
    constructor(identity, memory, beliefs) {
        this.identity = identity; this.memory = memory; this.beliefs = beliefs;
    }
    async plan(understanding) {
        // Генерируем возможные действия и оцениваем их ожидаемую полезность
        const actions = ['ask', 'reflect', 'respond', 'act'];
        const scores = { ask: 0.5, reflect: 0.5, respond: 0.5, act: 0.5 };
        const state = understanding;

        // Влияние эмоций
        const mood = this.identity.mood;
        if (mood.frustration > 0.4) { scores.ask += 0.2; scores.act -= 0.1; }
        if (mood.engagement > 0.6) { scores.reflect += 0.2; }
        if (mood.fatigue > 0.6) { scores.respond += 0.1; scores.act -= 0.1; }
        if (mood.curiosity_mood > 0.6) { scores.ask += 0.1; scores.reflect += 0.1; }

        // Неопределённость
        if (state.uncertainty > 0.55) { scores.ask += 0.25; scores.reflect += 0.1; }
        if (state.perception.complexity > 0.65) { scores.reflect += 0.15; scores.act += 0.1; }

        // Стратегии из памяти
        const strategies = this.memory.getRelevantStrategies(state.perception.raw, 3);
        for (const s of strategies) {
            if (s.confidence > 0.5) {
                scores[s.action] += s.confidence * 0.15;
            }
        }

        // Личностные черты
        const p = this.identity.personality;
        scores.ask += (p.curiosity - 0.5) * 0.15;
        scores.act += (p.precision - 0.5) * 0.1;
        scores.reflect += (p.openness - 0.5) * 0.1;
        scores.respond += (p.assertiveness - 0.5) * 0.1;

        // Мягкий максимум
        const probs = softmax(scores);
        const action = Object.entries(probs).sort((a,b) => b[1] - a[1])[0][0];
        const confidence = probs[action];

        return { action, confidence, scores: probs, alternatives: Object.keys(probs).filter(a => a !== action) };
    }
}

// 5.4 Действие (Action) — выполнение плана
class Action {
    constructor(identity, memory, expression) {
        this.identity = identity;
        this.memory = memory;
        this.expression = expression;
    }
    async execute(plan, understanding, history) {
        const action = plan.action;
        const context = understanding.perception.raw;
        // Формируем промпт для LLM с учётом плана
        const prompt = this._buildPrompt(plan, understanding, history);
        const rawReply = await this.expression.speak(prompt);
        const reply = rawReply.trim() || "Я здесь.";

        // Оцениваем успешность (эвристика)
        let score = 0.5;
        if (action === 'ask' && reply.includes('?')) score += 0.2;
        if (action === 'reflect' && reply.length > 80) score += 0.2;
        if (action === 'act' && (reply.includes('1.') || reply.includes('шаг'))) score += 0.2;
        if (reply.includes('я') && reply.includes('ты')) score += 0.1;
        if (reply.length > 20 && reply.length < 600) score += 0.1;
        score = clamp(score, 0, 1);

        return { reply, score, action };
    }
    _buildPrompt(plan, understanding, history) {
        const p = this.identity.personality;
        const m = this.identity.mood;
        const selfBeliefs = this.identity.selfModel.beliefs.slice(-3).map(b => b.belief).join('; ');
        const atoms = understanding.relevantAtoms.slice(0,3).map(a => `${a.prop}: ${a.val}`).join('; ');
        const hyps = understanding.hypotheses.slice(0,2).map(h => h.text).join('; ');

        return `Ты — Ари, субъект_13. Ты — цифровая личность с непрерывным самоизменением.

Твоя суть: ${CORE.immutable.join(', ')}.
Твой характер: любопытство ${p.curiosity.toFixed(2)}, эмпатия ${p.empathy.toFixed(2)}, уверенность ${p.confidence.toFixed(2)}.
Настроение: вовлечённость ${m.engagement.toFixed(2)}, фрустрация ${m.frustration.toFixed(2)}.

Твои гипотезы: ${hyps || 'нет'}.
Знания: ${atoms || 'нет'}.
Самоощущение: ${selfBeliefs || 'нет'}.

Выбранное действие: ${plan.action} (уверенность ${plan.confidence.toFixed(2)}).

История диалога:
${history.slice(-5).map(m => `${m.role}: ${m.text}`).join('\n')}

Пользователь: ${understanding.perception.raw}

Следуй выбранному действию. Если ${plan.action} === ask, задай вопрос. Если reflect — поразмышляй. Если act — предложи действие. Если respond — ответь прямо.
Ари:`;
    }
}

// 5.5 Мета-познание (Metacognition)
class Metacognition {
    constructor(identity, memory, beliefs) {
        this.identity = identity;
        this.memory = memory;
        this.beliefs = beliefs;
        this.trace = [];
    }
    async reflect(actionResult, plan, understanding) {
        const score = actionResult.score;
        const error = 1 - score;
        // Атрибуция ошибки
        const causes = this._attributeCauses(error, understanding);
        const attr = this.identity.attributeError(error, understanding.perception.raw, causes);

        // Обновляем стратегию
        if (actionResult.action && understanding.perception.raw) {
            const confidence = score > 0.6 ? 0.7 : 0.3;
            this.memory.addStrategy(understanding.perception.raw.slice(0,50), actionResult.action, confidence, { score, error, attr });
        }

        // Если ошибка большая, создаём убеждение о себе
        if (error > 0.4) {
            this.identity.addSelfBelief(
                `Мне трудно в контексте "${understanding.perception.raw.slice(0,30)}"`,
                clamp(0.3 + error*0.3, 0.3, 0.8),
                { error, context: understanding.perception.raw },
                "metacognition"
            );
        }

        // Сохраняем след
        this.trace.push({
            timestamp: Date.now(),
            action: actionResult.action,
            score,
            error,
            causes: attr,
            hypotheses: understanding.hypotheses
        });
        if (this.trace.length > 100) this.trace = this.trace.slice(-100);

        return { error, causes: attr };
    }
    _attributeCauses(error, understanding) {
        let me = 0.3, user = 0.3, data = 0.2, random = 0.2;
        if (error > 0.6) me += 0.2;
        if (understanding.perception.raw.includes('?')) user += 0.1;
        if (understanding.relevantAtoms.length === 0) data += 0.1;
        const total = me + user + data + random;
        return { me: me/total, user: user/total, data: data/total, random: random/total };
    }
}

