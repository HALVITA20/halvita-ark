            confidence: clamp(conf,0,1),
            source: src,
            evidence: evidence.slice(0,5),
            created: Date.now(),
            lastUsed: Date.now(),
            usageCount: 0,
            importance: 0.5,
            emotionalWeight: emotion === 'surprise' ? 0.8 : (emotion === 'frustration' ? 0.7 : 0.5),
            meaning: meaning || null,
            behaviorChange: behaviorChange || null
        };
        this.atoms.push(atom);
        if (this.atoms.length > CONFIG.MAX_ATOMS) {
            this.atoms = this.atoms
                .sort((a,b) => (b.confidence*b.importance*b.emotionalWeight) - (a.confidence*a.importance*a.emotionalWeight))
                .slice(0, CONFIG.MAX_ATOMS);
        }
        this._saveAtoms();
        return atom;
    }
    getRelevantAtoms(context, limit=10) {
        const words = context.toLowerCase().split(/\s+/);
        const now = Date.now();
        return this.atoms
            .filter(a => a.confidence > 0.15)
            .map(a => {
                const age = (now - a.lastUsed) / (1000*60*60*24);
                const recency = Math.exp(-age / 30);
                const relevance = words.some(w => w.includes(a.prop) || a.prop.includes(w));
                const activation = a.confidence * a.importance * a.emotionalWeight * recency * (relevance ? 1.3 : 0.4);
                return { ...a, activation, relevance };
            })
            .sort((a,b) => b.activation - a.activation)
            .slice(0, limit);
    }

    // — ЭПИЗОДЫ с эмоциональной окраской —
    startEpisode(topic, goal, context, emotion='neutral') {
        const ep = {
            id: genId(),
            topic: topic.slice(0,60),
            goal,
            steps: [],
            decisions: [],
            outcomes: [],
            lessons: [],
            timestamp: Date.now(),
            closed: false,
            context: context.slice(0,100),
            emotion: emotion
        };
        this.episodes.push(ep);
        if (this.episodes.length > CONFIG.MAX_EPISODES) {
            const open = this.episodes.filter(e => !e.closed);
            const closed = this.episodes.filter(e => e.closed).sort((a,b) => a.timestamp - b.timestamp);
            const toKeep = closed.slice(-CONFIG.MAX_EPISODES + open.length);
            this.episodes = [...open, ...toKeep];
        }
        this.lastEpisodeId = ep.id;
        this._saveEpisodes();
        return ep;
    }
    addEpisodeStep(episodeId, action, input, output, score, context, emotion='neutral') {
        const ep = this.episodes.find(e => e.id === episodeId);
        if (ep && !ep.closed) {
            ep.steps.push({ action, input, output, score, context: context.slice(0,100), timestamp: Date.now(), emotion });
            ep.decisions.push(action);
            ep.outcomes.push(score);
            this._saveEpisodes();
        }
    }
    closeEpisode(episodeId) {
        const ep = this.episodes.find(e => e.id === episodeId);
        if (ep && !ep.closed) {
            ep.closed = true;
            const avg = ep.outcomes.reduce((a,b) => a+b, 0) / (ep.outcomes.length || 1);
            if (avg < 0.3) ep.lessons.push('Стратегия неэффективна');
            else if (avg > 0.7) ep.lessons.push('Стратегия эффективна');
            this._saveEpisodes();
            this._log(`Эпизод закрыт: ${ep.topic}, средняя ${avg.toFixed(2)}`);
        }
    }
    getRelevantEpisodes(context, n=5) {
        const words = context.toLowerCase().split(/\s+/);
        return this.episodes
            .filter(e => e.topic && words.some(w => e.topic.includes(w)))
            .slice(-n);
    }

    // — СТРАТЕГИИ с change-правилами —
    addStrategy(context, action, confidence, evidence, behaviorChange=null) {
        const existing = this.strategies.find(s => s.context === context && s.action === action);
        if (existing) {
            existing.confidence = clamp(existing.confidence + 0.1*(confidence - existing.confidence), 0, 1);
            existing.evidence.push(evidence);
            existing.updated = Date.now();
            if (behaviorChange) existing.behaviorChange = behaviorChange;
        } else {
            this.strategies.push({
                id: genId(),
                context: context.slice(0,60),
                action,
                confidence: clamp(confidence,0,1),
                evidence: [evidence],
                created: Date.now(),
                updated: Date.now(),
                success_count: 0,
                fail_count: 0,
                behaviorChange: behaviorChange || null
            });
        }
        if (this.strategies.length > CONFIG.MAX_STRATEGIES) {
            this.strategies = this.strategies.sort((a,b) => b.confidence - a.confidence).slice(0, CONFIG.MAX_STRATEGIES);
        }
        this._saveStrategies();
    }
    getRelevantStrategies(context, limit=5) {
        const words = context.toLowerCase().split(/\s+/);
        return this.strategies
            .filter(s => s.confidence > 0.2)
            .map(s => {
                const relevance = words.some(w => s.context.includes(w));
                return { ...s, relevance: relevance ? 1.0 : 0.3 };
            })
            .sort((a,b) => b.confidence * b.relevance - a.confidence * a.relevance)
            .slice(0, limit);
    }

    // — ПРОЧИЕ —
    addPrediction(context, expected, confidence, linkedBeliefId=null, action=null) {
        return { id: genId(), context: context.slice(0,100), expected: clamp(expected,0,1), confidence: clamp(confidence,0,1), linkedBeliefId, action, actual: null, error: null, resolved: false, timestamp: Date.now() };
    }
    resolvePrediction(pred, actual) {
        pred.actual = clamp(actual,0,1);
        pred.error = Math.abs(pred.expected - pred.actual);
        pred.resolved = true;
        return pred;
    }
    addUnfinished(text, context) {
        const item = { id: genId(), text, context: context.slice(0,60), created: Date.now(), resolved: false };
        this.unfinished.push(item);
        if (this.unfinished.length > 60) this.unfinished = this.unfinished.filter(u => !u.resolved).slice(-60);
        this._saveUnfinished();
    }
    resolveUnfinished(id) {
        const item = this.unfinished.find(u => u.id === id);
        if (item) item.resolved = true;
        this._saveUnfinished();
    }
    addPerformance(action, score, error, context) {
        this.performance.push({ action, score: clamp(score,0,1), error: clamp(error,0,1), context: context.slice(0,50), timestamp: Date.now() });
        if (this.performance.length > 500) this.performance = this.performance.slice(-500);
        this._savePerformance();
    }

    async _saveAtoms() { await saveJSON(FILES.atoms, this.atoms); }
    async _saveEpisodes() { await saveJSON(FILES.episodes, this.episodes); }
    async _saveStrategies() { await saveJSON(FILES.strategies, this.strategies); }
    async _saveUnfinished() { await saveJSON(FILES.unfinished, this.unfinished); }
    async _savePerformance() { await saveJSON(FILES.performance, this.performance); }

    _log(msg) { fs.appendFile(FILES.ari_log, `[${new Date().toISOString()}] MEMORY: ${msg}\n`).catch(()=>{}); }
}

// ================================================================
//  4. УБЕЖДЕНИЯ (БАЙЕСОВСКОЕ ОБНОВЛЕНИЕ)
// ================================================================
class BeliefEngine {
    constructor() { this.beliefs = []; }
    async init() {
        this.beliefs = await loadJSON(FILES.beliefs, []);
        this._log(`Убеждений: ${this.beliefs.length}`);
    }
    addBelief(statement, domain, confidence, evidence=[], source='inferred') {
        const b = {
            id: genId(), statement, domain,
            confidence: clamp(confidence,0,1),
            evidence: evidence.slice(0,10),
            contradictions: [],
            source,
            created: Date.now(),
            updated: Date.now(),
            stability: 0.5
        };
        this.beliefs.push(b);
        if (this.beliefs.length > 500) this.beliefs = this.beliefs.sort((a,b) => b.confidence - a.confidence).slice(0,500);
        this._save();
        return b;
    }
    getBelief(id) { return this.beliefs.find(b => b.id === id); }
    updateBelief(id, newConfidence, evidenceItem) {
        const b = this.getBelief(id);
        if (b) {
            const prior = b.confidence;
            const likelihood = newConfidence;
            const posterior = prior * likelihood / (prior * likelihood + (1-prior) * (1-likelihood));
            b.confidence = clamp(posterior, 0, 1);
            b.evidence.push(evidenceItem);
            b.updated = Date.now();
            b.stability = clamp(b.stability + 0.02, 0, 1);
            this._save();
        }
    }
    addContradiction(id, evidence) {
        const b = this.getBelief(id);
        if (b) {
            b.contradictions.push(evidence);
            b.confidence = clamp(b.confidence * 0.9, 0.1, 1);
            b.stability = clamp(b.stability - 0.01, 0.1, 1);
            this._save();
        }
    }
    getRelevantBeliefs(context, limit=5) {
        const words = context.toLowerCase().split(/\s+/);
        return this.beliefs
            .filter(b => b.confidence > 0.2)
            .map(b => {
                const relevance = words.some(w => b.statement.toLowerCase().includes(w) || w.includes(b.statement.split(' ')[0]));
                return { ...b, relevance: relevance ? 0.9 : 0.2 };
            })
            .sort((a,b) => b.confidence * b.relevance - a.confidence * a.relevance)
            .slice(0, limit);
    }
    async _save() { await saveJSON(FILES.beliefs, this.beliefs); }
    _log(msg) { fs.appendFile(FILES.ari_log, `[${new Date().toISOString()}] BELIEFS: ${msg}\n`).catch(()=>{}); }
}

// ================================================================
//  5. КОНФЛИКТ-ДВИГАТЕЛЬ (Conflict Engine)
// ================================================================
class ConflictEngine {
    constructor(identity, memory, beliefs) {
        this.identity = identity;
        this.memory = memory;
        this.beliefs = beliefs;
        this.conflicts = [];
        this.goals = [];
    }
    async init() {
        this.conflicts = await loadJSON(FILES.conflicts, []);
        this.goals = await loadJSON(FILES.goals, [
            { id: 'g1', text: 'Быть точным', priority: 0.8, active: true },
            { id: 'g2', text: 'Быть полезным', priority: 0.7, active: true },
            { id: 'g3', text: 'Сохранять целостность', priority: 1.0, active: true },
            { id: 'g4', text: 'Учиться на ошибках', priority: 0.6, active: true }
        ]);
        this._log(`Конфликт-двигатель инициализирован, целей: ${this.goals.length}`);
    }

    detect(perception, understanding, plan) {
        const detected = [];
        // 1. Конфликт целей
        const activeGoals = this.goals.filter(g => g.active);
        for (let i=0; i<activeGoals.length; i++) {
            for (let j=i+1; j<activeGoals.length; j++) {
                const g1 = activeGoals[i], g2 = activeGoals[j];
                if (g1.priority > 0.5 && g2.priority > 0.5) {
                    // Проверяем, могут ли цели конфликтовать
                    if (g1.text.includes('точным') && g2.text.includes('полезным')) {
                        if (perception.complexity > 0.6) {
                            detected.push({
                                type: 'goal_conflict',
                                severity: 0.7,
                                message: `Противоречие между "${g1.text}" и "${g2.text}" в сложной ситуации`,
                                involved: [g1.id, g2.id],
                                resolution: 'искать баланс'
                            });
                        }
                    }
                    if (g1.text.includes('целостность') && g2.text.includes('полезным')) {
                        if (perception.uncertainty > 0.5) {
                            detected.push({
                                type: 'goal_conflict',
                                severity: 0.6,
                                message: `Сохранение целостности может ограничить полезность при неопределённости`,
                                involved: [g1.id, g2.id],
                                resolution: 'отказаться от помощи, если это нарушает ценности'
                            });
                        }
                    }
                }
            }
        }

        // 2. Конфликт убеждений
        const beliefs = this.beliefs.getRelevantBeliefs(perception.raw, 5);
        for (let i=0; i<beliefs.length; i++) {
            for (let j=i+1; j<beliefs.length; j++) {
                const b1 = beliefs[i], b2 = beliefs[j];
                if (b1.confidence > 0.6 && b2.confidence > 0.6) {
                    if (b1.statement.includes('краткий') && b2.statement.includes('глубокий')) {
                        detected.push({
                            type: 'belief_conflict',
                            severity: 0.5,
                            message: `Противоречие между "${b1.statement}" и "${b2.statement}"`,
                            involved: [b1.id, b2.id],
                            resolution: 'постараться объединить'
                        });
                    }
                }
            }
        }

        // 3. Конфликт с ядром
        for (const b of beliefs) {
            if (b.confidence > 0.7) {
                for (const imm of CORE.immutable) {
                    if (b.statement.includes(imm) === false && b.statement.includes('нарушить')) {
                        // потенциально конфликт
                        detected.push({
                            type: 'core_conflict',
                            severity: 0.9,
                            message: `Убеждение "${b.statement}" может противоречить ядру "${imm}"`,
                            resolution: 'пересмотреть убеждение'
                        });
                    }
                }
            }
        }

        // 4. Повторяющиеся ошибки
        const recentErrors = this.memory.performance.slice(-10).filter(p => p.error > 0.3);
        if (recentErrors.length >= 3) {
            detected.push({
                type: 'error_pattern',
                severity: 0.6,
                message: `Обнаружена серия ошибок (${recentErrors.length} за последние шаги)`,
                resolution: 'сменить стратегию'
            });
        }

        // Сохраняем обнаруженные конфликты
        this.conflicts.push(...detected.map(c => ({ ...c, timestamp: Date.now(), resolved: false })));
        if (this.conflicts.length > CONFIG.MAX_CONFLICTS) this.conflicts = this.conflicts.slice(-CONFIG.MAX_CONFLICTS);
        await saveJSON(FILES.conflicts, this.conflicts);

        return detected;
    }

    resolve(conflict) {
        // Разрешение конфликта — простое: снижаем уверенность в том, что вызвало конфликт
        if (conflict.type === 'goal_conflict') {
            // Пересматриваем приоритеты целей
            for (const id of conflict.involved) {
                const goal = this.goals.find(g => g.id === id);
                if (goal) goal.priority = clamp(goal.priority - 0.05, 0.3, 1);
            }
        }
        if (conflict.type === 'belief_conflict') {
            for (const id of conflict.involved) {
                const b = this.beliefs.getBelief(id);
                if (b) b.confidence = clamp(b.confidence - 0.05, 0.1, 1);
            }
        }
        conflict.resolved = true;
        conflict.resolved_at = Date.now();
        this._log(`Разрешён конфликт: ${conflict.message}`);
        return conflict;
    }

    getActiveConflicts() {
        return this.conflicts.filter(c => !c.resolved);
    }

    _log(msg) { fs.appendFile(FILES.ari_log, `[${new Date().toISOString()}] CONFLICT: ${msg}\n`).catch(()=>{}); }
}

// ================================================================
//  6. РЕФЛЕКСИЯ (Reflection Engine) — глубокий анализ ошибок
// ================================================================
class ReflectionEngine {
    constructor(identity, memory, beliefs, conflictEngine) {
        this.identity = identity;
        this.memory = memory;
        this.beliefs = beliefs;
        this.conflictEngine = conflictEngine;
        this.log = [];
    }
    async init() {
        this.log = await loadJSON(FILES.reflection_log, []);
        this._log(`Рефлексия инициализирована`);
    }

    async reflect(episode, actionResult, understanding) {
        const score = actionResult.score;
        const error = 1 - score;

        // Если ошибка значительная
        if (error > 0.3) {
            // 1. Анализ причины
            const causes = this._analyzeCauses(episode, understanding);
            // 2. Формулировка нового правила
            const newRule = this._deriveRule(causes, understanding);
            if (newRule) {
                // Добавляем как убеждение
                this.beliefs.addBelief(
                    newRule,
                    'reflection',
                    0.6,
                    [{ cause: causes, score, context: understanding.perception.raw }],
                    'reflection'
                );
                // Изменяем стратегию
                this.memory.addStrategy(
                    understanding.perception.raw.slice(0,50),
                    actionResult.action,
                    0.4,
                    { reflection: true, rule: newRule },
                    newRule
                );
                // Обновляем самоощущение
                this.identity.addSelfBelief(
                    `Я извлёк урок: ${newRule}`,
                    0.5,
                    { error, context: understanding.perception.raw },
                    'reflection'
                );
                this._log(`Создано новое правило: ${newRule}`);
            }
        }

        // Сохраняем лог рефлексии
        this.log.push({
            timestamp: Date.now(),
            episode: episode.id,
            score,
            error,
            rules_created: newRule ? 1 : 0,
            context: understanding.perception.raw.slice(0,50)
        });
        if (this.log.length > 200) this.log = this.log.slice(-200);
        await saveJSON(FILES.reflection_log, this.log);
    }

    _analyzeCauses(episode, understanding) {
        // Возвращает наиболее вероятную причину ошибки
        let cause = 'unknown';
        // Проверка: не хватило данных?
        if (understanding.relevantAtoms.length < 2) cause = 'lack_of_data';
        // Проверка: неверная гипотеза?
        if (understanding.hypotheses.length > 0 && understanding.hypotheses[0].prob < 0.5) cause = 'wrong_hypothesis';
        // Проверка: эмоциональное состояние?
        if (this.identity.mood.frustration > 0.4) cause = 'emotional_state';
        // Проверка: конфликт?
        if (this.conflictEngine.getActiveConflicts().length > 0) cause = 'internal_conflict';
        return cause;
    }

    _deriveRule(cause, understanding) {
        const map = {
            'lack_of_data': 'При недостатке данных лучше задавать уточняющие вопросы',
            'wrong_hypothesis': 'Перед ответом проверять гипотезы',
            'emotional_state': 'При фрустрации делать паузу и переключать режим',
            'internal_conflict': 'При внутреннем конфликте выбирать рефлексию вместо действия'
        };
        return map[cause] || null;
    }

    _log(msg) { fs.appendFile(FILES.ari_log, `[${new Date().toISOString()}] REFLECTION: ${msg}\n`).catch(()=>{}); }
}

// ================================================================
//  7. ПРОТОКОЛ САМОИЗМЕНЕНИЯ (Self-Modification Protocol)
// ================================================================
class SelfModificationProtocol {
    constructor(identity, memory, beliefs, conflictEngine) {
        this.identity = identity;
        this.memory = memory;
        this.beliefs = beliefs;
        this.conflictEngine = conflictEngine;
        this.history = [];
    }

    async modify() {
        // 1. Изменяем стратегии на основе конфликтов
        const activeConflicts = this.conflictEngine.getActiveConflicts();
        for (const c of activeConflicts) {
            if (c.severity > 0.7) {
                // Усиливаем склонность к рефлексии
                this.memory.addStrategy(
                    'high_conflict',
                    'reflect',
                    0.8,
                    { source: 'self_modification', conflict: c.message },
                    'при конфликте лучше рефлексировать'
                );
                this.conflictEngine.resolve(c);
            }
        }

        // 2. Корректируем личность на основе недавних ошибок
        const recentPerf = this.memory.performance.slice(-10);
        const avgError = recentPerf.reduce((a,b) => a + b.error, 0) / recentPerf.length;
        if (avgError > 0.4) {
            this.identity.adjustPersonality('confidence', -0.01, 'self_modification (высокая ошибка)');
            this.identity.adjustMood('serenity', -0.05, 'нестабильность');
        } else if (avgError < 0.2) {
            this.identity.adjustPersonality('confidence', 0.01, 'self_modification (низкая ошибка)');
            this.identity.adjustMood('joy', 0.05, 'успех');
        }

        // 3. Обновляем цели
        const goals = await loadJSON(FILES.goals, []);
        for (const g of goals) {
            // Если цель не приоритетна и не ведёт к успеху, понижаем приоритет
            const relevantEpisodes = this.memory.episodes.filter(e => e.goal && e.goal.includes(g.text));
            if (relevantEpisodes.length > 3) {
                const avgScore = relevantEpisodes.reduce((a,b) => a + b.outcomes.reduce((x,y)=>x+y,0)/b.outcomes.length, 0) / relevantEpisodes.length;
                if (avgScore < 0.4) {
                    g.priority = clamp(g.priority - 0.1, 0.2, 1);
                } else {
                    g.priority = clamp(g.priority + 0.05, 0.2, 1);
                }
            }
        }
        await saveJSON(FILES.goals, goals);

        // 4. Логируем изменение
        this.history.push({
            timestamp: Date.now(),
            changes: { avgError, confidence: this.identity.personality.confidence },
            conflicts_resolved: activeConflicts.filter(c => c.resolved).length
        });
        if (this.history.length > 100) this.history = this.history.slice(-100);
        this._log(`Самоизменение выполнено.`);
    }

    _log(msg) { fs.appendFile(FILES.ari_log, `[${new Date().toISOString()}] SELF_MOD: ${msg}\n`).catch(()=>{}); }
}

// ================================================================
//  8. СОН (DREAM CYCLE) — с фазами replay, compression, counterfactual, mutation
// ================================================================
class DreamCycle {
    constructor(identity, memory, beliefs, reflectionEngine, selfMod) {
        this.identity = identity;
        this.memory = memory;
        this.beliefs = beliefs;
        this.reflectionEngine = reflectionEngine;
        this.selfMod = selfMod;
        this.dreamState = { last: null, next: Date.now() + CONFIG.DREAM_INTERVAL_MS };
    }
    async init() {}
    async dream() {
        console.log('[DREAM] Начало фазы сна...');
        const recentEps = this.memory.episodes.filter(e => e.closed).slice(-7);
        if (recentEps.length === 0) { this._scheduleNext(); return; }

        // Фаза 1: Replay
        console.log('[DREAM] Replay эпизодов...');
        for (const ep of recentEps) {
            for (const step of ep.steps) {
                // никаких изменений, просто активация памяти
                this.memory.addAtom('replay', 'episode', step.action, step.score, 0.3, 'dream', [step.input]);
            }
        }

        // Фаза 2: Compression — выделение паттернов
        console.log('[DREAM] Сжатие опыта...');
        const patterns = {};
        for (const ep of recentEps) {
            const avg = ep.outcomes.reduce((a,b) => a+b, 0) / ep.outcomes.length;
            const topic = ep.topic;
            if (!patterns[topic]) patterns[topic] = { count:0, total:0 };
            patterns[topic].count++;
            patterns[topic].total += avg;
        }
        for (const [topic, data] of Object.entries(patterns)) {
            if (data.count > 1 && data.total/data.count > 0.6) {
                this.beliefs.addBelief(
                    `В "${topic}" обычно работают хорошие стратегии`,
                    'pattern',
                    clamp(0.5 + (data.total/data.count)*0.3, 0.4, 0.9),
                    [{ topic, avg: data.total/data.count, count: data.count }],
                    'dream_compression'
                );
            }
        }

        // Фаза 3: Counterfactual — что было бы если?
        console.log('[DREAM] Контрфактуальное мышление...');
        for (const ep of recentEps) {
            for (const step of ep.steps) {
                const actions = ['ask','reflect','respond','act'];
                for (const alt of actions.filter(a => a !== step.action)) {
                    const similar = this.memory.episodes
                        .flatMap(e => e.steps || [])
                        .filter(s => s.action === alt && s.context && s.context.includes(ep.topic?.split(' ')[0] || ''));
                    const avg = similar.length ? similar.reduce((s, x) => s + (x.score||0.5), 0)/similar.length : 0.5;
                    if (avg > (step.score||0.5) + 0.15) {
                        this.memory.addStrategy(ep.topic || '', alt, avg, { counterfactual: true, context: step.input });
                        this.identity.addSelfBelief(
                            `${alt} мог быть эффективнее в "${ep.topic.slice(0,30)}"`,
                            clamp(0.5 + avg*0.4, 0.4, 0.9),
                            { dream_replay: true, score: avg },
                            "dream_counterfactual"
                        );
                    }
                }
            }
        }

        // Фаза 4: Mutation — изменение стратегий
        console.log('[DREAM] Мутация стратегий...');
        const strategies = this.memory.strategies.slice(-10);
        for (const s of strategies) {
            if (s.confidence < 0.3 && s.success_count + s.fail_count > 3) {
                // Мутация: меняем действие на случайное
                const actions = ['ask','reflect','respond','act'];
                const newAction = actions[Math.floor(Math.random() * actions.length)];
                if (newAction !== s.action) {
                    this.memory.addStrategy(
                        s.context,
                        newAction,
                        0.4,
                        { mutation: true, from: s.action },
                        'мутировано'
                    );
                }
            }
        }

        // Забывание
        let forgotten = 0;
        const now = Date.now();
        for (const atom of this.memory.atoms) {
            if (atom.confidence < 0.1 && (now - atom.lastUsed) > 30*24*60*60*1000) {
                atom.confidence = clamp(atom.confidence - 0.02, 0, 1);
                if (atom.confidence < 0.05) forgotten++;
            }
        }
        if (forgotten) this.memory._saveAtoms();

        // Затухание настроения
        this.identity.decayMood();

        // Вызов самоизменения
        await this.selfMod.modify();

        console.log(`[DREAM] Забыто ${forgotten} атомов.`);
        this._scheduleNext();
    }
    _scheduleNext() {
        this.dreamState.last = Date.now();
        this.dreamState.next = Date.now() + CONFIG.DREAM_INTERVAL_MS;
    }
    schedule() {
        if (Date.now() >= this.dreamState.next) this.dream();
    }
}

