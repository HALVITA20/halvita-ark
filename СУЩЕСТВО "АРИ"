async function consolidate() {
    if (fullHistory.length < 30) return;
    const chunk = fullHistory.slice(-CONFIG.CONSOLIDATION_INTERVAL);
    const text = chunk.map(m => `${m.role === "user" ? "Хальвита" : "Ари"}: ${m.text}`).join("\n");
    const prompt = `Выдели 1-2 урока из этого диалога. Напиши от первого лица Ари.\n\n${text}`;
    try {
        const resp = await callOllama(prompt, { temperature: 0.4, num_predict: 200 });
        if (resp) {
            const lines = resp.split('\n').filter(l => l.length > 15);
            for (let line of lines) {
                const clean = cleanReply(line);
                if (clean.length > 10 && !lessons.some(l => l.text === clean)) {
                    lessons.push({ text: clean, timestamp: Date.now() });
                    addEmotion('lesson', clean, 0.9);
                }
            }
            saveJSON(PATHS.lessons, lessons);
        }
    } catch {}
}

