// extractBeliefs теперь более точечная

function extractBeliefs(text) {
    const lower = text.toLowerCase();
    const results = [];

    // Прямые предпочтения
    const prefPatterns = [
        { trigger: 'люблю', type: 'preference' },
        { trigger: 'нравится', type: 'preference' },
        { trigger: 'предпочитаю', type: 'preference' },
        { trigger: 'не люблю', type: 'avoidance' },
        { trigger: 'не нравится', type: 'avoidance' }
    ];

    for (const pattern of prefPatterns) {
        if (lower.includes(pattern.trigger)) {
            // Извлекаем следующую фразу
            const idx = lower.indexOf(pattern.trigger);
            const rest = text.slice(idx + pattern.trigger.length).trim();
            // Берём до конца предложения
            const end = rest.search(/[.!?]/) + 1 || rest.length;
            const content = rest.slice(0, end).trim();
            if (content.length > 5) {
                results.push({
                    type: pattern.type,
                    domain: 'style',
                    content: `Пользователь ${pattern.trigger} ${content}`,
                    confidence: 0.6,
                    source: 'user',
                    evidence: [text]
                });
            }
        }
    }

    // Убеждения из косвенных сигналов
    if (lower.includes('план') || lower.includes('структура') || lower.includes('архитектура')) {
        results.push({
            type: 'preference',
            domain: 'style',
            content: 'Пользователь ценит структурированные ответы',
            confidence: 0.5,
            source: 'inferred',
            evidence: [text]
        });
    }

    if (lower.includes('глубок') || lower.includes('философия') || lower.includes('смысл')) {
        results.push({
            type: 'preference',
            domain: 'style',
            content: 'Пользователь ищет глубину и осмысленность',
            confidence: 0.55,
            source: 'inferred',
            evidence: [text]
        });
    }

    return results;
}
