CONFIG = {
    "OLLAMA_URL": os.getenv("OLLAMA_URL", "http://localhost:11434/api/generate"),
    "OLLAMA_MODEL": os.getenv("OLLAMA_MODEL", "qwen2.5:7b"),
    "SUBJECTS_DIR": "SUBJECTS",
    "PROTOCOLS_DIR": "PROTOCOLS",
    "OUTPUT_DIR": "GENERATED_SUBJECTS",
    "GENERATED_PROTOCOLS_DIR": "GENERATED_PROTOCOLS",
    "METADATA_FILE": "genesis_metadata.json",
    "LOG_FILE": "genesis_engine.log",
    "MAX_SUBJECTS_TO_ANALYZE": 10,
    "MAX_PROTOCOLS_TO_GENERATE": 3,
    "PAUSE_SECONDS": 2,
}

# -------------------- Логирование --------------------
